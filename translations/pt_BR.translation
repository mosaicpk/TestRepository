    </customLabels>
    <customLabels>
        <label>Gostaria de saber mais sobre os campos de mesclagem? Confira a &lt;a href=&quot;https://support.docusign.com/home&quot; target=&quot;_blank&quot;&gt;documentação&lt;/a&gt;.</label>
        <name>dfsle__DecMergeFieldsGuidanceLearnMore</name>
    </customLabels>
