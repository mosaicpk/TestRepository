        <name>dfsle__DecMergeFieldsGuidanceStep1ImageInformation</name>
    </customLabels>
    <customLabels>
        <label><!-- Envelope Configuration Setup --></label>
        <name>dfsle__DecMergeFieldsGuidanceStep2Header</name>
    </customLabels>
    <customLabels>
