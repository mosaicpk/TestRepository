        <name>et4ae5__msg0118</name>
    </customLabels>
    <customLabels>
        <label>Las opciones alternativas de respuesta permiten a los usuarios del conector seleccionar de una lista configurable los nombres y direcciones de email a los que se enviarán las respuestas.</label>
        <name>et4ae5__msg0119</name>
    </customLabels>
