                  "attributes" : {
                    "imageInfos" : "",
                    "richTextValue" : "<h1><span style=\"color: rgb(255, 255, 255); font-size: 36px;\">Compañía Minera</span></h1><h1><span style=\"color: rgb(255, 255, 255); font-size: 36px;\">Miski Mayo</span></h1><p><br></p>"
                  },
                  "definition" : "community_builder:richTextEditor",
                  "id" : "67b400c5-75d1-488f-9ac3-095128c514ec",
                  "type" : "component"
                }, {
                  "attributes" : {
                    "imageInfos" : "",
                    "richTextValue" : "<p style=\"text-align: justify;\"><span style=\"color: rgb(255, 255, 255); font-size: 14px;\">Somos Miski Mayo, empresa minera no metálica pionera en la región Piura.</span></p><p style=\"text-align: justify;\"><span style=\"color: rgb(255, 255, 255); font-size: 14px;\">Líder en producción de concentrado de fosfato en el Perú, contando con el yacimiento más grande de Sudamérica.</span></p><p style=\"text-align: justify;\"><span style=\"color: rgb(255, 255, 255); font-size: 14px;\"><span class=\"ql-cursor\">﻿</span></span></p><p style=\"text-align: justify;\"><span style=\"color: rgb(255, 255, 255); font-size: 14px;\">Transformamos recursos naturales en desarrollo sostenible en beneficio de la provincia de Sechura y la región Piura.</span></p><p style=\"text-align: justify;\"><span style=\"color: rgb(255, 255, 255); font-size: 14px;\">Operamos con altos estándares en seguridad, protegemos el medio ambiente, y promovemos la mejora de la calidad de vida de nuestra gente y de nuestro entorno.</span></p>"
                  },
                  "definition" : "community_builder:richTextEditor",
