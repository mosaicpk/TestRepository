<messaging:emailTemplate subject="(Action Needed)" recipientType="User" relatedToType="sbaa__Approval__c">
<messaging:htmlEmailBody >
        
<html>
<head>
<meta content="text/css;charset=utf-8" http-equiv="Content-Type"/>
<meta name="Template" content="Response"/>
</head>
<body>
<h4><b>Order Line Approval Request North America</b></h4>
{!relatedTo.sbaa__Rule__r.PMC_CPQ_Description__c} <br /><br />
Hello {!recipient.Name},<br/><br/>
A Order Line for {!relatedTo.OrderItem__r.OrderItemNumber} has been submitted for your approval by Product Manager  {!relatedTo.Owner.Name}.
<apex:outputLink value="/{!relatedTo.OrderItem__c}" target="_blank">View Quote</apex:outputLink> <br/><br/>
 

</body>
</html>

</messaging:htmlEmailBody>
</messaging:emailTemplate>