    <definitionRunMode>Batch</definitionRunMode>
    <description>Filters orders activated between the specified start and end dates for orgs with multi-currency disabled. Orders are inserted into the Transaction Journal along with the Member field per rebate program.</description>
    <executionPlatformType>CRMA</executionPlatformType>
    <filters>
        <criteria>
            <inputVariable>RebateProgramId</inputVariable>
            <operator>Equals</operator>
            <sequence>1</sequence>
            <sourceFieldName>RebateProgramId</sourceFieldName>
        </criteria>
        <description>Filters the program members by the specified rebate program.</description>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Program Members</label>
        <name>FilterProgramMembers</name>
        <sourceName>RebateProgramMember</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>IsNull</operator>
            <sequence>1</sequence>
            <sourceFieldName>TJMemberId</sourceFieldName>
        </criteria>
        <criteria>
            <operator>IsNull</operator>
            <sequence>2</sequence>
            <sourceFieldName>TJOrderItemId</sourceFieldName>
        </criteria>
        <description>Filters the order items from active orders for the specified program member to be inserted into the transaction journal.</description>
        <filterCondition>1 AND 2</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Transaction Journals By Orders And Members</label>
        <name>FilterTransactionJournalsByOrdersAndMembers</name>
        <sourceName>Delivery_Items_For_Transaction_Journal</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>Equals</operator>
            <sequence>1</sequence>
            <sourceFieldName>PMC_CPQ_DeliveryStatus_c</sourceFieldName>
            <value>Shipped</value>
        </criteria>
        <criteria>
            <operator>Equals</operator>
            <sequence>2</sequence>
            <sourceFieldName>PMC_SS_OrderStatusCode_c</sourceFieldName>
            <value>Activated</value>
        </criteria>
        <criteria>
            <inputVariable>StartDate</inputVariable>
            <operator>GreaterThanOrEquals</operator>
            <sequence>3</sequence>
            <sourceFieldName>PMC_SS_OrderActivationDate_c</sourceFieldName>
        </criteria>
        <criteria>
            <inputVariable>EndDate</inputVariable>
            <operator>LessThanOrEquals</operator>
            <sequence>4</sequence>
            <sourceFieldName>PMC_SS_OrderActivationDate_c</sourceFieldName>
        </criteria>
        <filterCondition>1 AND 2 AND 3 AND 4</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Activated/Shipped Deliveries</label>
        <name>Filter_Activated_Shipped_Deliveries</name>
        <sourceName>Delivery</sourceName>
    </filters>
    <filters>
        <criteria>
            <operator>Equals</operator>
            <sequence>1</sequence>
            <sourceFieldName>PMC_CPQ_DeliveryStatus_c</sourceFieldName>
            <value>Shipped</value>
        </criteria>
        <filterCondition>1</filterCondition>
        <isDynamicFilter>false</isDynamicFilter>
        <label>Filter Shipped Delivery Items</label>
        <name>Filter_Shipped_Delivery_Items</name>
        <sourceName>Delivery_Item</sourceName>
    </filters>
