<?xml version="1.0" encoding="UTF-8"?>
<FlowTest xmlns="http://soap.sforce.com/2006/04/metadata">
    <flowApiName>PMC_DH_Before_Create_Insert_Subscription_Flow</flowApiName>
    <label>Quantity Null Test</label>
    <testPoints>
        <elementApiName>Start</elementApiName>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordInitial</type>
            <value>
                <sobjectValue>{&quot;CurrencyIsoCode&quot;:&quot;USD&quot;,&quot;OwnerId&quot;:&quot;005DT00000CLlVlYAL&quot;,&quot;PMC_CPQ_CustomerOfferedPrice__c&quot;:false,&quot;PMC_CPQ_ExspaceIndicator__c&quot;:false,&quot;PMC_CPQ_FreightMonth__c&quot;:&quot;Freight&quot;,&quot;PMC_CPQ_InForecast__c&quot;:false,&quot;PMC_CPQ_InSalesProgram__c&quot;:false,&quot;PMC_CPQ_Industrialization__c&quot;:false,&quot;PMC_CPQ_MosaicOptiontoShip__c&quot;:false,&quot;PMC_CPQ_PriceBookValue__c&quot;:&quot;Present&quot;,&quot;PMC_CPQ_ShipTo__c&quot;:&quot;001DT000018ndShYAI&quot;,&quot;PMC_CPQ_SubscriptionNumberIdentifier__c&quot;:&quot;SUB-0006865&quot;,&quot;PMC_CPQ_TotalAvailableQuantity__c&quot;:50,&quot;PMC_CPQ_TotalOrderedQuantity__c&quot;:50,&quot;PMC_CPQ_UnitofMeasure__c&quot;:&quot;MTN&quot;,&quot;PMC_CPQ_VCOQuotation__c&quot;:false,&quot;SBQQ__Account__c&quot;:&quot;001DT000013aaASYAY&quot;,&quot;SBQQ__Bundle__c&quot;:false,&quot;SBQQ__Bundled__c&quot;:false,&quot;SBQQ__ComponentDiscountedByPackage__c&quot;:false,&quot;SBQQ__Contract__c&quot;:&quot;800DT000000piuvYAA&quot;,&quot;SBQQ__HasConsumptionSchedule__c&quot;:false,&quot;SBQQ__PricingMethod__c&quot;:&quot;List&quot;,&quot;SBQQ__Product__c&quot;:&quot;01tDT000009jJUlYAM&quot;,&quot;SBQQ__Quantity__c&quot;:100,&quot;SBQQ__QuoteLine__c&quot;:&quot;a38DT000000dmb6YAA&quot;,&quot;SBQQ__RootId__c&quot;:&quot;&quot;}</sobjectValue>
            </value>
        </parameters>
    </testPoints>
    <testPoints>
        <assertions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_TotalAvailableQuantity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
        </assertions>
        <elementApiName>Finish</elementApiName>
    </testPoints>
</FlowTest>
