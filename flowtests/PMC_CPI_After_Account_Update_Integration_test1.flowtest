            <type>InputTriggeringRecordInitial</type>
            <value>
                <sobjectValue>{&quot;BillingCity&quot;:&quot;Indaiatuba&quot;,&quot;BillingCountry&quot;:&quot;Brazil&quot;,&quot;BillingCountryCode&quot;:&quot;BR&quot;,&quot;BillingPostalCode&quot;:&quot;13334&quot;,&quot;BillingState&quot;:&quot;São Paulo&quot;,&quot;BillingStateCode&quot;:&quot;SP&quot;,&quot;BillingStreet&quot;:&quot;Rua Tuiuti 1141&quot;,&quot;CurrencyIsoCode&quot;:&quot;BRL&quot;,&quot;Customer_buys_via_intercompany_VCO__c&quot;:false,&quot;Industry&quot;:&quot;9001&quot;,&quot;Name&quot;:&quot;527 Demo PT Validation&quot;,&quot;OwnerId&quot;:&quot;005Ot00000EwLJEIA3&quot;,&quot;PMC_CLM_LegalHoldStatus__c&quot;:&quot;Legal Hold Inactive&quot;,&quot;PMC_CPI_IntegrationMessage__c&quot;:&quot;Contract Update: Unexpected character (&apos;C&apos; (code 67)): expected a valid value (number, String, array, object, &apos;true&apos;, &apos;false&apos; or &apos;null&apos;) at input location [1,2]&quot;,&quot;PMC_CPI_IntegrationStatus__c&quot;:&quot;Error&quot;,&quot;PMC_CPQ_FlowAccountVRByPassToggle__c&quot;:false,&quot;PMC_DH_Account_Status__c&quot;:&quot;Pending&quot;,&quot;PMC_DH_Email__c&quot;:&quot;algumemail@algumdominio.com&quot;,&quot;PMC_DH_isProcessed__c&quot;:false,&quot;PMC_SS_AddressDistrict__c&quot;:&quot;Centro&quot;,&quot;PMC_SS_AddressNumber__c&quot;:&quot;1141&quot;,&quot;PMC_SS_ClientDenied__c&quot;:false,&quot;PMC_SS_CompanyCode__c&quot;:&quot;4000&quot;,&quot;PMC_SS_ContractLanguage__c&quot;:&quot;Portuguese&quot;,&quot;PMC_SS_CustomerType__c&quot;:&quot;B2B&quot;,&quot;PMC_SS_Division__c&quot;:&quot;Domestic&quot;,&quot;PMC_SS_HQ__c&quot;:false,&quot;PMC_SS_MDMVerified__c&quot;:true,&quot;PMC_SS_OverdelTolerance__c&quot;:35,&quot;PMC_SS_RecordType__c&quot;:&quot;Ship-to Customer&quot;,&quot;PMC_SS_SalesOrg__c&quot;:&quot;4000&quot;,&quot;PMC_SS_ShippingCondition__c&quot;:&quot;Z2&quot;,&quot;PMC_SS_SoldToAccount__c&quot;:&quot;001DT000014smDVYAY&quot;,&quot;PMC_SS_StateTaxNumber__c&quot;:&quot;ABCD&quot;,&quot;PMC_SS_TaxIDOrCNPJOr