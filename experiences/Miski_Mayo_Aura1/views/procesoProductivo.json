        "components" : [ {
          "componentAttributes" : {
            "richTextValue" : "<h1 style=\"text-align: center;\"><span style=\"font-size: 48px; color: rgb(230, 0, 0);\">Proceso productivo</span></h1><p>&nbsp;</p>"
          },
          "componentName" : "forceCommunity:richTextInline",
          "id" : "e89c2769-c47f-4135-99d5-aecc94db3e44",
          "renderPriority" : "NEUTRAL",
          "renditionMap" : { },
          "type" : "component"
        }, {
          "componentAttributes" : {
            "richTextValue" : "<p style=\"text-align: center;\"><span style=\"color: rgb(72, 72, 72); font-size: 16px;\">Tenemos una operación amigable con el medio ambiente, ya que durante todo nuestro proceso productivo realizamos acciones que reflejan nuestro sincero compromiso con el cuidado del planeta. A continuación, te contamos cada una de las partes de nuestro proceso de producción.</span></p>"
          },
