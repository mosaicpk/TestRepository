        "components" : [ {
          "componentAttributes" : {
            "richTextValue" : "<h2>Proceso en mina</h2><p> </p>"
          },
          "componentName" : "forceCommunity:richTextInline",
          "id" : "2b46c149-88bc-4028-9613-770b9be212b3",
          "renderPriority" : "NEUTRAL",
          "renditionMap" : { },
          "type" : "component"
        }, {
          "componentAttributes" : {
            "richTextValue" : "<p><span style=\"font-size: 16px; color: rgb(72, 72, 72);\">Nuestra mina está dividida en 39 módulos de explotación y de cada uno de ellos se extrae roca fosfórica, en forma secuencial. No necesitamos usar explosivos. A través de un proceso mecánico simple, se excava la tierra utilizando palas hidráulicas para obtener la roca fosfórica.</span></p>"
          },
          "componentName" : "forceCommunity:richTextInline",
