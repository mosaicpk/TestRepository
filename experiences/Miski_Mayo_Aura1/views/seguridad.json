          "componentAttributes" : {
            "richTextValue" : "<h3 style=\"text-align: center;\"><a href=\"http://sistemaintegrado/\" rel=\"noopener noreferrer\" target=\"null\" style=\"font-size: 36px; color: rgb(230, 0, 0);\">Sistema Integrado de Gestión de Mosaic</a></h3><p> </p>"
          },
