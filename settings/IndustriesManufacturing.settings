<?xml version="1.0" encoding="UTF-8"?>
<IndustriesManufacturingSettings xmlns="http://soap.sforce.com/2006/04/metadata">
    <enableFleetManagement>false</enableFleetManagement>
    <enableIndManufacturing>true</enableIndManufacturing>
    <enableIndustriesMfgAccountForecast>true</enableIndustriesMfgAccountForecast>
    <enableIndustriesMfgAdvForecast>true</enableIndustriesMfgAdvForecast>
    <enableIndustriesMfgIAS>true</enableIndustriesMfgIAS>
    <enableIndustriesMfgProgram>false</enableIndustriesMfgProgram>
    <enableIndustriesMfgTargets>true</enableIndustriesMfgTargets>
    <enablePartnerVisitManagement>true</enablePartnerVisitManagement>
</IndustriesManufacturingSettings>
