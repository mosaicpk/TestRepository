<!--
  @description       : This Visualforce Component is used to show the email content which is being sent to the Retailer.
  @author            : Kailas Shimpi
  @group             : 
  @last modified on  : 09/13/2023
  @last modified by  : Kailas Shimpi
-->

<apex:component access="global" controller="PMC_SS_SalesQualifiedLeadController">
  <apex:attribute name="ldObjId" assignTo="{!leadId}" type="String" description="Lead record id"/>
  <apex:attribute name="ldOwnerId" assignTo="{!leadOwnerId}" type="String" description="Lead owner id"/>
    <html>
        <head>
            <style>
                body {
                    font-family: Arial, sans-serif;
                    font-size: 16px;
                    line-height: 1.5;
                }
                .container {
                    max-width: 600px;
                    margin: 0 auto;
                    padding: 20px;
                    background-color: #f5f5f5;
                }
                h1 {
                    margin-top: 0;
                    margin-bottom: 20px;
                    font-size: 24px;
                }
                p {
                    margin-top: 0;
                    margin-bottom: 20px;
                }
                .button {
                    background-color: #04AA6D;
                    font-family: 'Source Sans Pro', sans-serif;
                    color: white;
                    font-size: 18px;
                    padding: 6px 15px;
                    margin-top: 4px;
                    margin-right: 10px;
                    display: block;
                    float: right;
                    border-radius: 5px;
                }
                .button:hover {
                    background-color: #00796b;
                }
            </style>
        </head>
        <body>
            <div class="container">
                <p>Hello {!lead.Owner.Name},</p>
            <p>
            We have identified a potential Lead for your business.
            </p>
            Lead: {!lead.FirstName} {!lead.LastName}
            <p>
           	Product Interests: {!lead.PMC_SS_LatestProductInterests__c}
            </p>
                
            <p>
            You can review your Lead here: <a href="{!mosaicDirectLink}" target="_blank">Mosaic Direct</a>
            </p>
                
                
            <p>Thank you</p>
                
            <p>Salesforce Team</p>
            </div>
        </body>         
    </html>
</apex:component>