    <currency>USD</currency>
    <description>View of all My active FPD Contracts by Account and Product with a balance of tons where price has yet to be called.</description>
    <filter>
        <criteriaItems>
            <column>Order.OrderItems$PMC_CPQ_ContractType__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>FPD</value>
        </criteriaItems>
        <criteriaItems>
            <column>Order$SBQQ__Quote__c.PMC_CPQ_AccountManager__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>$USER</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Order$Account</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Order.OrderItems$Product2</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>My FPDs Yet to be Called (Dashboard)</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>PMC_CPQ_OrdersWithOrderLinesAndDeliveries__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>Order$EffectiveDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
