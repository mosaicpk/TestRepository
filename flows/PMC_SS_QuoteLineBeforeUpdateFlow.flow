<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Assignment element to populate UOM based on picklist selection</description>
        <name>UOMLookupAssignment</name>
        <label>UOM Lookup Assignment</label>
        <locationX>242</locationX>
        <locationY>611</locationY>
        <assignmentItems>
            <assignToReference>$Record.PMC_SS_UnitOfMeasure__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>UnitOfMeasureRecordGet.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Decision element to check if flow execution is bypassed.</description>
        <name>BypassFlowDecision</name>
        <label>Bypass Flow Decision</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>UnitOfMeasureChangedDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BypassFlowDecision_IsBypassedOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Is Bypassed Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>Decision element to check if the UOM is changes</description>
        <name>UnitOfMeasureChangedDecision</name>
        <label>Unit of Measure Changed Decision</label>
        <locationX>374</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>UnitOfMeasureChangedDecision_UOMUpdatedOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_UnitofMeasure__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_UnitofMeasure__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UnitOfMeasureRecordGet</targetReference>
            </connector>
            <label>UOM Updated Outcome</label>
        </rules>
    </decisions>
    <description>Before flow to update UOM look-up based on UOM picklist selection</description>
    <environments>Default</environments>
    <interviewLabel>PMC SS Quote Line Before Update Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Quote Line Before Update Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Query the UOM record based on selected picklist value.</description>
        <name>UnitOfMeasureRecordGet</name>
        <label>Unit of Measure Record Get</label>
        <locationX>242</locationX>
        <locationY>503</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>UOMLookupAssignment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PMC_CPQ_UnitofMeasure__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>UnitOfMeasure</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>BypassFlowDecision</targetReference>
        </connector>
        <object>SBQQ__QuoteLine__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
