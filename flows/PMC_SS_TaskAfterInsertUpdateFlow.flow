<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>id_assignment</name>
        <label>id assignment</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>lstrecipientid</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>NOTIFICATION_SUB_FLOW</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Check if Bypass Flow checkbox is true on Process Switches Configuration Setting</description>
        <name>BypassFlowDecision</name>
        <label>Bypass Flow Decision</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>CheckForNewOrExistingRecordDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BypassFlowDecision_BypassFlowOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Bypass Flow Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckForNewOrExistingRecordDecision</name>
        <label>Check For New Or Existing Record Decision</label>
        <locationX>440</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>InsertOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>boolIsNewFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>id_assignment</targetReference>
            </connector>
            <label>Insert Outcome</label>
        </rules>
        <rules>
            <name>UpdateOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>boolIsNewFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateContactLastInteractionAfterUpdateSubFLow</targetReference>
            </connector>
            <label>Update Outcome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>boolIsNewFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>PMC SS Task {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Task After Insert Update Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>BypassFlowDecision</targetReference>
        </connector>
        <object>Task</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <subflows>
        <name>NOTIFICATION_SUB_FLOW</name>
        <label>NOTIFICATION SUB FLOW</label>
        <locationX>176</locationX>
        <locationY>647</locationY>
        <connector>
            <targetReference>UpdateContactLastInteractionAfterInsertSubFlow</targetReference>
        </connector>
        <flowName>PMC_SS_CustomNotificationSubFlow</flowName>
        <inputAssignments>
            <name>idTargetRecord</name>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>lstRecipientIds</name>
            <value>
                <elementReference>lstrecipientid</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strCustomNotificationBody</name>
            <value>
                <elementReference>$Label.PMC_SS_AMChangeNotificationBody</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strCustomNotificationTitle</name>
            <value>
                <elementReference>$Label.PMC_SS_AMChangeNotificationTitle</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <subflows>
        <name>UpdateContactLastInteractionAfterInsertSubFlow</name>
        <label>Update Contact Last Interaction After Insert Sub Flow</label>
        <locationX>176</locationX>
        <locationY>755</locationY>
        <flowName>PMC_SS_UpdateContactLastInteractionDateSubFlow</flowName>
        <inputAssignments>
            <name>datLastModifiedDate</name>
            <value>
                <elementReference>$Record.LastModifiedDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strContactId</name>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <subflows>
        <name>UpdateContactLastInteractionAfterUpdateSubFLow</name>
        <label>Update Contact Last Interaction After Update Sub Flow</label>
        <locationX>440</locationX>
        <locationY>539</locationY>
        <flowName>PMC_SS_UpdateContactLastInteractionDateSubFlow</flowName>
        <inputAssignments>
            <name>datLastModifiedDate</name>
            <value>
                <elementReference>$Record.LastModifiedDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strContactId</name>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>lstrecipientid</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
