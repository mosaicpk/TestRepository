<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>ship_to_option</name>
        <choiceText>Account Group</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Ship-to</stringValue>
        </value>
    </choices>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>AccountGroup</name>
        <label>AccountGroup</label>
        <locationX>644</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Copy_1_of_Sold_to_Form</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Ship_To</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Account_Group</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Ship-to</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DecisionCountry</targetReference>
            </connector>
            <label>Ship To</label>
        </rules>
        <rules>
            <name>Sold_To</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Account_Group</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sold-to</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sold_to_Form</targetReference>
            </connector>
            <label>Sold To</label>
        </rules>
        <rules>
            <name>Bill_to</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Account_Group</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Bill-to</stringValue>
                </rightValue>
            </conditions>
            <label>Bill to</label>
        </rules>
    </decisions>
    <decisions>
        <name>DecisionCountry</name>
        <label>DecisionCountry</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>North_America_Form</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Brazil</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PMC_Customer_Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Brazil_Form</targetReference>
            </connector>
            <label>Brazil</label>
        </rules>
    </decisions>
