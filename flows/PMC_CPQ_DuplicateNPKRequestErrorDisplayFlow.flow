<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>RecordCreatedIdAssignment</name>
        <label>RecordCreatedIdAssignment</label>
        <locationX>374</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>Id.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CreateCaseRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>DuplicateGetRecord</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>ConfigSettingDecision</name>
        <label>Config Setting Decision</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>BlendedProducts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ConfigSettingDecisionDontRunOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Don&apos;t Run Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>DuplicateFoundDecision</name>
        <label>DuplicateFoundDecision</label>
        <locationX>374</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>RecordCreated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>DuplicateFound_DuplicateFoundDecision</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DuplicateGetRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>DisplayError</targetReference>
            </connector>
            <label>DuplicateFound</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>PMC CPQ Duplicate NPK Request {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC CPQ Duplicate NPK Request Error Display Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>CreateCaseRecord</name>
        <label>CreateCaseRecord</label>
        <locationX>374</locationX>
        <locationY>350</locationY>
        <connector>
            <targetReference>RecordCreatedIdAssignment</targetReference>
        </connector>
        <inputAssignments>
            <field>PMC_SS_Nitrogen__c</field>
            <value>
                <elementReference>Nitrogen</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_SS_Phosphorous__c</field>
            <value>
                <elementReference>Phosphorous</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_SS_Potassium__c</field>
            <value>
                <elementReference>Potassium</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>DuplicateGetRecord</name>
        <label>DuplicateGetRecord</label>
        <locationX>374</locationX>
        <locationY>566</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>DuplicateFoundDecision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PMC_SS_Nitrogen__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Nitrogen</elementReference>
            </value>
        </filters>
        <filters>
            <field>PMC_SS_Phosphorous__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Phosphorous</elementReference>
            </value>
        </filters>
        <filters>
            <field>PMC_SS_Potassium__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Potassium</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>CreateCaseRecord</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
