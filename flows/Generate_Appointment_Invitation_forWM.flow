<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Calls an invocable action that creates an appointment invitation record and updates the ID and InvitationURL fields of the AppointmentInvitation record variable. If the action encounters an error, the flow user returns to SetStageToTimeSlot so they can make different selections.</description>
        <name>CreateAppointmentInvitation</name>
        <label>Create Appointment Invitation</label>
        <locationX>587</locationX>
        <locationY>559</locationY>
        <actionName>saveAppointmentInvitationDetails</actionName>
        <actionType>saveAppointmentInvitationDetails</actionType>
        <connector>
            <targetReference>SetStageToReview</targetReference>
        </connector>
        <faultConnector>
            <targetReference>SetStageToTimeSlot</targetReference>
        </faultConnector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>appointmentInvitationDetails</name>
            <value>
                <elementReference>AppointmentInvitationDetails</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>appointmentInviteeDetails</name>
            <value>
                <elementReference>AppointmentInviteeDetails</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>almIds</name>
            <value>
                <elementReference>ActionableListMembersIds</elementReference>
            </value>
        </inputParameters>
        <nameSegment>saveAppointmentInvitationDetails</nameSegment>
        <outputParameters>
            <assignToReference>AppointmentInvitation.Id</assignToReference>
            <name>appointmentInvitationId</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>AppointmentInvitation.InvitationUrl</assignToReference>
            <name>appointmentInvitationUrl</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets AppointmentInvitation&apos;s appointment topic ID, booking start time, and booking end time to null and sets active to True.</description>
        <name>InitializeAppointmentInvitation</name>
        <label>Initialize AppointmentInvitation</label>
        <locationX>115</locationX>
        <locationY>183</locationY>
        <assignmentItems>
            <assignToReference>AppointmentInvitation.AppointmentTopicId</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AppointmentInvitation.BookingStartDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AppointmentInvitation.BookingEndDate</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AppointmentInvitation.IsActive</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AppointmentInvitation.UrlExpiryDate</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AppointmentInvitation.AppointmentType</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AppointmentInvitation.EngagementChannelTypeId</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>SkipServiceResourceSelection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>SetStageToAppointmentType</name>
        <label>Set Stage To Appointment Type</label>
        <locationX>798</locationX>
        <locationY>115</locationY>
        <assignmentItems>
            <assignToReference>$Flow.CurrentStage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>AppointmentTypeStage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>ScreenSelectAppointmentType</targetReference>
        </connector>
    </assignments>
