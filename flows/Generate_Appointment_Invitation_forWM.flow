    <decisions>
        <description>Determines whether the user wants to skip selecting a service resource.</description>
        <name>SkipServiceResourceSelection</name>
        <label>Skip Service Resource Selection?</label>
        <locationX>261</locationX>
        <locationY>184</locationY>
        <defaultConnectorLabel>No (Default)</defaultConnectorLabel>
        <rules>
            <name>YesSkipServiceResourceSelection</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ActionableListMembersIds</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetStageToTopic</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Generate Appointment Invitation_forWM {!$Flow.CurrentDateTime}</interviewLabel>
