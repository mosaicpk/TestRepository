<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>MosaicLLPAssignment</name>
        <label>Mosaic LLP Assignment</label>
        <locationX>242</locationX>
        <locationY>611</locationY>
        <assignmentItems>
            <assignToReference>$Record.PMC_CPQ_MosaicLLP__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>GetSalesOrgMetadata.PMC_CPQ_SalesOrgNumber__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>CheckSalesOrgValueDecision</name>
        <label>CheckSalesOrgValueDecision</label>
        <locationX>374</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckSalesOrgValueDecision_SalesOrgNotNullOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_SalesOrganization__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetSalesOrgMetadata</targetReference>
            </connector>
            <label>Sales Org Not Null Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>ConfigSettingDecision</name>
        <label>Config Setting Decision</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>CheckSalesOrgValueDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>DontRunOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Don&apos;t Run Outcome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>PMC CPQ {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC CPQ Before Create/Update Sales Area</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the Sales Area Number, from the Custom Metadata Mapping Sheet -</description>
        <name>GetSalesOrgMetadata</name>
        <label>Get Sales Org Metadata</label>
        <locationX>242</locationX>
        <locationY>503</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>MosaicLLPAssignment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PMC_CPQ_SalesOrgName__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PMC_SS_SalesOrganization__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PMC_CPQ_SalesOrg__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>ConfigSettingDecision</targetReference>
        </connector>
        <object>PMC_SS_SalesArea__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
