    <decisions>
        <name>RecordCheckDecision</name>
        <label>Record Check Decision</label>
        <locationX>4274</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RecordCheck_NewRecordOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>BoolRecordInsertFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AccountAndSegmentationCheckDecision</targetReference>
            </connector>
            <label>New Record Outcome</label>
        </rules>
    </decisions>
    <description>Set Case priority</description>
    <environments>Default</environments>
    <formulas>
        <name>BoolRecordInsertFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>strSegmentationFormula</name>
        <dataType>String</dataType>
        <expression>IF(
	ISBLANK(TEXT({!$Record.Account.PMC_SS_Segmentation__c})), 
	IF(
		ISBLANK(TEXT({!$Record.Contact.Account.PMC_SS_Segmentation__c})), &apos;&apos;, TEXT({!$Record.Contact.Account.PMC_SS_Segmentation__c})	
	),
	TEXT({!$Record.Account.PMC_SS_Segmentation__c})
)</expression>
    </formulas>
    <interviewLabel>PMC SS Case After Insert Update Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Case Before Insert Update Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>4148</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>RecordCheckDecision</targetReference>
        </connector>
