    <decisions>
        <description>Checks whether if account exists on a case or not</description>
        <name>AccountAndSegmentationCheckDecision</name>
        <label>Account And Segmentation Check Decision</label>
        <locationX>3482</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AccountAndSegmentationCheck_AccountAndSegmentationExistsOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.PMC_SS_Segmentation__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Contact.Account.PMC_SS_Segmentation__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CaseTypeDecision</targetReference>
            </connector>
            <label>Account And Segmentation Exist Outcome</label>
        </rules>
        <rules>
            <name>AccountAndSegmentationCheck_AccountExistsSegmentationNotExistOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.PMC_SS_Segmentation__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>CasePriorityLowAssignment</targetReference>
            </connector>
            <label>Account Exists Segmentation Not Exist Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>CaseTypeDecision</name>
        <label>Case Type Decision</label>
        <locationX>2162</locationX>
        <locationY>503</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CaseType_ShippingHighPriorityOutcome</name>
            <conditionLogic>1 AND(2 OR 3 OR 4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Shipping</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>strSegmentationFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Strategic</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>strSegmentationFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Prime</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>strSegmentationFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mega Farmers</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>strSegmentationFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Top Farmers</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CasePriorityHighAssignment</targetReference>
            </connector>
            <label>Shipping High Priority Outcome</label>
        </rules>
