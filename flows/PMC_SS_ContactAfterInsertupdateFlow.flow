<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>STRING_FLOWNAME</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_ContactAfterInsertUpdateFlow</stringValue>
        </value>
    </constants>
    <decisions>
        <name>BypassFlowDecision</name>
        <label>Bypass Flow Decision</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>CheckingForNewOrUpdateDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BypassFlow_BypassOutCome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Bypass OutCome</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckingForNewOrUpdateDecision</name>
        <label>Checking For New Or Update Decision</label>
        <locationX>550</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckingForNewOrUpdate_NewOutCome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>boolIsNewFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>WhatsappNumberCheckingDecision</targetReference>
            </connector>
            <label>New OutCome</label>
        </rules>
        <rules>
            <name>CheckingForNewOrUpdate_UpdateOutCome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>boolIsNewFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>WhatsAppNumberUpdateCheckingDecision</targetReference>
            </connector>
            <label>Update OutCome</label>
        </rules>
    </decisions>
    <decisions>
        <name>WhatsappNumberCheckingDecision</name>
        <label>Whatsapp Number Checking Decision</label>
        <locationX>154</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>WhatsappNumberChecking_WhatsappNumberExistOutCome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OtherPhone</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MessagingEndUserUpdate</targetReference>
            </connector>
            <label>Whatsapp Number Exist OutCome</label>
        </rules>
    </decisions>
    <decisions>
        <name>WhatsAppNumberUpdateCheckingDecision</name>
        <label>WhatsApp Number Update Checking Decision</label>
        <locationX>594</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>WhatsAppNumberUpdateChecking_IsChnagedOutCome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OtherPhone</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MessagingEndUserUpdate</targetReference>
            </connector>
            <label>Is Chnaged OutCome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>boolIsNewFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>strAppendentWhatsappNumberFormula</name>
        <dataType>String</dataType>
        <expression>{!$Label.PMC_SS_MessagingEndUserContactLinking_WhatsAppPrefix}+{!$Record.OtherPhone}</expression>
    </formulas>
    <interviewLabel>PMC SS Con {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Contact After Insert update Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>ErrorLogCreate</name>
        <label>Error Log Create</label>
        <locationX>1210</locationX>
        <locationY>1031</locationY>
        <inputAssignments>
            <field>PMC_FlowName__c</field>
            <value>
                <elementReference>STRING_FLOWNAME</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Message__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Type__c</field>
            <value>
                <stringValue>Flow</stringValue>
            </value>
        </inputAssignments>
        <object>PMC_ErrorLog__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>MessagingEndUserUpdate</name>
        <label>Messaging EndUser Update</label>
        <locationX>550</locationX>
        <locationY>923</locationY>
        <faultConnector>
            <targetReference>ErrorLogCreate</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>MessagingPlatformKey</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>strAppendentWhatsappNumberFormula</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>MessagingEndUser</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>BypassFlowDecision</targetReference>
        </connector>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
