        <filterLogic>and</filterLogic>
        <filters>
            <field>PMC_SS_Nitrogen__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>RecordId.PMC_SS_Nitrogen__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>PMC_SS_Phosphorous__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>RecordId.PMC_SS_Phosphorous__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>PMC_SS_Potassium__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>RecordId.PMC_SS_Potassium__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
