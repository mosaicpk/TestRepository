<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>SentAutoGenerateOpportunityEmailStep</name>
        <label>Sent Auto-Generate Opportunity Email Step</label>
        <locationX>176</locationX>
        <locationY>492</locationY>
        <actionName>Opportunity.PMC_SS_AutoGeneratedOpportunityEmailAlert</actionName>
        <actionType>emailAlert</actionType>
        <faultConnector>
            <targetReference>FaultErrorLogCreate</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Opportunity.PMC_SS_AutoGeneratedOpportunityEmailAlert</nameSegment>
    </actionCalls>
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>This is a decision where it checks for the field history for the opportunity</description>
        <name>HasConvertedHistoryDecision</name>
        <label>Has Converted History Decision</label>
        <locationX>440</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>HasConvertedFieldDecision</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetOpportunityHistoryRecordsStep.Field</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>opportunityCreatedFromLead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SentAutoGenerateOpportunityEmailStep</targetReference>
            </connector>
            <label>Has Converted Field Decision</label>
        </rules>
    </decisions>
    <description>Send Notification with details of Opportunity Activity</description>
    <environments>Default</environments>
    <interviewLabel>PMC SS Auto-Generated Opportunity Email Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Auto-Generated Opportunity Email Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>This is to create fault error log</description>
        <name>Fault_Error_Log_Create</name>
        <label>Fault Error Log Create</label>
        <locationX>968</locationX>
        <locationY>384</locationY>
        <inputAssignments>
            <field>PMC_ExternalId__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_FlowName__c</field>
            <value>
                <stringValue>PMC_SS_AutoGeneratedOpportunityEmailFlow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Message__c</field>
            <value>
                <stringValue>Error received while sending Auto-Generated Email</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Type__c</field>
            <value>
                <stringValue>Flow</stringValue>
            </value>
        </inputAssignments>
        <object>PMC_ErrorLog__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>This is to create fault error log</description>
        <name>FaultErrorLogCreate</name>
        <label>Fault Error Log Create</label>
        <locationX>440</locationX>
        <locationY>600</locationY>
        <inputAssignments>
            <field>PMC_ExternalId__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_FlowName__c</field>
            <value>
                <stringValue>PMC_SS_AutoGeneratedOpportunityEmailFlow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Message__c</field>
            <value>
                <stringValue>Error received while sending Auto-Generated Email</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Type__c</field>
            <value>
                <stringValue>Flow</stringValue>
            </value>
        </inputAssignments>
        <object>PMC_ErrorLog__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>This step gets Opportunity History Records.</description>
        <name>GetOpportunityHistoryRecordsStep</name>
        <label>Get Opportunity History Records Step</label>
        <locationX>440</locationX>
        <locationY>276</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>HasConvertedHistoryDecision</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Error_Log_Create</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Field</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>opportunityCreatedFromLead</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OpportunityFieldHistory</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterFormula>{!$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c} = False</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>GetOpportunityHistoryRecordsStep</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
