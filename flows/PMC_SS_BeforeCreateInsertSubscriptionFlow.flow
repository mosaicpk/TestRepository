<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Assignment Element to update the value of UOM lookup</description>
        <name>UnitOfMeasureValueAssignment</name>
        <label>Unit of Measure Value Assignment</label>
        <locationX>198</locationX>
        <locationY>611</locationY>
        <assignmentItems>
            <assignToReference>$Record.PMC_SS_UnitOfMeasure__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SelectedUOMRecordGet.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Decision element to check if flow execution is bypassed</description>
        <name>BypassFlowDecision</name>
        <label>Bypass Flow Decision</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>UOMPicklistChangedDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BypassFlowDecision_IsBypassedOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Is Bypassed Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>Decision element to check if UOM picklist was populated or changed</description>
        <name>UOMPicklistChangedDecision</name>
        <label>UOM Picklist Changed Decision</label>
        <locationX>330</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>UOMPicklistChangedDecision_UOMChangedOutcome</name>
            <conditionLogic>( 1 OR 2 ) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>BoolIsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_UnitofMeasure__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_UnitofMeasure__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SelectedUOMRecordGet</targetReference>
            </connector>
            <label>UOM Changed Outcome</label>
        </rules>
    </decisions>
    <description>Before context flow to update UOM lookup based on UOM picklist selection.</description>
    <environments>Default</environments>
    <formulas>
        <description>Formula variable to check if the record is new.</description>
        <name>BoolIsNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>PMC SS Before Create Insert Subscription Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Before Create Insert Subscription Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get element to fetch the selected UOM record.</description>
        <name>SelectedUOMRecordGet</name>
        <label>Selected UOM Record Get</label>
        <locationX>198</locationX>
        <locationY>503</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>UnitOfMeasureValueAssignment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PMC_CPQ_UnitofMeasure__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>UnitOfMeasure</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>BypassFlowDecision</targetReference>
        </connector>
        <object>SBQQ__Subscription__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
