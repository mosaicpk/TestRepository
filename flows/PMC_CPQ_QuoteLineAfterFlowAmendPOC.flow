<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Variable_to_Collection</name>
        <label>Add Quote line Variable to Collection</label>
        <locationX>578</locationX>
        <locationY>1079</locationY>
        <assignmentItems>
            <assignToReference>QuoteLinecollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>QuoteLineSingleRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Iterate_through_Contract_Latest_quote_Quoteline</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_values_from_Latest_quote_line</name>
        <label>Assign values from Latest quote line</label>
        <locationX>578</locationX>
        <locationY>971</locationY>
        <assignmentItems>
            <assignToReference>QuoteLineSingleRecord.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Iterate_through_Current_Quote_Quotelines.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>QuoteLineSingleRecord.PMC_CPQ_ModeofTransportation__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Iterate_through_Contract_Latest_quote_Quoteline.PMC_CPQ_ModeofTransportation__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>QuoteLineSingleRecord.PMC_CPQ_ShippingType__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Iterate_through_Contract_Latest_quote_Quoteline.PMC_CPQ_ShippingType__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>QuoteLineSingleRecord.PMC_CPQ_Incoterms1__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Iterate_through_Contract_Latest_quote_Quoteline.PMC_CPQ_Incoterms1__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>QuoteLineSingleRecord.PMC_CPQ_UnitofMeasure__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Iterate_through_Contract_Latest_quote_Quoteline.PMC_CPQ_UnitofMeasure__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Variable_to_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Quote_Is_Amendment</name>
        <label>Check Quote Is Amendment</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AmendmentOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.SBQQ__Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Amendment</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetRelatedQuoteLines</targetReference>
            </connector>
            <label>Amendment Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckbothSubscriptionAreMatching</name>
        <label>Check both Subscription are matching</label>
        <locationX>710</locationX>
        <locationY>863</locationY>
        <defaultConnector>
            <targetReference>Iterate_through_Contract_Latest_quote_Quoteline</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Subscription_matching_outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Iterate_through_Contract_Latest_quote_Quoteline.SBQQ__UpgradedSubscription__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Iterate_through_Current_Quote_Quotelines.SBQQ__UpgradedSubscription__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_values_from_Latest_quote_line</targetReference>
            </connector>
            <label>Subscription matching outcome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>PMC CPQ Quote Line After Flow Amend POC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC CPQ Quote Line After Flow Amend POC</label>
    <loops>
        <name>Iterate_through_Contract_Latest_quote_Quoteline</name>
        <label>Iterate through Contract Latest quote Quoteline</label>
        <locationX>490</locationX>
        <locationY>755</locationY>
        <collectionReference>Get_Contract_Latest_Quote_Quote_Lines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>CheckbothSubscriptionAreMatching</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Iterate_through_Current_Quote_Quotelines</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Iterate_through_Current_Quote_Quotelines</name>
        <label>Iterate through Current Quote Quotelines</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <collectionReference>GetRelatedQuoteLines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Iterate_through_Contract_Latest_quote_Quoteline</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Quote_lines</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Contract_Latest_Quote_Quote_Lines</name>
        <label>Get Contract Latest Quote Quote Lines</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Iterate_through_Current_Quote_Quotelines</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__Quote__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SBQQ__Quote__r.SBQQ__MasterContract__r.PMC_CPQ_LatestQuote__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>SBQQ__QuoteLine__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetRelatedQuoteLines</name>
        <label>Get Related Quote Lines</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Contract_Latest_Quote_Quote_Lines</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__Quote__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SBQQ__Quote__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>SBQQ__QuoteLine__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Quote_lines</name>
        <label>Update Quote lines</label>
        <locationX>50</locationX>
        <locationY>1439</locationY>
        <inputReference>QuoteLinecollection</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Quote_Is_Amendment</targetReference>
        </connector>
        <object>SBQQ__QuoteLine__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>QuoteLinecollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>SBQQ__QuoteLine__c</objectType>
    </variables>
    <variables>
        <name>QuoteLineSingleRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>SBQQ__QuoteLine__c</objectType>
    </variables>
</Flow>
