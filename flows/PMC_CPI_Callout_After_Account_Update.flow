    <decisions>
        <name>PMC_Account_is_new</name>
        <label>Check Account is new</label>
        <locationX>710</locationX>
        <locationY>1031</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_SAPCustomerNumber__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CPI_Account_Creation_Callout_is_Queued</targetReference>
            </connector>
            <label>New Account</label>
        </rules>
        <rules>
            <name>Updated_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_SAPCustomerNumber__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CPI_Account_Modification_Callout_is_Queued</targetReference>
            </connector>
            <label>Updated Account</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CashPlanningGroup</name>
        <dataType>String</dataType>
        <expression>IF
			(
				ISPICKVAL({!$Record.Type},&apos;Ship-to&apos;),
					&apos;OI_AR_GEN&apos;, 
					IF
					(
						ISPICKVAL({!$Record.PMC_SS_Division__c},&apos;Domestic&apos;),		
							&apos;OI_AR_EXT&apos;, 
							IF
							(
								ISPICKVAL({!$Record.PMC_SS_Division__c},&apos;Export&apos;),
									&apos;OI_AR_EXT&apos;,
									&apos;&apos;
							)
					)
			)</expression>
    </formulas>
    <formulas>
        <name>CNPJNumber</name>
        <dataType>String</dataType>
        <expression>IF(ISNULL({!$Record.PMC_SS_TaxIDOrCNPJOrCPF__c}), &apos;&apos;, {!$Record.PMC_SS_TaxIDOrCNPJOrCPF__c})</expression>
    </formulas>
    <formulas>
        <name>CPFNumber</name>
        <dataType>String</dataType>
        <expression>IF(ISNULL({!$Record.PMC_SS_CPF__c}), &apos;&apos;, {!$Record.PMC_SS_CPF__c})</expression>
    </formulas>
    <formulas>
        <name>Division</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!$Record.PMC_SS_Division__c}), &apos;Domestic&apos;, &apos;10&apos;, &apos;Export&apos;, &apos;20&apos;,&apos;Intercompany&apos;,&apos;30&apos;,&apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>IsNaturalPerson</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.PMC_SS_CustomerType__c},&apos;B2C&apos;), &apos;X&apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>IsNewAccount</name>
        <dataType>Boolean</dataType>
        <expression>IF(ISNEW(),true,false)</expression>
    </formulas>
    <formulas>
        <name>RUCPYOrg</name>
        <dataType>String</dataType>
        <expression>IF(ISNULL({!$Record.PMC_SS_RUC__c}), &apos;&apos;, IF(ISPICKVAL({!$Record.PMC_SS_CustomerType__c},&apos;B2B&apos;), {!$Record.PMC_SS_RUC__c}, &apos;&apos;))</expression>
    </formulas>
    <formulas>
        <name>RUCPYPerson</name>
        <dataType>String</dataType>
        <expression>IF(ISNULL({!$Record.PMC_SS_RUC__c}), &apos;&apos;, IF(ISPICKVAL({!$Record.PMC_SS_CustomerType__c},&apos;B2C&apos;), {!$Record.PMC_SS_RUC__c}, &apos;&apos;))</expression>
    </formulas>
    <formulas>
        <name>SearchTermBR</name>
        <dataType>String</dataType>
        <expression>IF
			(
				ISPICKVAL({!$Record.BillingCountryCode},&apos;BR&apos;) &amp;&amp; ISPICKVAL({!$Record.PMC_SS_CustomerType__c},&apos;B2C&apos;),
					{!searchPrefix}+LEFT({!$Record.PMC_SS_CPF__c}, 9), 
					IF
					(
						ISPICKVAL({!$Record.BillingCountryCode},&apos;BR&apos;) &amp;&amp; ISPICKVAL({!$Record.PMC_SS_CustomerType__c},&apos;B2B&apos;),		
							{!searchPrefix}+LEFT({!$Record.PMC_SS_TaxIDOrCNPJOrCPF__c}, 8), 
							&apos;&apos;
					)
			)</expression>
    </formulas>
    <formulas>
        <name>SearchTermNAM</name>
        <dataType>String</dataType>
        <expression>IF
(
	ISPICKVAL({!$Record.PMC_SS_ShippingCondition__c},&apos;Z1&apos;) &amp;&amp; (ISPICKVAL({!$Record.BillingCountryCode},&apos;CA&apos;) || ISPICKVAL({!$Record.BillingCountryCode},&apos;US&apos;) || ISPICKVAL({!$Record.BillingCountryCode},&apos;PE&apos;)),
		{!searchPrefix}+{!$Record.PMC_SS_SearchTerm__c}, 
		IF
		(
			ISPICKVAL({!$Record.PMC_SS_ShippingCondition__c},&apos;&apos;) &amp;&amp; (ISPICKVAL({!$Record.BillingCountryCode},&apos;CA&apos;) || ISPICKVAL({!$Record.BillingCountryCode},&apos;US&apos;) || ISPICKVAL({!$Record.BillingCountryCode},&apos;PE&apos;)),
				{!searchPrefix}+{!$Record.Name}, 
				{!searchPrefix}+TEXT({!$Record.PMC_SS_ShippingCondition__c})
		)
)</expression>
    </formulas>
    <formulas>
        <name>Shipto_SearchTermPY</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.BillingCountryCode},&apos;PY&apos;), {!searchPrefix}+{!$Record.PMC_SS_RUC__c}, &apos;&apos;)</expression>
    </formulas>
    <interviewLabel>PMC CPI Callout After Account Update {!$Flow.CurrentDateTime}</interviewLabel>
