            </value>
        </filters>
        <filters>
            <field>PMC_CPQ_ApprovalType__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId.sbaa__Rule__r.Name</elementReference>
            </value>
        </filters>
        <object>SBQQ__QuoteLine__c</object>
        <outputAssignments>
            <assignToReference>recordId.Name</assignToReference>
