<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>PMC_CPQ_GetPriceCalloutAction</name>
        <label>Get Price Callout Action</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <actionName>PMC_CPQ_FetchLatestPriceBeforeSubmission</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>PMC_CPQ_UpdateSubmissionComment</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>lstQuotes</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>PMC_CPQ_FetchLatestPriceBeforeSubmission</nameSegment>
    </actionCalls>
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Price_change_boolean_Assignment</name>
        <label>Price change boolean Assignment</label>
        <locationX>270</locationX>
        <locationY>782</locationY>
        <assignmentItems>
            <assignToReference>PriceChangeBoolean</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IterateUpdatedQuoteLine</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_if_Price_change_detected</name>
        <label>Check if Price change detected</label>
        <locationX>182</locationX>
        <locationY>1058</locationY>
        <defaultConnector>
            <targetReference>PMC_CPQ_SubmitForApprovalBTN</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PMC_CPQ_PriceChangeDetected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PriceChangeBoolean</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PMC_CPQ_GoToQLE</targetReference>
            </connector>
            <label>Price change detected decision</label>
        </rules>
    </decisions>
    <decisions>
        <name>Price_Change_Decision</name>
        <label>Price Change Decision</label>
        <locationX>402</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>IterateUpdatedQuoteLine</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Price_Changed_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IterateUpdatedQuoteLine.PMC_CPQ_FinalPricePerTon__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>IterateUpdatedQuoteLine.PMC_CPQ_FinalPricePerTonne__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Price_change_boolean_Assignment</targetReference>
            </connector>
            <label>Price Changed Outcome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>TEST_SUBMIT_CALLOUT_POC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fetch Latest Price before Quote Submission</label>
    <loops>
        <name>IterateUpdatedQuoteLine</name>
        <label>Iterate Updated Quote Line</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <collectionReference>GetUpdatedQuoteLineRecords</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Price_Change_Decision</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_if_Price_change_detected</targetReference>
        </noMoreValuesConnector>
    </loops>
