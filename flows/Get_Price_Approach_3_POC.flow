    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>test</description>
        <name>entry_decision</name>
        <label>entry decision</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Test</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.SBQQ__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>testfetch_price</targetReference>
            </connector>
            <label>Test</label>
        </rules>
    </decisions>
    <description>This flow is for checking the admissibility of the approach and how it will pan out in the final implementation.</description>
    <environments>Default</environments>
    <formulas>
        <description>test</description>
        <name>threedays</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Record.PMC_CPQ_ContractEnd__c},1)</expression>
    </formulas>
    <interviewLabel>Get Price Approach 3 POC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Price Approach 3 POC</label>
    <processMetadataValues>
