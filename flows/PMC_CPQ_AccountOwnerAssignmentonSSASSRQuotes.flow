<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>AssignOwnerasAccountManager</name>
        <label>Assign Owner as Account Manager</label>
        <locationX>242</locationX>
        <locationY>384</locationY>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.PMC_CPQ_AccountManager__r.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>CheckQuoteCreatedbySSASSRDecision</name>
        <label>Check Quote Created by SSA/SSR Decision</label>
        <locationX>374</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsQuoteCreatedbySSASSR</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_QuoteOwnerRole__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>SSA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_QuoteOwnerRole__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>SSR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_AccountManager__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AssignOwnerasAccountManager</targetReference>
            </connector>
            <label>Is Quote Created by SSA/SSR</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>PMC_CPQ_AccountOwnerAssignmentonSSASSRQuotes {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC_CPQ_AccountOwnerAssignmentonSSASSRQuotes</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <object>SBQQ__Quote__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>ScheduledpathAfter15mins</name>
            <connector>
                <targetReference>CheckQuoteCreatedbySSASSRDecision</targetReference>
            </connector>
            <label>Scheduled path After 15 mins</label>
            <offsetNumber>5</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
