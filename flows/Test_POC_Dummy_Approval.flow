    <decisions>
        <name>Check_if_Price_change_detected</name>
        <label>Check if Price change detected</label>
        <locationX>358</locationX>
        <locationY>2258</locationY>
        <defaultConnector>
            <targetReference>QuantityBelowThresholdDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PMC_CPQ_PriceChangeDetected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PriceChangeBoolean</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PMC_CPQ_GoToQLE</targetReference>
            </connector>
            <label>Price change detected decision</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if contract valid from and to fields are populated on Quote</description>
        <name>ContractValidDatesValidation</name>
        <label>Contract Valid Dates Validation</label>
        <locationX>1172</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ContractDatesValidation_ContractValidDatesPopulatedOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_ContractStart__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_ContractEnd__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.SBQQ__Opportunity2__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Comment</targetReference>
            </connector>
            <label>Contract Valid Dates Populated Outcome</label>
        </rules>
        <rules>
            <name>MissingFieldsOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>recordId.SBQQ__Opportunity2__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_ContractStart__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_ContractEnd__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MissingFieldsErrorScreen</targetReference>
            </connector>
            <label>Missing Fields Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>DiscountTypeDecision</name>
        <label>Discount Type Decision</label>
        <locationX>1106</locationX>
        <locationY>890</locationY>
        <defaultConnector>
            <targetReference>IteratedDiscountMetadata</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>DiscountTypeDecision_CommodityOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IteratedDiscountMetadata.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PMC_CPQ_DiscountThresholdCommodity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CommodityDiscountAssignment</targetReference>
            </connector>
            <label>Commodity Outcome</label>
        </rules>
        <rules>
            <name>PerformanceOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IteratedDiscountMetadata.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PMC_CPQ_DiscountThresholdPerformance</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PerformanceDiscountAssignment</targetReference>
            </connector>
            <label>Performance Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>Price_Change_Decision</name>
        <label>Price Change Decision</label>
        <locationX>578</locationX>
        <locationY>1574</locationY>
        <defaultConnector>
            <targetReference>QuantityBelowThresholdOutcome</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Price_Changed_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IterateUpdatedQuoteLine.PMC_CPQ_FinalPricePerTon__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>IterateUpdatedQuoteLine.PMC_CPQ_FinalPricePerTonne__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Price_change_boolean_Assignment</targetReference>
            </connector>
            <label>Price Changed Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>QuantityBelowThresholdDecision</name>
        <label>Quantity Below Threshold Decision</label>
        <locationX>666</locationX>
        <locationY>2366</locationY>
        <defaultConnector>
            <targetReference>QuoteApprovalStatusAssignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Auto Approved Outcome</defaultConnectorLabel>
        <rules>
            <name>QuantityBelowThresholdDecision_SubmitforApprovalOutcome</name>
            <conditionLogic>(1 AND 2) OR 3 OR ( 4 AND 5)</conditionLogic>
            <conditions>
                <leftValueReference>QuantityBelowThresholdBoolean</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_QuoteApproved__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_QuoteApproved__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_Region__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>North Brazil</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_Region__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>South Brazil</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Quote_Lines</targetReference>
            </connector>
            <label>Submit for Approval Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>QuantityBelowThresholdOutcome</name>
        <label>Quantity Below Threshold Outcome</label>
        <locationX>578</locationX>
        <locationY>1874</locationY>
        <defaultConnector>
            <targetReference>IterateUpdatedQuoteLine</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>QuanityBelowThresholdOutcome</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>IterateUpdatedQuoteLine.PMC_CPQ_PermittedQuantity__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IterateUpdatedQuoteLine.SBQQ__Quote__r.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>North Brazil</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IterateUpdatedQuoteLine.SBQQ__Quote__r.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>South Brazil</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>QuantityBelowThresholdAssignment</targetReference>
            </connector>
            <label>Quanity below threshold outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>QuoteRegionDecision</name>
        <label>Quote Region Decision</label>
        <locationX>358</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>GetBrazilDiscountMetadata</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Brazil Outcome</defaultConnectorLabel>
        <rules>
            <name>QuoteRegionDecision_NorthAmerica</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>US</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Canada</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetUpdatedQuoteLineRecords</targetReference>
            </connector>
            <label>North America</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>AutoApprovalToggle</name>
        <dataType>Boolean</dataType>
        <expression>IF({!recordId.PMC_CPQ_AutoApprovedToggle__c}=true, false, true)</expression>
    </formulas>
    <formulas>
        <name>BypassVRToggle</name>
        <dataType>Boolean</dataType>
        <expression>IF({!recordId.PMC_CPQ_FlowVRByPassToggle__c}=true, false, true)</expression>
    </formulas>
    <formulas>
        <name>currencyFloorPrice</name>
        <dataType>Currency</dataType>
        <expression>IF(
    ISNULL({!recordId.PMC_CPQ_BelowFloorLowNUP__c}),
    0,
    IF(
        AND(
            ({!Quote_Lines_Loop.PMC_CPQ_NetUnitPriceCustomFormula__c} - {!Quote_Lines_Loop.PMC_CPQ_PriceGuidanceFloor__c} &lt; 0),
            (({!Quote_Lines_Loop.PMC_CPQ_NetUnitPriceCustomFormula__c} - {!Quote_Lines_Loop.PMC_CPQ_PriceGuidanceFloor__c}) &lt; {!recordId.PMC_CPQ_BelowFloorLowNUP__c} - {!recordId.PMC_CPQ_BelowFloorLowFloor__c})
        ),
        {!Quote_Lines_Loop.PMC_CPQ_PriceGuidanceFloor__c},
        {!recordId.PMC_CPQ_BelowFloorLowFloor__c}
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>currencyNetPriceMax</name>
        <dataType>Currency</dataType>
        <expression>IF(
    ISNULL({!recordId.PMC_CPQ_BelowFloorLowNUP__c}),
    0,
    IF(
        AND(
            ({!Quote_Lines_Loop.PMC_CPQ_NetUnitPriceCustomFormula__c} - {!Quote_Lines_Loop.PMC_CPQ_PriceGuidanceFloor__c} &lt; 0),
            (({!Quote_Lines_Loop.PMC_CPQ_NetUnitPriceCustomFormula__c} - {!Quote_Lines_Loop.PMC_CPQ_PriceGuidanceFloor__c}) &lt; {!recordId.PMC_CPQ_BelowFloorLowNUP__c} - {!recordId.PMC_CPQ_BelowFloorLowFloor__c})
        ),
        {!Quote_Lines_Loop.PMC_CPQ_NetUnitPriceCustomFormula__c},
        {!recordId.PMC_CPQ_BelowFloorLowNUP__c}
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Test POC Dummy Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test POC Dummy Approval</label>
