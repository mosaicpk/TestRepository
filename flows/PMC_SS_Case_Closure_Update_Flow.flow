        <locationX>1106</locationX>
        <locationY>1271</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>SendAccountTaskCreationNotification</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
