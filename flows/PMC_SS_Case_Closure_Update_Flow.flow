<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>To send notification for Contact Task Creation</description>
        <name>SendAccountTaskCreationNotification</name>
        <label>Send Account Task Creation Notification</label>
        <locationX>1106</locationX>
        <locationY>1379</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector>
            <targetReference>AccountUpdateAfterTaskCreated</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Error_Log</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>AccountCustomNotificationTypeGet.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>lstOfTaskOwnerIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <elementReference>STRING_ACCOUNT_TASK_NOTIFICATION_TITLE</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>strTaskNotificationBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>recTaskCreated.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>To collect Task owner for notification</description>
        <name>AccountTaskOwnerIdAssignment</name>
        <label>Account Task Owner Id Assignment</label>
        <locationX>1106</locationX>
        <locationY>1163</locationY>
        <assignmentItems>
            <assignToReference>lstOfTaskOwnerIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>strGroupId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>AccountCustomNotificationTypeGet</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>To assign Task Owner for Account NA Case</description>
        <name>NAAccountTaskOwnerAssignment</name>
        <label>NA Account Task Owner Assignment</label>
        <locationX>842</locationX>
        <locationY>863</locationY>
        <assignmentItems>
            <assignToReference>strGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NAAccountQueueGet.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>AccountTaskRecordCreate</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>To assign Task Owner for Account SA Case</description>
        <name>SAAccountTaskOwnerAssignment</name>
        <label>SA Account Task Owner Assignment</label>
        <locationX>1370</locationX>
        <locationY>863</locationY>
        <assignmentItems>
            <assignToReference>strGroupId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SAAccountQueueGet.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>AccountTaskRecordCreate</targetReference>
        </connector>
    </assignments>
    <constants>
        <description>Notification Title for Account Task Notification</description>
        <name>STRING_ACCOUNT_TASK_NOTIFICATION_TITLE</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Account Record changes have not been approved</stringValue>
        </value>
    </constants>
    <constants>
        <description>Subject for new account task</description>
        <name>STRING_ACCOUNT_TASK_SUBJECT</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Account Record changes have not been approved.</stringValue>
        </value>
    </constants>
    <constants>
        <name>STRING_CANADA</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Canada</stringValue>
        </value>
    </constants>
    <constants>
        <description>Title for Contact Task Notification</description>
        <name>STRING_CONTACT_TASK_NOTIFICATION_TITLE</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Contact Record changes have not been approved</stringValue>
        </value>
    </constants>
    <constants>
        <description>Subject for new contact task</description>
        <name>STRING_CONTACT_TASK_SUBJECT</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Contact Record changes have not been approved.</stringValue>
        </value>
    </constants>
    <constants>
        <name>STRING_NORTH_AMERICA</name>
        <dataType>String</dataType>
        <value>
            <stringValue>North America</stringValue>
        </value>
    </constants>
    <constants>
        <name>STRING_UNITED_STATES</name>
        <dataType>String</dataType>
        <value>
            <stringValue>United States</stringValue>
        </value>
    </constants>
    <decisions>
        <name>CaseLinkedObjectCheckDecision</name>
        <label>Case Linked Object Check Decision</label>
        <locationX>2756</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CaseLinkedObjectCheck_Account</name>
            <conditionLogic>(1 AND 2) OR (1 AND 3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CreatedBy.Profile.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>strDigitalHubProfile</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.CreatedBy.Profile.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>strDigitalHubProfile</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsAccountCaseRejectedDecision</targetReference>
            </connector>
            <label>Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>CaseLinkedToObjectDecision</name>
        <label>Case Linked To Object Decision</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CaseLinkedToObject_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AccountUpdate</targetReference>
            </connector>
            <label>Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsAccountCaseRejectedDecision</name>
        <label>Is Account Case Rejected Decision</label>
        <locationX>2030</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>AccountChangesApprovedUpdate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccountCaseRejected_CaseRejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>NASAAccountCaseDecision</targetReference>
            </connector>
            <label>Case Rejected</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsClientDeniedDecision</name>
        <label>Is Client Denied Decision</label>
        <locationX>2030</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsClientDenied_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ClientDenied__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CaseLinkedToObjectDecision</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
        <rules>
            <name>IsClientDenied_No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ClientDenied__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CaseLinkedObjectCheckDecision</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <description>To check whether an Account Owner is NA or SA</description>
        <name>NASAAccountCaseDecision</name>
        <label>NA/SA Account Case Decision</label>
        <locationX>1106</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>SAAccountQueueGet</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>SA Account Case</defaultConnectorLabel>
        <rules>
            <name>NASAAccountCase_NAAccountCase</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Owner.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_NORTH_AMERICA</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Owner.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_CANADA</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Owner.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>STRING_UNITED_STATES</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>NAAccountQueueGet</targetReference>
            </connector>
            <label>NA Account Case</label>
        </rules>
    </decisions>
    <description>Added as a part of MD fix for MDM field on Account</description>
    <environments>Default</environments>
    <formulas>
        <name>AccountTaskDesc</name>
        <dataType>String</dataType>
        <expression>&quot;The changes that you’ve made on &quot;&amp; {!$Record.Account.Name}&amp; &quot; have not been approved by MDM. Please re-submit your changes or contact MDM team to understand why the rejection took place.&quot;</expression>
    </formulas>
    <formulas>
        <name>ContactTaskDesc</name>
        <dataType>String</dataType>
        <expression>&quot;The changes that you’ve made on &quot; &amp; {!$Record.Contact.FirstName} &amp; &quot; &quot; &amp;{!$Record.Contact.LastName} &amp;&quot; have not been approved by MDM. Please re-submit your changes or contact MDM team to understand why the rejection took place.&quot;</expression>
    </formulas>
    <formulas>
        <description>Body for Task Notification</description>
        <name>strTaskNotificationBody</name>
        <dataType>String</dataType>
        <expression>&apos;The changes that you’ve made on &apos; + {!$Record.Subject} + &apos; have not been approved by MDM. Please re-submit your changes or contact MDM team to understand why the rejection took place.&apos;</expression>
    </formulas>
    <interviewLabel>PMC SS Case Closure Update Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Case Closure Update Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>To create Task for rejected changes in Account</description>
        <name>AccountTaskRecordCreate</name>
        <label>Account Task Record Create</label>
        <locationX>1106</locationX>
        <locationY>1055</locationY>
        <assignRecordIdToReference>recTaskCreated.Id</assignRecordIdToReference>
        <connector>
            <targetReference>AccountTaskOwnerIdAssignment</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Error_Log</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>AccountTaskDesc</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>strGroupId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_SS_RejectionReason__c</field>
            <value>
                <elementReference>$Record.PMC_SS_MasterDataRejectionDetails__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>STRING_ACCOUNT_TASK_SUBJECT</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Account.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Error_Log</name>
        <label>Error Log</label>
        <locationX>314</locationX>
        <locationY>647</locationY>
