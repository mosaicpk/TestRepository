<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>SetQuoteOwnerAsAssignedto</name>
        <label>Set Quote Owner As Assigned to</label>
        <locationX>374</locationX>
        <locationY>719</locationY>
        <assignmentItems>
            <assignToReference>$Record.sbaa__AssignedTo__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>QuoteOwnerApproverGetRecords.sbaa__User__r.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>ConfigSettingDecision</name>
        <label>Config Setting Decision</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>IsApprovalRecordNewOrUpdateDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ConfigSetting_DontRunOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Don&apos;t Run Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>FlagAssignToQuoteOwnerDecision</name>
        <label>Flag Assign To Quote Owner Decision</label>
        <locationX>506</locationX>
        <locationY>503</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>FlagAssignToQuoteOwner_AssignToQuoteOwnerFlaggedOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_AssigntoQuoteOwner__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>QuoteOwnerApproverGetRecords</targetReference>
            </connector>
            <label>Assign To Quote Owner Flagged Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsApprovalRecordNewOrUpdateDecision</name>
        <label>Is Approval Record New Or Update Decision</label>
        <locationX>506</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsApprovalRecordNewOrUpdate_IfApprovalNewOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>BooleanIsNewRecordFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>If Approval New Outcome</label>
        </rules>
        <rules>
            <name>IsApprovalRecordNewOrUpdate_IfApprovalUpdateOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>BooleanIsNewRecordFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FlagAssignToQuoteOwnerDecision</targetReference>
            </connector>
            <label>If Approval Update Outcome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>BooleanIsNewRecordFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>PMC CPQ Approval Before Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC CPQ Approval Before Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>QuoteOwnerApproverGetRecords</name>
        <label>Quote Owner Approver Get Records</label>
        <locationX>374</locationX>
        <locationY>611</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>SetQuoteOwnerAsAssignedto</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>sbaa__User__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Quote__r.Owner:User.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>sbaa__Approver__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>ConfigSettingDecision</targetReference>
        </connector>
        <object>sbaa__Approval__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
