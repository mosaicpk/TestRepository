<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>ArticleArchiveAction</name>
        <label>Article Archive Action</label>
        <locationX>50</locationX>
        <locationY>876</locationY>
        <actionName>archiveKnowledgeArticles</actionName>
        <actionType>archiveKnowledgeArticles</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>articleVersionIdList</name>
            <value>
                <elementReference>lstKnowledgeVersion</elementReference>
            </value>
        </inputParameters>
        <nameSegment>archiveKnowledgeArticles</nameSegment>
    </actionCalls>
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>VersionAssignment</name>
        <label>Version Assignment</label>
        <locationX>270</locationX>
        <locationY>576</locationY>
        <assignmentItems>
            <assignToReference>lstKnowledgeVersion</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ArticleVersionLoop.KnowledgeArticleId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>ArticleVersionLoop</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>BulletinEndDateDecision</name>
        <label>Bulletin End Date Decision</label>
        <locationX>380</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BulletinEndDate_TodayOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_EndDate__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>TodayFormula</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PMC_SS_TechnicalBulletinNotice</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ArticleVersionGet</targetReference>
            </connector>
            <label>Today Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckEmptyListDecision</name>
        <label>Check Empty List Decision</label>
        <locationX>182</locationX>
        <locationY>768</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckEmptyList_VersionsPresentOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>lstKnowledgeVersion</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ArticleArchiveAction</targetReference>
            </connector>
            <label>Versions Present Outcome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>TodayFormula</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Archive Bulletin Article After Enddate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Archive Bulletin Article Flow</label>
    <loops>
        <name>ArticleVersionLoop</name>
        <label>Article Version Loop</label>
        <locationX>182</locationX>
        <locationY>468</locationY>
        <collectionReference>ArticleVersionGet</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>VersionAssignment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>CheckEmptyListDecision</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>ArticleVersionGet</name>
        <label>Article Version Get</label>
        <locationX>182</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>ArticleVersionLoop</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ArticleNumber</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ArticleNumber</elementReference>
            </value>
        </filters>
        <filters>
            <field>PublishStatus</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Online</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>KnowledgeArticleVersion</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>BulletinEndDateDecision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PublishStatus</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Online</stringValue>
            </value>
        </filters>
        <filters>
            <field>PMC_SS_EndDateNoUse__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Knowledge__kav</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2023-07-26</startDate>
            <startTime>09:45:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>lstKnowledgeVersion</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
