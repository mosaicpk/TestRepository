<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_for_Approval_Process</name>
        <label>Check for Approval Process</label>
        <locationX>275</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Agreed_Price_Lower_Floor_Price_and_over_10K_ST</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_FinalAgreedPrice__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Record.PMC_CPQ_Floorprice__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>10000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_OrderItem_Approval</targetReference>
            </connector>
            <label>If Agreed Price Lower Floor Price and over 10K ST</label>
        </rules>
    </decisions>
    <decisions>
        <name>Configure_Setting_Decision</name>
        <label>Configure Setting Decision</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>If_Agreed_Price_Change</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Don_t_Run_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Don&apos;t Run Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Agreed_Price_Change</name>
        <label>If Agreed Price Change</label>
        <locationX>473</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Change_in_Agreed_Price</name>
            <conditionLogic>1 AND ((2 AND 3) OR (4 AND 5))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Order.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>North America</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_FinalAgreedPrice__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_FinalAgreedPrice__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_for_Approval_Process</targetReference>
            </connector>
            <label>Change in Agreed Price</label>
        </rules>
    </decisions>
    <description>removed role PMC_SS_NASalesServiceRepresentativeSSRRole</description>
    <environments>Default</environments>
    <interviewLabel>Order Line Approval Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order Line Approval Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_OrderItem_Approval</name>
        <label>Create OrderItem Approval</label>
        <locationX>143</locationX>
        <locationY>647</locationY>
        <inputAssignments>
            <field>Account_Name__c</field>
            <value>
                <elementReference>$Record.Order.Account.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ApprovalStatus__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contract_Number__c</field>
            <value>
                <elementReference>$Record.SBQQ__Contract__r.ContractNumber</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Customer_Purchase_Order__c</field>
            <value>
                <elementReference>$Record.PMC_CPQ_LinePONumber__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FPD_List_Price__c</field>
            <value>
                <elementReference>$Record.PMC_CPQ_Floorprice__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Final_Agreed_Price__c</field>
            <value>
                <elementReference>$Record.PMC_CPQ_FinalAgreedPrice__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Integration_Message__c</field>
            <value>
                <elementReference>$Record.PMC_CPQ_OrderItemIntegrationMessage__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OrderItem__c</field>
            <value>
                <stringValue>{!$Record.Id}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Order_Line_Status__c</field>
            <value>
                <elementReference>$Record.PMC_CPQ_OrderLineStatus__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Order_Number__c</field>
            <value>
                <elementReference>$Record.Order.OrderNumber</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Price_By_Date__c</field>
            <value>
                <elementReference>$Record.PMC_CPQ_PricingDate__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Product__c</field>
            <value>
                <elementReference>$Record.Product2.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Quantity__c</field>
            <value>
                <elementReference>$Record.Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Quote__c</field>
            <value>
                <elementReference>$Record.Order.Contract.SBQQ__Quote__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SAP_Order_Number__c</field>
            <value>
                <elementReference>$Record.Order.PMC_CPQ_SAPOrderNumber__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Ship_To__c</field>
            <value>
                <elementReference>$Record.PMC_CPQ_ShipTo__r.Name</elementReference>
            </value>
        </inputAssignments>
        <object>Order_Line_Approval__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Configure_Setting_Decision</targetReference>
        </connector>
        <object>OrderItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
