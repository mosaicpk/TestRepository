    <decisions>
        <name>QuantityBelowThresholdDecision</name>
        <label>Quantity Below Threshold Decision</label>
        <locationX>1786</locationX>
        <locationY>3266</locationY>
        <defaultConnector>
            <targetReference>QuoteApprovalStatusAssignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Auto Approved Outcome</defaultConnectorLabel>
        <rules>
            <name>QuantityBelowThresholdDecision_SubmitforApprovalOutcome</name>
            <conditionLogic>(1 AND 2) OR 3 OR ( 4 AND 5) OR 6</conditionLogic>
            <conditions>
                <leftValueReference>QuantityBelowThresholdBoolean</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_QuoteApproved__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_QuoteApproved__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_Region__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>North Brazil</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_Region__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>South Brazil</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Replacement_Margin_Check.IsApprovalRequired</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateTriggeredQuote</targetReference>
            </connector>
            <label>Submit for Approval Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>QuantityBelowThresholdOutcome</name>
        <label>Quantity Below Threshold Outcome</label>
        <locationX>1138</locationX>
        <locationY>1982</locationY>
        <defaultConnector>
            <targetReference>IterateUpdatedQuoteLine</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>QuanityBelowThresholdOutcome</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>IterateUpdatedQuoteLine.PMC_CPQ_PermittedQuantity__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IterateUpdatedQuoteLine.SBQQ__Quote__r.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>North Brazil</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IterateUpdatedQuoteLine.SBQQ__Quote__r.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>South Brazil</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>QuantityBelowThresholdAssignment</targetReference>
            </connector>
            <label>Quanity below threshold outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>QuoteRegionDecision</name>
        <label>Quote Region Decision</label>
        <locationX>918</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Replacement_Margin_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Brazil Outcome</defaultConnectorLabel>
        <rules>
            <name>QuoteRegionDecision_NorthAmerica</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>US</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Canada</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetUpdatedQuoteLineRecords</targetReference>
            </connector>
            <label>North America</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>AutoApprovalToggle</name>
        <dataType>Boolean</dataType>
        <expression>IF({!recordId.PMC_CPQ_AutoApprovedToggle__c}=true, false, true)</expression>
    </formulas>
    <formulas>
        <name>BypassVRToggle</name>
        <dataType>Boolean</dataType>
        <expression>IF({!recordId.PMC_CPQ_FlowVRByPassToggle__c}=true, false, true)</expression>
    </formulas>
    <formulas>
        <name>currencyBelowFloorHighFloor</name>
        <dataType>Currency</dataType>
        <expression>IF(
    NOT(ISNULL({!recordId.PMC_CPQ_BelowFloorHighFloor__c})),
    IF(
        AND(
            {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c}  &lt;0,
            {!recordId.PMC_CPQ_BelowFloorHighFloor__c} - {!recordId.PMC_CPQ_BelowFloorHighNUP__c} &lt; {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c}  - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c}
        ),
        {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c}, {!recordId.PMC_CPQ_BelowFloorHighFloor__c}
    ),
    {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>currencyBelowFloorHighNUP</name>
        <dataType>Currency</dataType>
        <expression>IF(
    NOT(ISNULL({!recordId.PMC_CPQ_BelowFloorHighNUP__c})),
    IF(
        AND(
            {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c}  &lt;0,
            {!recordId.PMC_CPQ_BelowFloorHighFloor__c} - {!recordId.PMC_CPQ_BelowFloorHighNUP__c} &lt; {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c}  - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c}
        ),
        {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c}, {!recordId.PMC_CPQ_BelowFloorHighNUP__c}
    ),
    {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>currencyBelowFloorLowFloor</name>
        <dataType>Currency</dataType>
        <expression>IF(
    NOT(ISNULL({!recordId.PMC_CPQ_BelowFloorLowFloor__c})),
    IF(
        AND(
            {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c}  &lt;0,
            {!recordId.PMC_CPQ_BelowFloorLowFloor__c} - {!recordId.PMC_CPQ_BelowFloorLowNUP__c} &lt; {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c}  - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c}
        ), {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c}, {!recordId.PMC_CPQ_BelowFloorLowFloor__c}
    ),
    {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>currencyBelowFloorLowNUP</name>
        <dataType>Currency</dataType>
        <expression>IF(
    NOT(ISNULL({!recordId.PMC_CPQ_BelowFloorLowNUP__c})),
    IF(
        AND(
            {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c}  &lt;0,
            {!recordId.PMC_CPQ_BelowFloorLowFloor__c} - {!recordId.PMC_CPQ_BelowFloorLowNUP__c} &lt; {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c}  - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c}
        ),
        {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c}, {!recordId.PMC_CPQ_BelowFloorLowNUP__c}
    ),
    {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>currencyBetweenTCHighNUP</name>
        <dataType>Currency</dataType>
        <expression>IF(
    NOT(ISNULL({!recordId.PMC_CPQ_BetweenTCHighNUP__c})),
    IF(
        {!recordId.PMC_CPQ_BetweenTCHighNUP__c} &lt; (({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceTarget__c})/({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceCeiling__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceTarget__c} )) * 100,
        (({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceTarget__c})/({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceCeiling__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceTarget__c} )) * 100,
        {!recordId.PMC_CPQ_BetweenTCHighNUP__c}
    ),
    (({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceTarget__c})/({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceCeiling__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceTarget__c} )) * 100
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>currencyBetweenTFHighNUP</name>
        <dataType>Currency</dataType>
        <expression>IF(
    NOT(ISNULL({!recordId.PMC_CPQ_BetweenTFHighNUP__c})),
    IF(
        {!recordId.PMC_CPQ_BetweenTFHighNUP__c} &gt; (({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c})/({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceTarget__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c})) * 100,
        (({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c})/({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceTarget__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c})) * 100,
        {!recordId.PMC_CPQ_BetweenTFHighNUP__c}
    ),
    (({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c})/({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceTarget__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c})) * 100
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>currencyBetweenTFLowNUP</name>
        <dataType>Currency</dataType>
        <expression>IF(
    NOT(ISNULL({!recordId.PMC_CPQ_BetweenTFLowNUP__c})),
    IF(
        {!recordId.PMC_CPQ_BetweenTFLowNUP__c} &gt; (({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c})/({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceTarget__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c})) * 100,
        (({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c})/({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceTarget__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c})) * 100,
        {!recordId.PMC_CPQ_BetweenTFLowNUP__c}
    ),
    (({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_NetUnitPrice__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c})/({!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceTarget__c} - {!QuoteLinesApprovalFieldsLoop.PMC_CPQ_PriceGuidanceFloor__c})) * 100
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
