    <decisions>
        <name>ApprovalRuleDecision</name>
        <label>Approval Rule Decision</label>
        <locationX>2470</locationX>
        <locationY>2798</locationY>
        <defaultConnector>
            <targetReference>QuoteLinesApprovalFieldsLoop</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ApprovalRule_BelowFloorLowOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>QuoteLinesApprovalFieldsLoop.PMC_CPQ_ApprovalRequired__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>BelowFloorLowAssignment</targetReference>
            </connector>
            <label>Below Floor Low Outcome</label>
        </rules>
        <rules>
            <name>ApprovalRule_BelowFloorHighOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>QuoteLinesApprovalFieldsLoop.PMC_CPQ_ApprovalRequired__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>6.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>BelowFloorHighAssignment</targetReference>
            </connector>
            <label>Below Floor High Outcome</label>
        </rules>
        <rules>
            <name>ApprovalRule_BetweenTargetAndFloorLowOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>QuoteLinesApprovalFieldsLoop.PMC_CPQ_ApprovalRequired__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>BetweenTargetFloorLowVolumeAssignment</targetReference>
            </connector>
            <label>Between Target &amp; Floor Low Outcome</label>
        </rules>
        <rules>
            <name>ApprovalRule_BetweenTargetFloorHighOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>QuoteLinesApprovalFieldsLoop.PMC_CPQ_ApprovalRequired__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>4.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>BetweenTFHighVolumeAssignment</targetReference>
            </connector>
            <label>Between Target &amp; Floor High Outcome</label>
        </rules>
        <rules>
            <name>ApprovalRule_BetweenTargetCeilingHighOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>QuoteLinesApprovalFieldsLoop.PMC_CPQ_ApprovalRequired__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>BetweenTargetCeilingAssignment</targetReference>
            </connector>
            <label>Between Target &amp; Ceiling High Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Price_change_detected</name>
