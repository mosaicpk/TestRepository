    <decisions>
        <name>CheckQuoteRegionDecision</name>
        <label>Check Quote Region Decision</label>
        <locationX>1786</locationX>
        <locationY>2582</locationY>
        <defaultConnector>
            <targetReference>QuantityBelowThresholdDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckQuoteRegion_NorthAmericaOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>US</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Canada</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>QuoteLinesApprovalFieldsLoop</targetReference>
            </connector>
            <label>North America Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if contract valid from and to fields are populated on Quote</description>
        <name>ContractValidDatesValidation</name>
        <label>Contract Valid Dates Validation</label>
        <locationX>2144</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ContractDatesValidation_ContractValidDatesPopulatedOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_ContractStart__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_ContractEnd__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.SBQQ__Opportunity2__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.SBQQ__LineItemCount__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Comment</targetReference>
            </connector>
            <label>Contract Valid Dates Populated Outcome</label>
        </rules>
        <rules>
            <name>MissingFieldsOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>recordId.SBQQ__Opportunity2__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_ContractStart__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId.PMC_CPQ_ContractEnd__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MissingFieldsErrorScreen</targetReference>
            </connector>
            <label>Missing Fields Outcome</label>
        </rules>
        <rules>
            <name>Missing_Quote_lines_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId.SBQQ__LineItemCount__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MissingQuoteLinesErrorScreen</targetReference>
            </connector>
            <label>Missing Quote lines Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>DiscountTypeDecision</name>
