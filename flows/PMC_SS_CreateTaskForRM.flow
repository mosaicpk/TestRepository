<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>PMC_SS_CheckforRMAndIntegrationUser</name>
        <label>Check for RM And Integration User</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PMC_SS_IsRMAndIntegrationUser</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PMC_SS_AccountRecord.PMC_SS_RegionalManager__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PMC_SS_AccountRecord.Owner.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Salesforce API Only System Integrations</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PMC_SS_TaskCreationForRM</targetReference>
            </connector>
            <label>Is RM And Integration User</label>
        </rules>
    </decisions>
    <description>This will create Task for RM whenever Account created by Integration user</description>
    <environments>Default</environments>
    <formulas>
        <name>PMC_SS_Comments</name>
        <dataType>String</dataType>
        <expression>&apos;Account&apos; +{!PMC_SS_AccountRecord.Name}+ &apos;needs to be assigned to its correct owner. Currently, it is assigned to an Integration User&apos;</expression>
    </formulas>
    <formulas>
        <name>PMC_SS_DueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()+7</expression>
    </formulas>
    <formulas>
        <name>PMC_SS_Subject</name>
        <dataType>String</dataType>
        <expression>&apos;Review Account Ownership for Account&apos; +{!PMC_SS_AccountRecord.Name}</expression>
    </formulas>
    <interviewLabel>Create Task For RM {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Task For RM</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>PMC_SS_CheckforRMAndIntegrationUser</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <subflows>
        <name>PMC_SS_TaskCreationForRM</name>
        <label>Task Creation For RM</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <flowName>PMC_SS_TaskCreationSubFlow</flowName>
        <inputAssignments>
            <name>PMC_SS_Comments</name>
            <value>
                <elementReference>PMC_SS_Comments</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>PMC_SS_DueDate</name>
            <value>
                <elementReference>PMC_SS_DueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>PMC_SS_OwnerId</name>
            <value>
                <elementReference>PMC_SS_AccountRecord.PMC_SS_RegionalManager__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>PMC_SS_Priority</name>
            <value>
                <elementReference>PMC_SS_Priority</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>PMC_SS_RelatedTo</name>
            <value>
                <elementReference>PMC_SS_AccountRecord.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>PMC_SS_Status</name>
            <value>
                <elementReference>PMC_SS_Status</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>PMC_SS_Subject</name>
            <value>
                <elementReference>PMC_SS_Subject</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>PMC_SS_AccountRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>PMC_SS_Priority</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Normal</stringValue>
        </value>
    </variables>
    <variables>
        <name>PMC_SS_Status</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Open</stringValue>
        </value>
    </variables>
</Flow>
