<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>ApprovalStatusAssignment</name>
        <label>Approval Status Assignment</label>
        <locationX>308</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>recordId.sbaa__Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>ApprovalStatusUpdate</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign quote object Approval status field to Approved once Approval object status field is updated to Approved</description>
        <name>QuoteApprovalStatusAssignment</name>
        <label>Quote Approval Status Assignment</label>
        <locationX>308</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>GetQuoteRecord.ApprovalStatus__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>QuoteApprovalStatusUpdate</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>ConfigSettingDecision</name>
        <label>Config Setting Decision</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>ApprovalStatusAssignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ConfigSetting_Dontrunoutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Don&apos;t run outcome</label>
        </rules>
    </decisions>
    <description>Automated flow to approve the quote on behalf of approver</description>
    <environments>Default</environments>
    <interviewLabel>P {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC CPQ Approve Quote Behalf</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>ErrorLogCreate</name>
