    <formulas>
        <name>SalesAreaCombination</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.PMC_CPQ_Sales_Area__r.PMC_SS_SalesOrganization__c})&amp;&quot; &quot;&amp; CASE(TEXT({!$Record.PMC_CPQ_Sales_Area__r.PMC_SS_Division__c}),&apos;10&apos;,&apos;Domestic&apos;,&apos;20&apos;,&apos;Export&apos;,&apos;30&apos;,&apos;Intercompany&apos;,&apos; &apos;)&amp;&quot; &quot;&amp;&quot;Common&quot;</expression>
    </formulas>
    <formulas>
        <name>strSemicolonRemoval</name>
        <dataType>String</dataType>
        <expression>LEFT({!MutiSelectValue}, LEN({!MutiSelectValue})-1)</expression>
    </formulas>
