    <decisions>
        <name>SalesAreaAlreadyExistDecision</name>
        <label>Sales Area Already Exist Decision</label>
        <locationX>440</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>ProductSalesAreaGet</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SalesAreaAlreadyExist_ExistsOutcome</name>
            <conditionLogic>1 AND (NOT(2) OR (2 AND(3 OR 4)))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_Product__r.PMC_CPQ_ProductSalesArea__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.PMC_CPQ_Sales_Area__r.PMC_DH_SalesArea__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>boolIsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_Product__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_Sales_Area__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Exists Outcome</label>
        </rules>
    </decisions>
