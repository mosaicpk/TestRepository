    <screens>
        <description>Number of Product Request required question screen for users</description>
        <name>NumberofProductRequestQuestionScreen</name>
        <label>Number of Product Request Question Screen</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>CreateProductRequestDecision</targetReference>
        </connector>
        <fields>
            <name>NumberofProductRequestQuestionScreen_Section1</name>
            <fieldType>RegionContainer</fieldType>
            <fields>
                <name>NumberofProductRequestQuestionScreen_Section1_Column1</name>
                <fieldType>Region</fieldType>
                <fields>
                    <name>QuestionForUsersDisplayText</name>
                    <fieldText>&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;How many Product Requests do you want to create?&lt;/p&gt;</fieldText>
                    <fieldType>DisplayText</fieldType>
                </fields>
                <inputParameters>
                    <name>width</name>
                    <value>
                        <stringValue>6</stringValue>
                    </value>
                </inputParameters>
                <isRequired>false</isRequired>
            </fields>
            <fields>
                <name>NumberofProductRequestQuestionScreen_Section1_Column2</name>
