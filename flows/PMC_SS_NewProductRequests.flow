<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>This increments current product request number and helps in checking if another product needs to be created.</description>
        <name>NextProductRequestAssignment</name>
        <label>Next Product Request Assignment</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>CurrentNumberofProductRequests</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>nxtProductRequestNumber</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>objFinalProductRequest.PMC_SS_Blend__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>objNewProductRequest.PMC_SS_Blend__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>objFinalProductRequest.PMC_SS_Product__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>objNewProductRequest.PMC_SS_Product__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>objFinalProductRequest.PMC_SS_Case__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>lstProductRequest</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>objFinalProductRequest</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>CreateProductRequestDecision</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>This resets the new product request for the next screen</description>
        <name>ResetNewProductRequestAssignment</name>
        <label>Reset New Product Request Assignment</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>objNewProductRequest.PMC_SS_Product__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>objNewProductRequest.PMC_SS_Blend__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>nullValue</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>CreateProductRequestScreen</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Decision to check how many product requests can be created</description>
        <name>CreateProductRequestDecision</name>
        <label>Create Product Request Decision</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>ProductRequestCreate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CreateProductRequestOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NoOfProductRequests</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>CurrentNumberofProductRequests</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ResetNewProductRequestAssignment</targetReference>
            </connector>
            <label>Create Product Request Outcome</label>
        </rules>
    </decisions>
    <description>This is a screen flow which helps in creating multiple product requests</description>
    <environments>Default</environments>
    <formulas>
        <description>This is the increment of the current product request number</description>
        <name>nxtProductRequestNumber</name>
        <dataType>Number</dataType>
        <expression>{!CurrentNumberofProductRequests} + 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>New Product Requests {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Product Requests</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <description>Create Error Log record in case of Flow errors</description>
        <name>ErrorLogCreate</name>
        <label>Error Log Create</label>
        <locationX>578</locationX>
        <locationY>458</locationY>
        <inputAssignments>
            <field>PMC_FlowName__c</field>
            <value>
                <stringValue>PMC_SS_NewProductRequests</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Message__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Type__c</field>
            <value>
                <stringValue>Flow</stringValue>
            </value>
        </inputAssignments>
        <object>PMC_ErrorLog__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>This component helps in creating the product request</description>
        <name>ProductRequestCreate</name>
        <label>Product Request Create</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <faultConnector>
            <targetReference>ErrorLogCreate</targetReference>
        </faultConnector>
        <inputReference>lstProductRequest</inputReference>
    </recordCreates>
    <screens>
        <description>This screen helps in entering the value to create product request.</description>
        <name>CreateProductRequestScreen</name>
        <label>Create Product Request Screen</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>NextProductRequestAssignment</targetReference>
        </connector>
        <fields>
            <name>dataTableProductRequest</name>
            <dataTypeMappings>
                <typeName>T</typeName>
                <typeValue>PMC_SS_ProductRequest__c</typeValue>
