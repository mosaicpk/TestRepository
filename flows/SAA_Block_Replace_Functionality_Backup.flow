    <decisions>
        <name>Amendment_Opportunity</name>
        <label>Amendment_Opportunity</label>
        <locationX>1260</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Amendment_Quote</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Contract_has_Latest_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contract_Detail.PMC_CPQ_LatestQuote__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Latest_Quote</targetReference>
            </connector>
            <label>Contract has Latest Quote</label>
        </rules>
        <rules>
            <name>If_Amendent_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Amendment_Opportunity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Master_Quote</targetReference>
            </connector>
            <label>If Amendent Opportunity</label>
        </rules>
    </decisions>
