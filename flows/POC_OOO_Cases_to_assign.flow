<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>CaseListAssignment</name>
        <label>Case List Assignment</label>
        <locationX>402</locationX>
        <locationY>1490</locationY>
        <assignmentItems>
            <assignToReference>lstCaseToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>SelectedCasesLoop</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>SelectedCasesLoop</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>it will assign the out of office user to the list</description>
        <name>OutOfOfficeUserAssignment</name>
        <label>Out Of Office User Assignment</label>
        <locationX>402</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>lstOOOUser</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>OutOfOfficeDateLoop.UserId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>OutOfOfficeDateLoop</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>OutOfOfficeUsersAssignment</name>
        <label>Out Of Office Users Assignment</label>
        <locationX>402</locationX>
        <locationY>866</locationY>
        <assignmentItems>
            <assignToReference>lstOOOUser</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Out_Of_Office_Users_Loop.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Out_Of_Office_Users_Loop</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>UpdateOwnerAssignment</name>
        <label>Update Owner Assignment</label>
        <locationX>402</locationX>
        <locationY>1382</locationY>
        <assignmentItems>
            <assignToReference>SelectedCasesLoop.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ChooseNewOwner.selectedChoiceValues</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>CaseListAssignment</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>it will empty the list of users</description>
        <name>UserListBlankValueAssignment</name>
        <label>User List Blank Value Assignment</label>
        <locationX>314</locationX>
        <locationY>650</locationY>
        <assignmentItems>
            <assignToReference>lstOOOUser</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Out_Of_Office_Users_Loop</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>CheckingForNullDecision</name>
        <label>Checking For Null Decision</label>
        <locationX>314</locationX>
        <locationY>1682</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckingForNullDecision_IsNotNullOutComeOutCome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>lstCaseToUpdate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CaseRecordUpdate</targetReference>
            </connector>
            <label>Is Not Null Out Come</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>AvailableUser</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsPortalEnabled</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>User</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>todaydate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>[ POC ] OOO Cases to assign {!$Flow.CurrentDateTime}</interviewLabel>
    <label>[ POC ] OOO Cases to assign</label>
    <loops>
        <name>Out_Of_Office_Users_Loop</name>
        <label>Out Of Office Users Loop</label>
        <locationX>314</locationX>
        <locationY>758</locationY>
        <collectionReference>OutOfOfficeUserGet</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>OutOfOfficeUsersAssignment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>CaseStatusGet</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>OutOfOfficeDateLoop</name>
        <label>Out Of Office Date Loop</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <collectionReference>OutOfOfficeDateGet</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>OutOfOfficeUserAssignment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>OutOfOfficeUserGet</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>SelectedCasesLoop</name>
        <label>Selected Cases Loop</label>
        <locationX>314</locationX>
        <locationY>1274</locationY>
        <collectionReference>oooScreen.selectedRows</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>UpdateOwnerAssignment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>CheckingForNullDecision</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>CaseStatusGet</name>
        <label>Case Status Get</label>
        <locationX>314</locationX>
        <locationY>1058</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>OutOfOfficeUsersCaseScreen</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Error_Meesage</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OwnerId</field>
            <operator>In</operator>
            <value>
                <elementReference>lstOOOUser</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <sortField>OwnerId</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>it will get the start date of out of office</description>
        <name>OutOfOfficeDateGet</name>
        <label>Out Of Office Date Get</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>OutOfOfficeDateLoop</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Error_Meesage</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StartDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>todaydate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OutOfOffice</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>UserId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>it will get the records of out of office users</description>
        <name>OutOfOfficeUserGet</name>
        <label>Out Of Office User Get</label>
        <locationX>314</locationX>
        <locationY>542</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>UserListBlankValueAssignment</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Error_Meesage</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ManagerId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>lstOOOUser</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>CaseRecordUpdate</name>
        <label>Case Record Update</label>
        <locationX>50</locationX>
        <locationY>1790</locationY>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>OutOfOfficeDateGet</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Meesage</targetReference>
        </faultConnector>
        <inputReference>lstCaseToUpdate</inputReference>
    </recordUpdates>
    <screens>
        <name>Error_Meesage</name>
        <label>Error Screen</label>
        <locationX>314</locationX>
        <locationY>1898</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>errordisplay</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;color: rgb(221, 30, 24); font-size: 18px;&quot;&gt;{!$Flow.FaultMessage}&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>OutOfOfficeUsersCaseScreen</name>
        <label>Out Of Office Users Case Screen</label>
        <locationX>314</locationX>
        <locationY>1166</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>SelectedCasesLoop</targetReference>
        </connector>
        <fields>
            <name>dp1</name>
            <fieldText>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong style=&quot;font-size: 14px; color: rgb(0, 0, 0);&quot;&gt;Reassign Case of OOO Agents&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>ChooseNewOwner</name>
            <choiceReferences>AvailableUser</choiceReferences>
            <extensionName>flowruntime:choiceLookup</extensionName>
            <fieldText>Choose New Owner</fieldText>
            <fieldType>ComponentChoice</fieldType>
            <inputParameters>
                <name>placeholder</name>
                <value>
                    <stringValue>Select User</stringValue>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <fields>
            <name>oooScreen</name>
