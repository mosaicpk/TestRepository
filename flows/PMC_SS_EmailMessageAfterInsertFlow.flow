<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Update recipents with sender and web email address</description>
        <name>UpdateRecipientsWithSenderAndWebEmailAddressAssignment</name>
        <label>Update Recipients With Sender And Web Email Address Assignment</label>
        <locationX>314</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>lstRecipientEmailAddress</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.FromAddress</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>lstRecipientEmailAddress</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Parent.SuppliedEmail</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>SendEmailToCustomerSubflow</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Update Recipient With Sender Email Address</description>
        <name>UpdateRecipientWithSenderEmailAddressAssignment</name>
        <label>Update Recipient With Sender Email Address Assignment</label>
        <locationX>578</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>lstRecipientEmailAddress</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.FromAddress</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>SendEmailToCustomerSubflow</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Check Case Status</description>
        <name>CheckCaseStatusDecision</name>
        <label>Check Case Status Decision</label>
        <locationX>446</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckCaseStatus_StatusClosedOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closure Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CaseStatusUpdate</targetReference>
            </connector>
            <label>Status Closed Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if sender email and web email are same</description>
        <name>CheckSenderEmailAddressDecision</name>
        <label>Check Sender Email Address Decision</label>
        <locationX>446</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>UpdateRecipientWithSenderEmailAddressAssignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckSenderEmailAddressDecision_SenderEmailAndWebEmailAreNotSameOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FromAddress</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Parent.SuppliedEmail</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateRecipientsWithSenderAndWebEmailAddressAssignment</targetReference>
            </connector>
            <label>Sender Email And Web Email Are Not Same Outcome</label>
        </rules>
    </decisions>
    <description>Re-Open Case after recieving email for closed case</description>
    <environments>Default</environments>
    <formulas>
        <description>Formula to store customer name</description>
        <name>strCustomerNameFormula</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.FromAddress} &lt;&gt; {!$Record.Parent.SuppliedEmail}, {!$Record.FromName}, {!$Record.Parent.SuppliedName})</expression>
    </formulas>
    <interviewLabel>PMC SS Email Message After Insert Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Email Message After Insert Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>CaseStatusUpdate</name>
        <label>Case Status Update</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <faultConnector>
            <targetReference>CheckSenderEmailAddressDecision</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PMC_SS_ReOpenReason__c</field>
            <value>
                <stringValue>Resolution Not Accurate</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Re-Open</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>320</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CheckCaseStatusDecision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Incoming</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ParentId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>EmailMessage</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Send email to customer</description>
        <name>SendEmailToCustomerSubflow</name>
        <label>Send Email To Customer Subflow</label>
        <locationX>446</locationX>
        <locationY>839</locationY>
        <flowName>PMC_SS_CustomEmailSubflow</flowName>
        <inputAssignments>
            <name>lstRecipientEmailAddress</name>
            <value>
                <elementReference>lstRecipientEmailAddress</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strEmailBody</name>
            <value>
                <elementReference>EmailBodyTextTemplate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strEmailSubject</name>
            <value>
                <elementReference>EmailSubjectTextTemplate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>strSenderEmailAddress</name>
            <value>
                <elementReference>strSenderEmailAddress</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <textTemplates>
        <description>Store email body</description>
        <name>EmailBodyTextTemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Arial, Helvetica, sans-serif; font-size: 11.36px; background-color: rgb(255, 255, 255);&quot;&gt;Dear {!strCustomerNameFormula},&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Arial, Helvetica, sans-serif; font-size: 11.36px; background-color: rgb(255, 255, 255);&quot;&gt;Thank you for submitting your inquiry. This Case cannot be re-opened. To file a new Case, submit your issue to&amp;nbsp;&lt;/span&gt;&lt;a href=&quot;mailto:customer.service@mosaicco.com.&quot;  rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;color: rgb(0, 0, 0); font-family: Arial, Helvetica, sans-serif; font-size: 11.36px;&quot;&gt;customer.service@mosaicco.com.&lt;/a&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Arial, Helvetica, sans-serif; font-size: 11.36px; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;We do our best to reply quickly and appreciate your patience.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Arial, Helvetica, sans-serif; font-size: 11.36px; background-color: rgb(255, 255, 255);&quot;&gt;Best Regards,&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Arial, Helvetica, sans-serif; font-size: 11.36px; background-color: rgb(255, 255, 255);&quot;&gt;Mosaic Customer Care&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;img src=&quot;https://globaldigitalacceleration--devp1.sandbox.file.force.com/servlet/servlet.ImageServer?id=015DT000001GuZ5&amp;oid=00DDT000000Bzj5&quot; &gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Store email subject</description>
        <name>EmailSubjectTextTemplate</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Mosaic Case {!$Record.Parent.CaseNumber} Rejected: {!$Record.Parent.Subject}</text>
    </textTemplates>
    <variables>
        <name>lstRecipientEmailAddress</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>strSenderEmailAddress</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <elementReference>$Label.PMC_SS_EmailToCase_SenderEmailAddress</elementReference>
        </value>
    </variables>
</Flow>
