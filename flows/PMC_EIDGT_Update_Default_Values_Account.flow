    <description>Version 26 including fieldvalue assingment for Account Status = Pending, in order to block Customer Account to be used by CPQ Quote Process</description>
    <environments>Default</environments>
    <formulas>
        <description>Store if Account is new Account</description>
        <name>boolIsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>PMC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC MD Update Default Values Account Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
