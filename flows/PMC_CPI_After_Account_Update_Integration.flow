    <decisions>
        <name>PMC_Account_is_new</name>
        <label>Check Account is new</label>
        <locationX>710</locationX>
        <locationY>1031</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_SAPCustomerNumber__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Account_Group_Check</targetReference>
            </connector>
            <label>New Account</label>
        </rules>
        <rules>
            <name>Updated_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_SAPCustomerNumber__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateAccount_Account_Group_Check</targetReference>
            </connector>
            <label>Updated Account</label>
        </rules>
