<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>This is used to update the List Price from the custom field.</description>
        <name>PMC_CPQ_UpdateListPrice</name>
        <label>Update List Price</label>
        <locationX>922</locationX>
        <locationY>164</locationY>
        <assignmentItems>
            <assignToReference>$Record.ListPrice</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.PMC_CPQ_ListPrice__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Created as part of 066 integration where List Price cannot be updated in subsequent updates in Order Line, so this flow takes the value from the custom list price field and populate to the std field</description>
    <environments>Default</environments>
    <interviewLabel>Update List Price During Creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update List Price During Creation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>330</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>PMC_CPQ_UpdateListPrice</targetReference>
        </connector>
        <object>OrderItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>ListPrice</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>6</scale>
    </variables>
</Flow>
