    <decisions>
        <name>AccountContactDecision</name>
        <label>Account/Contact Decision</label>
        <locationX>644</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>NASADecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AccountContactDecision_AccountOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RecordId.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RecordId.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Account_Get</targetReference>
            </connector>
            <label>Account Outcome</label>
        </rules>
        <rules>
            <name>AccountContactDecision_ContactOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RecordId.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RecordId.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ContactGet</targetReference>
            </connector>
            <label>Contact Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>NASAAccountDecision</name>
        <label>NA/SA Account Decision</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>AccountSAAssignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>SA Outcome</defaultConnectorLabel>
        <rules>
            <name>NASAAccountDecision_NAAccount</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Account_Get.Owner.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Canada</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Account_Get.Owner.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>North America</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Account_Get.Owner.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>United States</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AccountNAAssignment</targetReference>
            </connector>
            <label>NA Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>NASAContactDecision</name>
        <label>NA/SA Contact Decision</label>
        <locationX>710</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>ContactSAAssignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>SA Outcome</defaultConnectorLabel>
        <rules>
            <name>NASAContactDecision_NAContact</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Account_Get.Owner.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Canada</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Account_Get.Owner.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>North America</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Account_Get.Owner.Country</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>United States</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ContactNAAssignment</targetReference>
            </connector>
            <label>NA Contact</label>
        </rules>
    </decisions>
    <decisions>
        <name>NASADecision</name>
        <label>NA/SA Decision</label>
        <locationX>644</locationX>
        <locationY>734</locationY>
        <defaultConnector>
            <targetReference>SAQueueGet</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>SA Queue</defaultConnectorLabel>
        <rules>
            <name>NASADecision_NAQueue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PMC_SS_NAOrSAResult</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>NAQueueGet</targetReference>
            </connector>
            <label>NA Queue</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>strNotificationBody</name>
        <dataType>String</dataType>
        <expression>{!RecordId.Subject} + &apos;is approved by GTM team and is now ready for MDM Team.&apos;</expression>
    </formulas>
    <formulas>
        <name>strNotificationTitle</name>
        <dataType>String</dataType>
        <expression>{!RecordId.Subject} + &apos; is ready for MDM&apos;</expression>
    </formulas>
    <interviewLabel>PMC SS Route Case To MDM Queue {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Route Case To MDM Queue Subflow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Account_Get</name>
        <label>Account Get</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>NASAAccountDecision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>RecordId.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>ContactGet</name>
