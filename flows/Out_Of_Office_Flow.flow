    <decisions>
        <name>check_man_active</name>
        <label>check man active</label>
        <locationX>314</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>show_error_dec</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>active_user</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>manager_get.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>out_of_offie</targetReference>
            </connector>
            <label>active user</label>
        </rules>
    </decisions>
