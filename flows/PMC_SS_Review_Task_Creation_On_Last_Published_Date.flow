<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Convert_Published_Datetime_To_Date</name>
        <label>Convert Published Datetime To Date</label>
        <locationX>1119</locationX>
        <locationY>64</locationY>
        <assignmentItems>
            <assignToReference>TempDateTime</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PMC_SS_Loop_Knowledge_Articles.LastPublishedDate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Published_Date</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>PMC_SS_Add_Task_to_Task_List</name>
        <label>PMC SS Add Task to Task List</label>
        <locationX>1072</locationX>
        <locationY>506</locationY>
        <assignmentItems>
            <assignToReference>PMCSSTasksList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>TaskRec</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>PMC_SS_Loop_Knowledge_Articles</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>PMC_SS_Create_Task_Record</name>
        <label>PMC SS Create Task Record</label>
        <locationX>1466</locationX>
        <locationY>406</locationY>
        <assignmentItems>
            <assignToReference>TaskRec.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PMC_SS_Loop_Knowledge_Articles.LastModifiedById</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TaskRec.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>{!PMC_SS_Loop_Knowledge_Articles.Title} Article Review Task</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TaskRec.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TaskRec.ActivityDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>DueDateasToday</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>PMC_SS_Add_Task_to_Task_List</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Published_Date</name>
        <label>Check Published Date</label>
        <locationX>937</locationX>
        <locationY>227</locationY>
        <defaultConnector>
            <targetReference>PMC_SS_Loop_Knowledge_Articles</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Published_Date_As_Today</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ConvertToDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>PMCSSTodaysDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PMC_SS_Create_Task_Record</targetReference>
            </connector>
            <label>Published Date As Today</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ConvertToDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!TempDateTime})</expression>
    </formulas>
    <formulas>
        <name>DueDateasToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>PMCSSTodaysDate</name>
        <dataType>Date</dataType>
        <expression> IF(MONTH(TODAY())=2 &amp;&amp; DAY(TODAY())=29,
        DATE(YEAR(TODAY())-1, 2, 28),
        DATE(YEAR(TODAY())-1, MONTH(TODAY()), DAY(TODAY())) 
     )</expression>
    </formulas>
    <interviewLabel>PMC SS Review Task Creation On Last Published Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Review Task Creation On Last Published Date</label>
    <loops>
        <name>PMC_SS_Loop_Knowledge_Articles</name>
        <label>PMC SS Loop Knowledge Articles</label>
        <locationX>847</locationX>
        <locationY>309</locationY>
        <collectionReference>PMC_SS_Get_Knowledge_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Convert_Published_Datetime_To_Date</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>PMC_SS_Create_Task_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>PMC_SS_Create_Task_Records</name>
        <label>PMC SS Create Task Records</label>
        <locationX>860</locationX>
        <locationY>732</locationY>
        <inputReference>PMCSSTasksList</inputReference>
    </recordCreates>
    <recordLookups>
        <name>PMC_SS_Get_Knowledge_Records</name>
        <label>PMC SS Get Knowledge Records</label>
        <locationX>553</locationX>
        <locationY>198</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>PMC_SS_Loop_Knowledge_Articles</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PublishStatus</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Online</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Knowledge__kav</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>646</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>PMC_SS_Get_Knowledge_Records</targetReference>
        </connector>
        <object>Knowledge__kav</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2023-07-13</startDate>
            <startTime>04:30:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>PMCSSListtoInsertTasks</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <variables>
        <name>PMCSSTasksList</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <variables>
        <name>TaskRec</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <variables>
        <name>TaskRecTemp</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <variables>
        <name>TempDateTime</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
