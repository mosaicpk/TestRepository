<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>AddQuoteLineToCollection</name>
        <label>Add QuoteLine to Collection</label>
        <locationX>138</locationX>
        <locationY>971</locationY>
        <assignmentItems>
            <assignToReference>QuoteLineCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>QuoteLineSingleRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IterateonQuoteLine</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>LastPriceDateAssignment</name>
        <label>Last Price Date Assignment</label>
        <locationX>138</locationX>
        <locationY>863</locationY>
        <assignmentItems>
            <assignToReference>QuoteLineSingleRecord.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IterateonQuoteLine.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>QuoteLineSingleRecord.PMC_CPQ_LastPricedDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.PMC_CPQ_LastPricedDate__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>QuoteLineSingleRecord.PMC_CPQ_FlowVRBypassToggle__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>BypassVRToggle</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>AddQuoteLineToCollection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>ApprovalStatusCheck</name>
        <label>Approval Status Check</label>
        <locationX>446</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SubmitterforApprovalOutcome</name>
            <conditionLogic>(1 AND (2 OR 3)) OR ( 4 AND(2 OR 3)) OR ( 5 AND (2 OR 3))</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Recalled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetRelatedQuoteLines</targetReference>
            </connector>
            <label>Submitter for Approval Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>CheckQuoteRegionDecision</name>
        <label>Check Quote Region Decision</label>
        <locationX>776</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckQuoteRegionDecision_BrazilOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_CPQ_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Brazil</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ApprovalStatusCheck</targetReference>
            </connector>
            <label>Brazil Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>Config_Setting_decision</name>
        <label>Config Setting decision</label>
        <locationX>237</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>CheckQuoteRegionDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>DontRunOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.PMC_ProcessSwitches__c.PMC_BypassFlow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Don&apos;t Run Outcome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>BypassVRToggle</name>
        <dataType>Boolean</dataType>
        <expression>IF({!IterateonQuoteLine.PMC_CPQ_FlowVRBypassToggle__c}, false, true)</expression>
    </formulas>
    <interviewLabel>PMC_CPQ_QuoteLineUpdateOnApprovalSubmission {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC_CPQ_QuoteLineUpdateOnApprovalSubmission</label>
    <loops>
        <name>IterateonQuoteLine</name>
        <label>Iterate on Quote Line</label>
        <locationX>50</locationX>
        <locationY>755</locationY>
        <collectionReference>GetRelatedQuoteLines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>LastPriceDateAssignment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>UpdateLastPricedDateonQuoteLine</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
