        <queriedFields>PMC_CPQ_LastPricedDate__c</queriedFields>
        <queriedFields>PMC_CPQ_FlowVRBypassToggle__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>UpdateLastPricedDateonQuoteLine</name>
        <label>Update Last Priced Date on QuoteLine</label>
        <locationX>50</locationX>
        <locationY>1163</locationY>
