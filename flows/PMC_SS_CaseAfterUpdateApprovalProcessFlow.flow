    <decisions>
        <description>Decision to check if Case is to be submitted for approval, auto approval or does not need approval.</description>
        <name>SubmitForApprovalDecision</name>
        <label>Submit For Approval Decision</label>
        <locationX>3350</locationX>
        <locationY>839</locationY>
        <defaultConnector>
            <targetReference>CaseApprovalStatusDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Approval Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckCreditActionPerformedByQualityDecision_SubmitForApprovalOutcome</name>
            <conditionLogic>(1 AND 2 AND 3) OR (1 AND 4 AND 5) OR (1 AND 6 AND 7) OR (1 AND 8 AND 9 AND 12) OR (1 AND 10 AND 11)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancel</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ActionReason__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cancel</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rebill</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ActionReason__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Rebill</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Credit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ActionReason__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Credit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Debit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ActionReason__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Debit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Return</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ActionReason__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Return</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Label.PMC_SS_ServiceRoleSA_Names</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Owner:User.UserRole.Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AutoApprovalDecision</targetReference>
            </connector>
            <label>Submit For Approval Outcome</label>
        </rules>
    </decisions>
    <description>Flow to be called when Case is submitted for approval.</description>
    <environments>Default</environments>
    <formulas>
        <description>Approval Notification Title</description>
        <name>strCaseApprovalNotificationTitleFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; has been Approved.&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification body for when case is auto approved.</description>
        <name>strCaseAutoApprovalNotificationBody</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; has been Auto Approved.&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification body for when Case has gone through final level of approval</description>
        <name>strCaseFinalApprovalNotificationBodyFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; has gone through Final level of approval by &apos; + {!strApproverQueue} + &apos; .&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification body for when Case has gone though First level of approval.</description>
        <name>strCaseFLApprovalNotificationBodyFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos;  has gone through First Level of approval by &apos; + {!strApproverQueue} + &apos; .&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification body for when Case has been rejected.</description>
        <name>strCaseRejectionNotificationBodyFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case [&apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; ] has been Rejected.&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification title for when Case has been rejected.</description>
        <name>strCaseRejectionNotificationTitleFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; has been Rejected.&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification body for when Case has gone though Second level of approval.</description>
        <name>strCaseSLApprovalNotificationBodyFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; has gone through Second level of approval by &apos; + {!strApproverQueue} + &apos; .&apos;</expression>
    </formulas>
    <interviewLabel>PMC SS Case After Update Approval Process Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Case After Update Approval Process Flow</label>
    <loops>
        <description>Loop to collect Ids of all Case Team Members</description>
        <name>CaseTeamMembersLoop</name>
        <label>Case Team Members Loop</label>
        <locationX>3350</locationX>
        <locationY>431</locationY>
        <collectionReference>CaseTeamMembersGet</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>CaseTeamMemberAssignment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>AddCaseOwnerToNotificationRecipientsAssignment</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>To get all Case Team Members for the updated Case</description>
        <name>CaseTeamMembersGet</name>
        <label>Case Team Members Get</label>
        <locationX>3350</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>CaseTeamMembersLoop</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>CaseTeamMember</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>3224</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CaseTeamMembersGet</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>PMC_SS_ActionReason__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PMC_SS_ApprovalStatus__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
