    <constants>
        <description>Name of Approval Process to which Case is to be submitted</description>
        <name>PMC_SS_CaseApprovalProcess</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_CaseApprovalv3</stringValue>
        </value>
    </constants>
    <constants>
        <description>To store Case MOT Approval process name</description>
        <name>PMC_SS_CaseMOTApprovalProcess</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_CaseMOTApprovalv2</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Decision to check which Approval process the case should be submitted to for approval.</description>
        <name>ApprovalProcessDecision</name>
        <label>Approval Process Decision</label>
        <locationX>3251</locationX>
        <locationY>1055</locationY>
        <defaultConnector>
            <targetReference>PMC_SubmitCaseforApproval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No MOT Approval Outcome</defaultConnectorLabel>
        <rules>
            <name>ApprovalProcessDecision_MOTApprovalOutcome</name>
            <conditionLogic>1 AND 2 AND (3 OR 4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_RouteToQuality__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_MOT__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_AtFaultParty__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Carrier</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_AtFaultParty__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Supply Planning</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_AtFaultParty__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Logistics Planning</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SubmitCaseforMOTApproval</targetReference>
            </connector>
            <label>MOT Approval Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>To decide whether case is to be auto approved</description>
        <name>AutoApprovalDecision</name>
        <label>Auto Approval Decision</label>
        <locationX>3053</locationX>
        <locationY>947</locationY>
        <defaultConnector>
            <targetReference>ApprovalProcessDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Auto Approval Outcome</defaultConnectorLabel>
        <rules>
            <name>AutoApprovalDecision_AutoApprovalOutcome</name>
            <conditionLogic>((5 OR 6) AND 1 AND 4) OR ((7 OR 8) AND 2 AND 4) OR (9 AND 3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_InvoiceDifference__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_CreditDebitAmount__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ReturnAmount__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_OriginalInvoiceAmount__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1000000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancel</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rebill</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Credit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Debit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Return</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendAutoApprovalNotification</targetReference>
            </connector>
            <label>Auto Approval Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>Decision to check the level of approval the triggering case has gone through</description>
        <name>CaseApprovalStatusDecision</name>
        <label>Case Approval Status Decision</label>
        <locationX>3350</locationX>
        <locationY>1523</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CaseApprovalStatusDecision_FirstLevelApprovalOutcome</name>
            <conditionLogic>(4 AND 1 AND 2) OR (5 AND 3 AND 1 AND 2)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Level 1 Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Level 1 Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_OriginalInvoiceAmount__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1000000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_OriginalInvoiceAmount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1000000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_CreditDebitAmount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>50000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CheckApproverFirstLevelDecision</targetReference>
            </connector>
            <label>First Level Approval Outcome</label>
        </rules>
        <rules>
            <name>CaseApprovalStatusDecision_SecondLevelApprovalOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Level 2 Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Level 2 Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_CreditDebitAmount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>50000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_OriginalInvoiceAmount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1000000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Level2QualityLeadershipAssignment</targetReference>
            </connector>
            <label>Second Level Approval Outcome</label>
        </rules>
        <rules>
            <name>CaseApprovalStatusDecision_FinalApprovalOutcome</name>
            <conditionLogic>(5 AND 4 AND 7 AND 8) OR (5 AND 3 AND 1 AND 2) OR (6 AND 4 AND 1 AND 2) OR (6 AND 3 AND 1 AND 2) OR (4 AND 1 AND 2) OR (6 AND 4 AND 9 AND 10)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Final Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Final Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_OriginalInvoiceAmount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1000000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_OriginalInvoiceAmount__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1000000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_CreditDebitAmount__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_CreditDebitAmount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>50000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Level 1 Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
