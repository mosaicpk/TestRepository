        </connector>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>PMC_SS_Check_Contact_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PMC_SS_NumberOfInactivityDays__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>365.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>PMC_SS_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>To be Archived</stringValue>
            </value>
        </filters>
        <object>Contact</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2023-05-03</startDate>
            <startTime>07:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
