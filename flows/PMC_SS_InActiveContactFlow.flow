    </actionCalls>
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Copy_1_of_isUpdateRecord_Assignment</name>
        <label>isUpdateRecord Assignment</label>
        <locationX>314</locationX>
        <locationY>516</locationY>
        <assignmentItems>
            <assignToReference>PMC_SS_isUpdaterecord</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PMC_SS_PushNotification</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Contact is set to archived state as we are not seeing any interaction for this contact. Please review and take appropriate action for this</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Record_And_Send_Notification</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>CustomNotificationStatus</name>
        <label>customNotification</label>
        <locationX>182</locationX>
        <locationY>972</locationY>
        <assignmentItems>
            <assignToReference>RecipientsId</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>customNotificationStatusChange</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>PMC_SS_isUpdateRecordAssignment</name>
        <label>isUpdateRecord Assignment</label>
        <locationX>50</locationX>
        <locationY>516</locationY>
        <assignmentItems>
            <assignToReference>PMC_SS_isUpdaterecord</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PMC_SS_PushNotification</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Your contact is inactive for more than 1 year. Please review and take appropriate action</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Record_And_Send_Notification</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>PMC_SS_Update_To_Be_Archived</name>
        <label>Update To Be Archived</label>
        <locationX>314</locationX>
        <locationY>396</locationY>
        <assignmentItems>
            <assignToReference>$Record.PMC_SS_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>To be Archived</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Copy_1_of_isUpdateRecord_Assignment</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Inactive</name>
        <label>Update Inactive</label>
        <locationX>50</locationX>
        <locationY>396</locationY>
        <assignmentItems>
            <assignToReference>$Record.PMC_SS_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Inactive</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>PMC_SS_isUpdateRecordAssignment</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>PMC_SS_Check_Contact_Status</name>
        <label>Check Contact Status</label>
        <locationX>314</locationX>
        <locationY>276</locationY>
        <defaultConnector>
            <targetReference>Update_Record_And_Send_Notification</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Active_Contact</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Update_Inactive</targetReference>
            </connector>
            <label>Active Contact</label>
        </rules>
        <rules>
            <name>PMC_SS_Inactive_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inactive</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_NumberOfInactivityDays__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>730.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PMC_SS_Update_To_Be_Archived</targetReference>
            </connector>
            <label>Inactive Contact</label>
        </rules>
    </decisions>
    <decisions>
        <name>Update_Record_And_Send_Notification</name>
        <label>Update Record And Send Notification</label>
        <locationX>314</locationX>
        <locationY>732</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isupdate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PMC_SS_isUpdaterecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PMC_SS_Update_Status</targetReference>
            </connector>
            <label>isupdate</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>customNotification</name>
        <dataType>String</dataType>
        <expression>&apos;Contact status has been changed to &apos;  + TEXT({!$Record.PMC_SS_Status__c})</expression>
    </formulas>
    <formulas>
        <name>PMC_SS_NoInactivityDays</name>
        <dataType>Number</dataType>
        <expression>VALUE({!$Label.PMC_NumberOfInactivityDaysOfContact})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>status</name>
        <dataType>String</dataType>
        <expression>&apos;Your Contact is inactive for more than a year. Plase review your contact.&apos;</expression>
    </formulas>
    <interviewLabel>InActive Contact Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>InActive Contact Flow</label>
    <processMetadataValues>
