                </rightValue>
            </conditions>
            <connector>
                <targetReference>Export_Delivery_Tolerance</targetReference>
            </connector>
            <label>Export</label>
        </rules>
    </decisions>
    <decisions>
        <description>Identify Region by Customer Account country code</description>
        <name>Region_Decision</name>
        <label>Region Decision</label>
        <locationX>534</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SAM_Default_Values</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>GetShiptoAccount.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetShiptoAccount.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PY</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Country_Default_Values</targetReference>
            </connector>
            <label>SAM</label>
        </rules>
        <rules>
            <name>NAM_Default_Values</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>GetShiptoAccount.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>US</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetShiptoAccount.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetShiptoAccount.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PE</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>NA_Default_Values</targetReference>
            </connector>
            <label>NAM</label>
        </rules>
    </decisions>
    <description>Creates an Sales Area Extention for a specified account record.</description>
    <dynamicChoiceSets>
        <name>Division_Picklist_Values</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>PMC_Division__c</picklistField>
        <picklistObject>PMC_AccountSalesArea__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>Sales_Org_Picklist_Values</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>PMC_SalesOrganization__c</picklistField>
        <picklistObject>PMC_AccountSalesArea__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <description>Formats the name of the account returned by GetAccount for use as a default Slack channel name.</description>
        <name>DefaultSalesAreaName</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(LOWER({!GetShiptoAccount.Name}),&quot; &quot;,&quot;_&quot;) &amp; &quot;_&quot; &amp;  {!Sales_Organization} &amp;  &quot;_&quot; &amp;  {!Division} &amp;  &quot;_&quot; &amp;  {!DistributionChannel}</expression>
    </formulas>
    <interviewLabel>$Label.CreateSlackChannelForAccount.FlowLabel {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC Create Account Sales Area Extention</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <description>Creates a Customer Sales Area record associated with the account returned in GetAccount. The Customer Sales Area record name is the same as the associated account record name.</description>
        <name>Create_Customer_Sales_Area_Extension</name>
        <label>Create Customer Sales Area Extension</label>
        <locationX>534</locationX>
        <locationY>950</locationY>
        <connector>
            <targetReference>DisplaySuccessMessage</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PMC_SalesOrganization__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Sales_Organization</elementReference>
            </value>
        </filters>
        <filters>
            <field>PMC_DG_Account_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>PMC_Division__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Division</elementReference>
            </value>
        </filters>
        <filters>
            <field>PMC_DistributionChannel__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>DistributionChannel</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CurrencyIsoCode</field>
            <value>
                <elementReference>GetShiptoAccount.CurrencyIsoCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>DefaultSalesAreaName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_APARToleranceGroup__c</field>
            <value>
                <elementReference>APARToleranceGroup</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_AccountAssignmentGroup__c</field>
            <value>
                <elementReference>CustomerAccountAssignmentGroup</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_CashPlanningGroup__c</field>
            <value>
                <elementReference>CashPlanningGroup</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_CustomerPricingProcedure__c</field>
            <value>
                <elementReference>CustomerPricingProcedure</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_CustomerTaxClassification__c</field>
            <value>
                <elementReference>CustomerTaxClassification</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_DG_Account_Name__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_DistributionChannel__c</field>
            <value>
                <elementReference>DistributionChannel</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_Division__c</field>
            <value>
                <elementReference>Division</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_InvoiceDate__c</field>
            <value>
                <elementReference>InvoiceDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_InvoiceListSchedule__c</field>
            <value>
                <elementReference>InvoiceListSchedule</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_LayoutSortingRule__c</field>
            <value>
                <elementReference>LayoutSortingRule</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_OrderCombination__c</field>
            <value>
                <elementReference>OrderCombinationIsAllowed</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_OrderProbability__c</field>
            <value>
                <elementReference>ItemOrderProbabilityInPercent</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_OverdelivTolrtdLmtRatioInPct__c</field>
            <value>
                <elementReference>OverdelivTolrtdLmtRatioInPct</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_ReconciliationAccount__c</field>
            <value>
                <elementReference>ReconciliationAccount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_RecordPaymentHistoryIndicator__c</field>
            <value>
                <elementReference>RecordPaymentHistoryIndicator</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_SalesOrganization__c</field>
            <value>
                <elementReference>Sales_Organization</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_ShippingCondition__c</field>
            <value>
                <elementReference>GetShiptoAccount.PMC_SS_ShippingCondition__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_SoldToAccount__c</field>
            <value>
                <elementReference>SoldToComponent.recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PMC_UnderdelivTolrtdLmtRatioInPct__c</field>
            <value>
                <elementReference>UnderdelivTolrtdLmtRatioInPct</elementReference>
            </value>
        </inputAssignments>
        <object>PMC_AccountSalesArea__c</object>
        <operationMultMatchingRecords>None</operationMultMatchingRecords>
        <operationOneMatchingRecord>None</operationOneMatchingRecord>
        <operationZeroMatchingRecords>AddRecord</operationZeroMatchingRecords>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Gets the account record that&apos;s related to the Sales Area Extension to create. Stores the result in the Account from GetAccount record variable.</description>
        <name>GetShiptoAccount</name>
        <label>Get Ship-to Account</label>
        <locationX>534</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Specify_Sales_Area_Information</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <description>Informs flow user that the Slack channel was created.</description>
        <name>DisplaySuccessMessage</name>
        <label>Display Success Message</label>
        <locationX>534</locationX>
        <locationY>1058</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>SuccessDisplayText</name>
            <fieldText>&lt;p&gt;The Customer Sales Area extention was created.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Allows flow user to specify a name for the new Slack channel and make the channel private.</description>
        <name>Specify_Sales_Area_Information</name>
        <label>Specify Sales Area Information</label>
        <locationX>534</locationX>
        <locationY>242</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Region_Decision</targetReference>
        </connector>
        <fields>
            <name>Sales_Organization</name>
            <choiceReferences>Sales_Org_Picklist_Values</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Sales Organization</fieldText>
            <fieldType>DropdownBox</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Division</name>
            <choiceReferences>Division_Picklist_Values</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Division</fieldText>
            <fieldType>DropdownBox</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>SoldToComponent</name>
            <extensionName>flowruntime:lookup</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>fieldApiName</name>
                <value>
                    <stringValue>PMC_SS_SoldToAccount__c</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>label</name>
                <value>
                    <stringValue>Sold-to Partner</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>objectApiName</name>
                <value>
                    <stringValue>Account</stringValue>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <sourceTemplate>industries_fsc__CreateSlackAccChannel</sourceTemplate>
