    <decisions>
        <name>Division_Delivery_Toleran</name>
        <label>Division Delivery Toleran</label>
        <locationX>578</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Create_Customer_Sales_Area_Extension</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Domestic</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Division</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
