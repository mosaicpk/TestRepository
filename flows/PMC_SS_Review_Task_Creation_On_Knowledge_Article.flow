<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>PMC_SS_Add_Task_to_Task_List</name>
        <label>PMC SS Add Task to Task List</label>
        <locationX>864</locationX>
        <locationY>624</locationY>
        <assignmentItems>
            <assignToReference>PMCSSTasksList</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>TaskRec</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>PMC_SS_Loop_Knowledge_Articles</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>PMC_SS_Create_Task_Record</name>
        <label>PMC SS Create Task Record</label>
        <locationX>1047</locationX>
        <locationY>467</locationY>
        <assignmentItems>
            <assignToReference>TaskRec.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PMC_SS_Loop_Knowledge_Articles.LastModifiedById</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TaskRec.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>{!PMC_SS_Loop_Knowledge_Articles.Title} Article Review Task</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TaskRec.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TaskRec.ActivityDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>WeekAheadDueDate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>PMC_SS_Add_Task_to_Task_List</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>TodaysDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>WeekAheadDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 7</expression>
    </formulas>
    <interviewLabel>PMC SS Review Task Creation On Knowledge Article {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PMC SS Review Task Creation On Knowledge Article</label>
    <loops>
        <name>PMC_SS_Loop_Knowledge_Articles</name>
        <label>PMC SS Loop Knowledge Articles</label>
        <locationX>776</locationX>
        <locationY>408</locationY>
        <collectionReference>PMC_SS_Get_Knowledge_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>PMC_SS_Create_Task_Record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>PMC_SS_Create_Task_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>PMC_SS_Create_Task_Records</name>
        <label>PMC SS Create Task Records</label>
        <locationX>776</locationX>
        <locationY>816</locationY>
        <inputReference>PMCSSTasksList</inputReference>
    </recordCreates>
    <recordLookups>
        <name>PMC_SS_Get_Knowledge_Records</name>
        <label>PMC SS Get Knowledge Records</label>
        <locationX>776</locationX>
        <locationY>300</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>PMC_SS_Loop_Knowledge_Articles</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PublishStatus</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Online</stringValue>
            </value>
        </filters>
        <filters>
            <field>PMC_SS_ReviewDate__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>TodaysDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Knowledge__kav</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>650</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>PMC_SS_Get_Knowledge_Records</targetReference>
        </connector>
        <object>Knowledge__kav</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2023-07-13</startDate>
            <startTime>04:30:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>PMCSSTasksList</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
    <variables>
        <name>TaskRec</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Task</objectType>
    </variables>
</Flow>
