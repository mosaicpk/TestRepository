    <constants>
        <description>Name of Approval Process to which Case is to be submitted</description>
        <name>PMC_SS_CaseApprovalProcess</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_CaseApprovalv5</stringValue>
        </value>
    </constants>
    <constants>
        <description>Name of Approval Process to which SA Case is to be submitted</description>
        <name>PMC_SS_CaseApprovalProcessSAReverse</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_SAReverseShippingCaseApproval</stringValue>
        </value>
    </constants>
    <constants>
        <description>To store Case MOT Approval process name</description>
        <name>PMC_SS_CaseMOTApprovalProcess</name>
        <dataType>String</dataType>
        <value>
            <stringValue>PMC_SS_CaseMOTforApproval</stringValue>
        </value>
    </constants>
    <decisions>
        <description>To check if MOT is populated or not</description>
        <name>ApprovalProcessDecision</name>
        <label>Approval Process Decision</label>
        <locationX>3850</locationX>
        <locationY>1655</locationY>
        <defaultConnector>
            <targetReference>NAOrSAApprovalDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ApprovalProcessDecision_MOTApprovalOutcome</name>
            <conditionLogic>1 AND 2 AND (3 OR 4 OR 5) AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_RouteToQuality__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
