    <decisions>
        <description>Decision to check if Case is to be submitted for approval, auto approval or does not need approval.</description>
        <name>SubmitForApprovalDecision</name>
        <label>Submit For Approval Decision</label>
        <locationX>4032</locationX>
        <locationY>1439</locationY>
        <defaultConnector>
            <targetReference>ContractCancellationApprovalStatusCheckingDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Approval Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckCreditActionPerformedByQualityDecision_SubmitForApprovalOutcome</name>
            <conditionLogic>(1 AND 2 AND 3) OR (1 AND 4 AND 5) OR (1 AND 6 AND 7) OR (1 AND 8 AND 9) OR (1 AND 10 AND 11)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancel</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ActionReason__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cancel</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rebill</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ActionReason__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Rebill</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Credit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ActionReason__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Credit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Return</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ActionReason__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Return</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reverse Shipment</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ActionReason__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Reverse Shipment</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AutoApprovalDecision</targetReference>
            </connector>
            <label>Submit For Approval Outcome</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>Approval Notification Title</description>
        <name>strCaseApprovalNotificationTitleFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; has been Approved.&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification body for when case is auto approved.</description>
        <name>strCaseAutoApprovalNotificationBody</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; has been Auto Approved.&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification body for when Case has gone through final level of approval</description>
        <name>strCaseFinalApprovalNotificationBodyFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; has gone through Final level of approval by &apos; + {!strApproverQueue} + &apos; .&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification body for when Case has gone though First level of approval.</description>
        <name>strCaseFLApprovalNotificationBodyFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos;  has gone through First Level of approval by &apos; + {!strApproverQueue} + &apos; .&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification body for when Case has been rejected.</description>
        <name>strCaseRejectionNotificationBodyFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case [&apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; ] has been Rejected.&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification title for when Case has been rejected.</description>
        <name>strCaseRejectionNotificationTitleFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; has been Rejected.&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification body for when Case has gone though Second level of approval.</description>
        <name>strCaseSLApprovalNotificationBodyFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; has gone through Second level of approval by &apos; + {!strApproverQueue} + &apos; .&apos;</expression>
    </formulas>
    <formulas>
        <description>Notification body for when Case has gone though Third level of approval.</description>
        <name>strCaseTLApprovalNotificationBodyFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; has gone through Third level of approval by &apos; + {!strApproverQueue} + &apos; .&apos;</expression>
    </formulas>
    <formulas>
        <name>strContractCancellationApprovalBodyFormula</name>
        <dataType>String</dataType>
        <expression>&apos;Case &apos; + {!$Record.CaseNumber} + &apos; : &apos; + {!$Record.Subject} + &apos; has gone through Final level of approval by &apos; +{!strApprover}+ &apos; .&apos;</expression>
    </formulas>
