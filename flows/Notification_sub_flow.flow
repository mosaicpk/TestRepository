                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Level1BillingManagerAssignment</targetReference>
            </connector>
            <label>Billing Manager Queue Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>Decision to check the Approver for case&apos;s Second level approval</description>
        <name>CheckApproverSecondLevelDecision</name>
        <label>Check Approver Second Level Decision</label>
        <locationX>2954</locationX>
        <locationY>3023</locationY>
        <defaultConnector>
            <targetReference>NotifySecondLevelApproval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckApproverSecondLevelDecision_QualityLeadershipQueueOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Level 2 Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Level 2 Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_CreditDebitAmount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>50000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_OriginalInvoiceAmount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1000000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>booleanIsNAUser</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Level2QualityLeadershipAssignment</targetReference>
            </connector>
            <label>Quality Leadership Queue Outcome</label>
        </rules>
        <rules>
            <name>CheckApproverSecondLevelDecision_RegionalManagerOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ActionReason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reverse Shipment</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Level 2 Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_RouteToQuality__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>booleanIsSAUser</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Level2RegionalManagerAssignment</targetReference>
            </connector>
            <label>Regional Manager Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>To check if current case owner is a queue or a user</description>
        <name>CheckOwnerUserorQueueDecision</name>
        <label>Check Owner User or Queue Decision</label>
        <locationX>4032</locationX>
        <locationY>839</locationY>
        <defaultConnector>
            <targetReference>CaseOwnerRoleGet</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Owner is User Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckOwnerUserorQueueDecision_OwnerisQueueOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>00G</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FirstCaseTeamMemberUserGet</targetReference>
            </connector>
            <label>Owner is Queue Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>ContractCancellationApprovalStatusCheckingDecision</name>
        <label>Contract Cancellation Approval Status Checking Decision</label>
        <locationX>4032</locationX>
        <locationY>2315</locationY>
        <defaultConnector>
            <targetReference>CaseApprovalStatusDecision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ontractCancellationApprovalStatusChecking_FinalApprovedOutCome</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4 OR 5 OR 6 ) AND 7 AND 8</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ContractCancellation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancellation Due to Customer Death</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ContractCancellation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Commercial Input Error</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ContractCancellation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer Cancellation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ContractCancellation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Insufficient Loading Balance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ContractCancellation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Unapproved Credit Limit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ContractCancellation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Volume Reduction Due to Agronomic Adjustment</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Final Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ApprovalStatus__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ApproverCheckingDecision</targetReference>
            </connector>
            <label>Final Approved OutCome</label>
        </rules>
        <rules>
            <name>MosaicsFailureOutCome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PMC_SS_ContractCancellation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mosaic’s Failure</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MosaicsFailureAssignment</targetReference>
            </connector>
            <label>Mosaic’s Failure OutCome</label>
        </rules>
    </decisions>
