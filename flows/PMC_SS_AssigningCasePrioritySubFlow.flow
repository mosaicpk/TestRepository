<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Account exists but segmentation does not exist the priority would be low.</description>
        <name>AccountExistAssignment</name>
        <label>Account Exist Assignment</label>
        <locationX>4538</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>ObjCase.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Low</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>CasePriorityHighAssignment</name>
        <label>Case Priority High Assignment</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>ObjCase.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>CasePriorityLowAssignment</name>
