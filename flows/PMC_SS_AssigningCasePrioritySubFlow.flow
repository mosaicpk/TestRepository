    <decisions>
        <description>Checks whether if account exists on a case or not</description>
        <name>AccountAndSegmentationCheckDecision</name>
        <label>Account And Segmentation Check Decision</label>
        <locationX>3482</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AccountAndSegmentationCheck_AccountAndSegmentationExistsOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ObjCase.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ObjCase.Account.PMC_SS_Segmentation__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CaseTypeDecision</targetReference>
            </connector>
            <label>Account And Segmentation Exist Outcome</label>
        </rules>
        <rules>
            <name>AccountAndSegmentationCheckDecision_AccountExistsSegmentationNotExistOutcome</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>ObjCase.Account.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ObjCase.Account.PMC_SS_Segmentation__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AccountExistAssignment</targetReference>
            </connector>
            <label>Account Exists Segmentation Not Exist Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <name>CaseTypeDecision</name>
        <label>Case Type Decision</label>
        <locationX>2162</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CaseType_ShippingHighPriorityOutcome</name>
            <conditionLogic>1 AND(2 OR 3 OR 4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>ObjCase.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Shipping</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ObjCase.Account.PMC_SS_Segmentation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Strategic</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ObjCase.Account.PMC_SS_Segmentation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Prime</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ObjCase.Account.PMC_SS_Segmentation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mega Farmers</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ObjCase.Account.PMC_SS_Segmentation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Top Farmers</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CasePriorityHighAssignment</targetReference>
            </connector>
            <label>Shipping High Priority Outcome</label>
        </rules>
