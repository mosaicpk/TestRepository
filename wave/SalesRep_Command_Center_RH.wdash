e_Month','CloseDate_Day')) as 'Cumulative_Amount';\nresult = order result by ('CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day' asc); \n-- result = filter result by 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day' <= date_to_string(now(), \"yyyy-MM-dd\");\ncommit = filter f by 'ForecastCategoryName' in [\"Closed\", \"Commit\"];\ncommit = group commit by ('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day');\ncommit = foreach commit generate 'CloseDate_Year' as 'CloseDate_Year', 'CloseDate_Month' as 'CloseDate_Month', 'CloseDate_Day' as 'CloseDate_Day', sum('Amount') as 'Commit';\ncommit = fill commit by (dateCols=('CloseDate_Year','CloseDate_Month','CloseDate_Day', \"Y-M-D\"));\ncommit = group commit by ('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day'); \ncommit = foreach commit generate 'CloseDate_Year' + \"~~~\" + 'CloseDate_Month' + \"~~~\" + 'CloseDate_Day' as 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day', first('Commit') as 'A', sum(sum('Commit')) over ([..0] partition by all order by ('CloseDate_Year','CloseDate_Month','CloseDate_Day')) as 'Commit';\ncommit = filter commit by 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day' >= date_to_string(now(), \"yyyy-MM-dd\");\nbestcase = filter f by 'ForecastCategoryName' in [\"Closed\", \"Commit\", \"Best Case\"];\nbestcase = group bestcase by ('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day');\nbestcase = foreach bestcase generate 'CloseDate_Year' as 'CloseDate_Year', 'CloseDate_Month' as 'CloseDate_Month', 'CloseDate_Day' as 'CloseDate_Day', sum('Amount') as 'BestCase';\nbestcase = fill bestcase by (dateCols=('CloseDate_Year','CloseDate_Month','CloseDate_Day', \"Y-M-D\"));\nbestcase = group bestcase by ('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day');\nbestcase = foreach bestcase generate 'CloseDate_Year' + \"~~~\" + 'CloseDate_Month' + \"~~~\" + 'CloseDate_Day' as 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day', sum(sum('BestCase')) over ([..0] partition by all order by ('CloseDate_Year',