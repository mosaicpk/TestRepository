{"dataSourceLinksInfo":{"enableAutomaticLinking":true,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[{"maxWidth":1500,"name":"Default","numColumns":50,"pages":[{"label":"Untitled","name":"b5e28baf-d108-4925-9eb4-5b71a609e9ec","navigationHidden":false,"widgets":[{"colspan":50,"column":0,"name":"text_1","row":0,"rowspan":3,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":13,"column":0,"name":"text_2","row":3,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":12,"column":13,"name":"text_3","row":3,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":12,"column":25,"name":"text_4","row":3,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":13,"column":37,"name":"text_5","row":3,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":13,"column":37,"name":"number_4","row":6,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":50,"column":0,"name":"text_6","row":5,"rowspan":1,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":13,"column":0,"name":"number_9","row":6,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":12,"column":13,"name":"number_10","row":6,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":12,"column":25,"name":"number_11","row":6,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":50,"column":0,"name":"text_8","row":8,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#FFFFFF","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"MAPE_KPI_1":{"broadcastFacet":true,"groups":[],"label":"MAPE_KPI","numbers":[],"query":"Forecast = load \"MFG_AccountProductPeriodForecast\";\nForecast = foreach Forecast generate 'Id' as 'Id', 'Period.StartDate' as 'StartDate', 'Period.EndDate' as 'Period.EndDate', sum('ForecastedDailyRevenue') as 'ForecastedDailyRevenue', sum('ForecastedRevenueFinal') as 'ForecastedRevenueFinal';\n\nForecast = foreach Forecast generate 'Id' as 'Id', sum('ForecastedRevenueFinal') as 'ForecastedRevenueFinal', Forecast.'StartDate' as 'StartDate', Forecast.'Period.EndDate' as 'EndDate', sum(Forecast.'ForecastedDailyRevenue') as 'ForecastedDailyRevenue', date_to_string (fiscal_year_first_day(now()), \"yyyy-MM-dd\") as 'CY_StartDate', date_to_string( fiscal_year_last_day(now()), \"yyyy-MM-dd\") as 'CY_EndDate',\ndate_to_string(fiscal_year_first_day(toDate(number_to_string( string_to_number( date_to_string(now(), \"yyyy\"))-1, \"####\")+\"-\"+date_to_string(now(), \"MM\")+\"-01\",\"yyyy-MM-dd\")), \"yyyy-MM-dd\") as 'PY_StartDate',  date_to_string(fiscal_year_last_day(toDate(number_to_string( string_to_number( date_to_string(now(), \"yyyy\"))-1, \"####\")+\"-\"+date_to_string(now(), \"MM\")+\"-01\",\"yyyy-MM-dd\")), \"yyyy-MM-dd\")  as 'PY_EndDate';\nq_Current = filter Forecast by 'EndDate' > 'CY_StartDate' && 'StartDate' < 'CY_EndDate';\nq_Previous = filter Forecast by 'EndDate' > 'PY_StartDate' && 'StartDate' < 'PY_EndDate';\nForecast_result = cogroup Forecast by all full, q_Current by all full, q_Previous by all;\n\nForecast_result = foreach Forecast_result generate  sum(Forecast.'ForecastedRevenueFinal') as 'ForecastedRevenueFinal',  sum(q_Current.ForecastedDailyRevenue) as 'CY_ForecastedDailyRevenue',sum(q_Previous.ForecastedDailyRevenue) as 'PY_ForecastedDailyRevenue',  \nmax(q_Current.'StartDate', q_Current.'CY_StartDate') as 'Required_StartDate',\nmin(q_Current.'EndDate', q_Current.'CY_EndDate') as 'Required_EndDate',\nmax(q_Previous.'StartDate', q_Previous.'PY_StartDate') as 'Required_StartDatePY',\nmin(q_Previous.'EndDate', q_Previous.'PY_EndDate') as 'Required_EndDatePY';\n\nForecast_result = foreach Forecast_result generate date_to_string(toDate('Required_StartDate', \"yyyy-MM-dd\"), \"yyyy\") as 'Year', date_to_string(toDate('Required_StartDate', \"yyyy-MM-dd\"), \"MM\") as 'Month', sum('CY_ForecastedDailyRevenue') as 'CY_ForecastedDailyRevenue', sum('PY_ForecastedDailyRevenue') as 'PY_ForecastedDailyRevenue';\nForecast_result = group Forecast_result by ('Year', 'Month');\nForecast_result = foreach Forecast_result generate 'Year'+\"~~~\"+'Month' as 'StartDate_Year~~~StartDate_Month', 'Year' as 'StartDate_Year', \"01\" as 'StartDate_Day', 'Month' as 'StartDate_Month', sum(Forecast_result.'CY_ForecastedDailyRevenue') as 'CY_ForecastedDailyRevenue', sum(Forecast_result.'PY_ForecastedDailyRevenue') as 'PY_ForecastedDailyRevenue';\nForecast_result = foreach Forecast_result generate 'StartDate_Year' + \"~~~\" + 'StartDate_Month' as 'StartDate_Year~~~StartDate_Month', 'StartDate_Year' as 'StartDate_Year', 'StartDate_Month' as 'StartDate_Month', \"01\" as 'StartDate_Day', sum(Forecast_result.'CY_ForecastedDailyRevenue') as 'CY_ForecastedDailyRevenue', sum(Forecast_result.'PY_ForecastedDailyRevenue') as 'PY_ForecastedDailyRevenue';\nForecast_result = group Forecast_result by 'StartDate_Year~~~StartDate_Month';\nForecast_result = foreach Forecast_result generate 'StartDate_Year~~~StartDate_Month' as 'StartDate_Year~~~StartDate_Month', first('StartDate_Year') as 'StartDate_Year', first('StartDate_Month') as 'StartDate_Month', sum('CY_ForecastedDailyRevenue') as 'ForecastedRevenueFinal', sum('PY_ForecastedDailyRevenue') as 'PY_ForecastedRevenueFinal';\nActual = load \"MFG_OrderProduct\";\nCY_Actual = filter Actual by date('Order.EffectiveDate_Year', 'Order.EffectiveDate_Month', 'Order.EffectiveDate_Day') in [\"current fiscal_year\"..\"current fiscal_year\"];\nPY_Actual = filter Actual by date('Order.EffectiveDate_Year', 'Order.EffectiveDate_Month', 'Order.EffectiveDate_Day') in [\"1 fiscal_year ago\"..\"1 fiscal_year ago\"];\nActual_result = cogroup Actual by all full,CY_Actual by all full, PY_Actual by all;\nActual_result = foreach Actual_result generate first(Actual.'Order.EffectiveDate_Year') + \"~~~\" + first(Actual.'Order.EffectiveDate_Month') as 'StartDate_Year~~~StartDate_Month', sum(CY_Actual.'TotalPrice') as 'Amount', sum(PY_Actual.'TotalPrice') as 'PY_Amount';\nActual_result = order Actual_result by 'StartDate_Year~~~StartDate_Month' asc;\nresult = cogroup Actual_result by 'StartDate_Year~~~StartDate_Month' full, Forecast_result by 'StartDate_Year~~~StartDate_Month';\nresult = foreach result generate coalesce(Forecast_result.'StartDate_Year~~~StartDate_Month', Actual_result.'StartDate_Year~~~StartDate_Month') as 'StartDate_Year~~~StartDate_Month', coalesce(sum(Actual_result.'Amount'),0) as 'Actuals', coalesce(sum(Forecast_result.'ForecastedRevenueFinal'),0) as 'Forecast', coalesce(sum(Actual_result.'PY_Amount'),0) as 'PY_Actuals', coalesce(sum(Forecast_result.'PY_ForecastedRevenueFinal'),0) as 'PY_Forecast';\nresult = foreach result generate 'StartDate_Year~~~StartDate_Month' as 'StartDate_Year~~~StartDate_Month', sum('Actuals') as 'Actuals', sum('Forecast') as 'Forecast',sum('PY_Actuals') as 'PY_Actuals', sum('PY_Forecast') as 'PY_Forecast', (case when sum('Actuals')==0 then null else abs(sum('Actuals')-sum('Forecast'))/sum('Actuals') end) as 'amount_mape', (case when sum('Actuals')==0 then 0 else 1 end) as 'amount_mape_eligibile';\nresult = group result by all;\nresult = foreach result generate sum('amount_mape')*100/sum('amount_mape_eligibile') as 'amount_mape', sum('Actuals') as 'Actuals', sum('Forecast') as 'Forecast',sum('PY_Actuals') as 'PY_Actuals', sum('PY_Forecast') as 'PY_Forecast',(sum(Actuals)-sum(PY_Actuals))/sum(PY_Actuals) as 'Actual_Amount_Per', sum('Actuals')-sum('Forecast') as 'Actual_vs_Forecast';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"bord