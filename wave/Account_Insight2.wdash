Order.EffectiveDate_Month' as 'Order.EffectiveDate_Month', 'Order.EffectiveDate_Day' as 'Order.EffectiveDate_Day', 'TotalPrice' as 'TotalPrice', 'Quantity' as 'Quantity';\n orders = group orders by ('Order.EffectiveDate_Year', 'Order.EffectiveDate_Month');\n order_results = foreach orders generate 'Order.EffectiveDate_Year' + \"~~~\" + 'Order.EffectiveDate_Month' as 'StartDate_Year~~~StartDate_Month', sum('TotalPrice') as 'Amount', sum(sum('TotalPrice')) over ([..0] partition by all order by 'Order.EffectiveDate_Year' + \"~~~\" + 'Order.EffectiveDate_Month' asc) as 'cumm_Amount', sum('Quantity') as 'Quantity', sum(sum('Quantity')) over ([..0] partition by all order by 'Order.EffectiveDate_Year' + \"~~~\" + 'Order.EffectiveDate_Month' asc) as 'cumm_Quantity';\n order_results = order order_results by 'StartDate_Year~~~StartDate_Month' asc;\nopportunities = load \"MFGAAF_OpportunityLineItem3\";\nopportunities = filter opportunities by 'Opportunity.CloseDate_sec_epoch' <= {{coalesce(cell(Date_Filter_1.result, 0, \"Max\"), 0).asObject()}}/1000;\nopportunities = filter opportunities by 'Opportunity.CloseDate_sec_epoch' >= {{coalesce(cell(Date_Filter_1.result, 0, \"Min\"), 0).asObject()}}/1000;\nopportunities = foreach opportunities generate 'Id' as 'Id', 'Opportunity.CloseDate_Year' as 'Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month' as 'Opportunity.CloseDate_Month', 'Opportunity.CloseDate_Day' as 'Opportunity.CloseDate_Day', 'TotalPrice' as 'TotalPrice', 'Quantity' as 'Quantity';\nopportunities = group opportunities by ('Opportunity.CloseDate_Year', 'Opportunity.CloseDate_Month');\n opportunity_results = foreach opportunities generate 'Opportunity.CloseDate_Year' + \"~~~\" + 'Opportunity.CloseDate_Month' as 'StartDate_Year~~~StartDate_Month', sum('TotalPrice') as 'Amount', sum(sum('TotalPrice')) over ([..0] partition by all order by 'Opportunity.CloseDate_Year' + \"~~~\" + 'Opportunity.CloseDate_Month' asc) as 'cumm_Amount', sum('Quantity') as 'Quantity', sum(sum('Quantity')) over ([..0] partition by all order by 'Opportunity.CloseDate_Year' + \"~~~\" + 'Opportunity.CloseDate_Month' asc) as 'cumm_Quantity';\n opportunity_results = order opportunity_results by 'StartDate_Year~~~StartDate_Month' asc;\n \nresult = cogroup order_results by 'StartDate_Year~~~StartDate_Month' full, opportunity_results by 'StartDate_Year~~~StartDate_Month';\n result = foreach result generate coalesce(order_results.'StartDate_Year~~~StartDate_Month', opportunity_results.'StartDate_Year~~~StartDate_Month') as 'StartDate_Year~~~StartDate_Month', coalesce(sum(order_results.'Amount'),0) as 'Actuals', coalesce(sum(order_results.'cumm_Amount'),0) as 'Actuals_Cumulative', coalesce(sum(opportunity_results.'Amount'),0) as 'OpportunityAmount', coalesce(sum(opportunity_results.'cumm_Amount'),0) as 'OpportunityAmount_Cumulative',coalesce(sum(order_results.'Quantity'),0) as 'ActualQuantity', coalesce(sum(opportunity_results.'Quantity'),0) as 'OpportunityQuantity', coalesce(sum(opportunity_results.'cumm_Quantity'),0) as 'OpportunityQuantity_Cumulative';\n result = group result by 'StartDate_Year~~~StartDate_Month';\n result = foreach result generate 'StartDate_Year~~~StartDate_Month' as 'StartDate_Year~~~StartDate_Month', sum('Actuals') as 'ActualAmount', sum('OpportunityAmount') as 'OpportunityAmount', sum(sum('Actuals')) over ([..0] partition by all order by 'StartDate_Year~~~StartDate_Month' asc) as 'ActualAmount_Cumulative', sum(sum('OpportunityAmount')) over ([..0] partition by all order by 'StartDate_Year~~~StartDate_Month' asc) as 'OpportunityAmount_Cumulative', sum('ActualQuantity') as 'ActualQuantity', sum('OpportunityQuantity') as 'OpportunityQuantity',sum(sum('ActualQuantity')) over ([..0] partition by all order by 'StartDate_Year~~~StartDate_Month' asc) as 'ActualQuantity_Cumulative', sum(sum('OpportunityQuantity')) over ([..0] partition by all order by 'StartDate_Year~~~StartDate_Month' asc) as 'OpportunityQuantity_Cumulative';\n result = foreach result generate 'StartDate_Year~~~StartDate_Month' as 'StartDate_Year~~~StartDate_Month', {{column(Qty_vs_Revenue_1.selection, [\"actuals_col\"]).asObject()}} as {{column(Qty_vs_Revenue_1.selection, [\"actuals_col\"]).asObject()}}, {{column(Qty_vs_Revenue_1.selection, [\"opportunity_col\"]).asObject()}} as {{column(Qty_vs_Revenue_1.selection, [\"opportunity_col\"]).asObject()}};\n result = filter result by {{column(Qty_vs_Revenue_1.selection, [\"actuals_col\"]).asObject()}} is not null or {{column(Qty_vs_Revenue_1.selection, [\"opportunity_col\"]).asObject()}} is not null;\n result2 = foreach result generate 'StartDate_Year~~~StartDate_Month' as 'StartDate_Year~~~StartDate_Month', \"Orders\" as 'Amount Type', {{column(Qty_vs_Revenue_1.selection, [\"actuals_col\"]).asObject()}} as '{{cell(Qty_vs_Revenue_1.selection, 0, \"Value\").asString()}}';\n result3 = foreach result generate 'StartDate_Year~~~StartDate_Month' as 'StartDate_Year~~~StartDate_Month', \"Opportunities\" as 'Amount Type', {{column(Qty_vs_Revenue_1.selection, [\"opportunity_col\"]).asObject()}} as '{{cell(Qty_vs_Revenue_1.selection, 0, \"Value\").asString()}}';\n result = union  result2, result3;\nresult = filter result by {{cell(Qty_vs_Revenue_1.selection, 0, \"Value\").asString()}} is not null;\n result = order result by 'StartDate_Year~~~StartDate_Month' asc;","receiveFacetSource":{"mode":"exclude","steps":["Dimension_Filter_Cha_2","Dimension_Filter_Cha_1","Dimension_Filter_Acc_1","Account_Filter_Chart_1","Account_Filter_Chart_2","Product_Filter_Chart_1","Product_Filter_Chart_2"]},"selectMode":"none","start":"[]","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"bottom-center","insi