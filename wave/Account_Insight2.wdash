ct.Family', 'Date_Year', 'Date_Month', date_to_epoch(toDate('Date_Year'+\"-\"+'Date_Month'+\"-01\",\"yyyy-MM-dd\")) as 'Date', first('Start') as 'Start', min(first('Start')) over ([..0] partition by 'Id' order by ('Date_Year','Date_Month')) as 'StartFilter', first('End') as 'End', min(first('End')) over ([..0] partition by 'Id' order by ('Date_Year','Date_Month')) as 'EndFilter',  min(first('Start Date')) over ([..0] partition by 'Id' order by ('Date_Year','Date_Month')) as 'Start Date', max(first('End Date')) over ([..] partition by 'Id' ) as 'End Date', sum('Forecasted Amount') as 'Forecasted Amount', min(first('ForecastedDailyAmount'))over ([..0] partition by 'Id' order by ('Date_Year','Date_Month')) as 'ForecastedDailyAmount', min(first('SalesPrice'))over ([..0] partition by 'Id' order by ('Date_Year','Date_Month')) as 'SalesPrice';\nFilledData_Forecasted = filter FilledData_Forecasted by coalesce('Start',0) != 0 || ('Date' >= 'StartFilter' && 'Date' >= 'Start Date' && 'Date' <= 'End Date' && 'Date' <= 'EndFilter');\nFilledData_Forecasted = foreach FilledData_Forecasted generate 'Id', 'Product.Name' as 'Product.Name', 'Product.Family' as 'Product.Family', 'Date_Year', 'Date_Month', 0 as 'Actual Amount', 'SalesPrice' as 'SalesPrice', (case when 'Forecasted Amount' is null then month_days(toDate('Date'))*'ForecastedDailyAmount' else 'Forecasted Amount' end) as 'Forecasted Amount';\nFilledData = union FilledData_actual, FilledData_Forecasted;\nFilledData = foreach FilledData generate 'Id' as 'Id', 'Date_Year', 'Date_Month', 'Product.Name' as 'Product.Name', 'Product.Family' as 'Product.Family', 'SalesPrice' as 'SalesPrice', 'Actual Amount' as 'Actual Amount', 'Forecasted Amount' as 'Forecasted Amount';\nFilledData = foreach FilledData generate 'Id' as 'Id', 'Date_Year', 'Date_Month', 'Product.Name' as 'Product.Name', 'Product.Family' as 'Product.Family', 'Actual Amount' as 'Actual Amount', 'Actual Amount'/'SalesPrice' as 'ActualQuantity', 'Forecasted Amount' as 'Forecasted Amount', \n'Forecasted Amount'/'SalesPrice' as 'ForecastQuantity';\nFilledData = group FilledData by ('Id','Date_Year', 'Date_Month');\nFilledData = foreach FilledData generate 'Id', 'Date_Year'+\"-\"+'Date_Month' as 'Period', first('Product.Name') as 'Product.Name', first('Product.Family') as 'Product.Family',sum('Actual Amount') as 'ActualAmount', sum('Forecasted Amount') as 'ForecastAmount', sum('ActualQuantity') as 'ActualQuantity', sum('ForecastQuantity') as 'ForecastQuantity';\nresult = group FilledData by ('Product.Name', 'Period', 'Product.Family'); \nresult = foreach result generate coalesce('Product.Name', \"NA\") as 'Product.Name', coalesce('Product.Family', \"NA\") as 'Product.Family', 'Period' as 'Period', coalesce(sum('ForecastAmount'),0) as 'ForecastAmount', coalesce(sum('ForecastQuantity'),0) as 'ForecastQuantity', coalesce(sum('ActualAmount'),0) as 'DerivedActualAmountOrders', coalesce(sum('ActualQuantity'),0) as 'ActualQuantityOrders';\nresult = filter result by 'ForecastAmount' is not null;\nresult = filter result by 'ForecastQuantity' is not null;\nresult = filter result by 'ActualQuantityOrders' is not null; \nresult = filter result by 'DerivedActualAmountOrders' is not null;","receiveFacetSource":{"mode":"exclude","steps":["Dimension_Filter_Cha_2","Dimension_Filter_Cha_1","Dimension_Filter_Acc_1","Account_Filter_Chart_1","Account_Filter_Chart_2","Product_Filter_Chart_1","Product_Filter_Chart_2"]},"selectMode":"none","start":"[]","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12},"columnProperties":{},"columns":["ForecastAmount","ForecastQuantity","DerivedActualAmountOrders","ActualQuantityOrders","Product.Name","Product.Family","Period"],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":