r', 'Date_Quarter');\nresult = foreach result generate 'Date_Year'+\"~~~\"+'Date_Quarter' as 'StartDate_Year~~~StartDate_Quarter', sum('ActualAmount') as 'ActualAmount', sum(sum('ActualAmount')) over ([..0] partition by all order by 'Date_Year'+\"~~~\"+'Date_Quarter' asc) as 'ActualAmount_Cumulative', sum('ForecastAmount') as 'ForecastAmount', sum(sum('ForecastAmount')) over ([..0] partition by all order by 'Date_Year'+\"~~~\"+'Date_Quarter' asc) as 'ForecastAmount_Cumulative', sum('ActualQuantity') as 'ActualQuantity', sum('ForecastQuantity') as 'ForecastQuantity', sum(sum('ActualQuantity')) over ([..0] partition by all order by 'Date_Year'+\"~~~\"+'Date_Quarter' asc) as 'ActualQuantity_Cumulative', sum(sum('ForecastQuantity')) over ([..0] partition by all order by 'Date_Year'+\"~~~\"+'Date_Quarter' asc) as 'ForecastQuantity_Cumulative';\nresult = foreach result generate 'StartDate_Year~~~StartDate_Quarter' as 'ServiceDate_Year~~~ServiceDate_Quarter', {{column(MOM_vs_1.selection, column(Qty_vs_Revenue_1.selection, [\"measure_MoM_Cumulative\"])).asObject()}};\nresult = filter result by {{column(MOM_vs_1.selection, column(Qty_vs_Revenue_1.selection, [\"Actual_Filter\"])).asObject()}} is not null;\nresult = filter result by {{column(MOM_vs_1.selection, column(Qty_vs_Revenue_1.selection, [\"Forecast_Filter\"])).asObject()}} is not null;\nresult = order result by 'ServiceDate_Year~~~ServiceDate_Quarter' asc;","receiveFacetSource":{"mode":"exclude","steps":["Dimension_Filter_Cha_2","Dimension_Filter_Acc_1","Account_Filter_Chart_1","Account_Filter_Chart_2","Product_Filter_Chart_1","Product_Filter_Chart_2"]},"selectMode":"none","start":"[]","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showPoints":true,"legend":{"descOrder":false,"showHeader":false,"show":true,"custom