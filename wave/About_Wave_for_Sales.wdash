comparison_avg_sales_cycle":{"broadcastFacet":true,"datasets":[{"name":"opportunity1"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"sum\",\"percent\"]],\"pigql\":\"q = load \\\"opportunity1\\\"; q = filter q by 'IsClosed' == \\\"true\\\"; q = filter q by 'IsWon' == \\\"true\\\"; a = filter q by date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\\\"current year - 1 year\\\"..\\\"current day - 1 year\\\"]; a = group a by 'Id'; a = foreach a generate max('OpportunityAge') as 'Days_Open'; b = filter q by date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\\\"current year\\\"..\\\"current day\\\"]; b = group b by 'Id'; b = foreach b generate max('OpportunityAge') as 'Days_Open'; c = group a by all full, b by all; c = foreach c generate avg(a.'Days_Open') as 'A', avg(b.'Days_Open') as 'B'; c = foreach c generate (B-A)/A as 'sum_percent', A as 'last_year'; c = foreach c generate (case when 'sum_percent' > 0 then \\\"#E3193B\\\" when 'sum_percent' < 0 then \\\"#067D1E\\\" else \\\"#192B61\\\" end) as 'color', 'sum_percent' as 'sum_percent','last_year' as 'last_year';\",\"groups\":[]}","version":-1.0},"receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","type":"aggregateflex","useGlobal":false,"visualizationParameters":{"options":{},"visualizationType":"hbar"}},"comparison_closed_won":{"broadcastFacet":true,"datasets":[{"name":"opportunity1"}],"isGlobal":false,"label":"","query":{"query":"{\"measures\":[[\"sum\",\"percent\"]],\"pigql\":\"q = load \\\"opportunity1\\\"; q = filter q by 'IsWon' == \\\"true\\\"; this_year = filter q by date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\\\"current year\\\"..\\\"current day\\\"]; last_year = filter q by date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\\\"current year - 1 year\\\"..\\\"current day - 1 year\\\"]; this_year = foreach this_year generate sum('Amount') as 'Amount'; last_year = foreach last_year generate sum('Amount') as 'Amount'; result = group this_year by all full, last_year by all; result = foreach result generate (sum(this_year['Amount']) - sum(last_year['Amount']))/sum(last_year['Amount']) as 'sum_percent', sum(last_year['Amount']) as 'last_year'; result = foreach result generate 'sum_percent','last_year', (case when 'sum_percent' > 0 then \\\"#067D1E\\\" when 'sum_percent' < 0 then \\\"#E3193B\\\" else \\\"#192B61\\\" end) as 'color';\"}","version":-1.0},"receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"single","type":"aggregateflex","useGlobal":true,"visualizationParameters":{"options":{},"visualizationType":"hbar"}},"lens_3":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"q = load \"opportunity1\";\nq = filter q by date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\"3 years ago\"..\"current year\"];\nq = filter q by 'IsWon' == \"true\";\nq = group q by ('CloseDate_Year', 'CloseDate_Month');\nq = foreach q generate ('CloseDate_Year' + \"~~~\") + 'CloseDate_Month' as 'CloseDate_Year~~~CloseDate_Month', avg('Amount') as 'avg_Amount';\nq = order q by 'CloseDate_Year~~~CloseDate_Month' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","start":"[]","strings":[],"type":"saql","useGlobal":true},"lens_1":{"broadcastFacet":true,"groups":[],"label":"lens_1","numbers":[],"query":"q = load \"opportunity1\"; q = filter q by date('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day') in [\"3 years ago\"..\"current year\"]; q = filter q by 'IsWon' == \"true\"; q = group q by ('CloseDate_Year', 'CloseDate_Month'); q = foreach q generate ('CloseDate_Year' + \"~~~\") + 'CloseDate_Month' as 'CloseDate_Year~~~CloseDate_Month', sum(TotalOpportunityQuantity) as 'sum_Amount'; q = order q by 'CloseDate_Year~~~CloseDate_Month' asc; q = limit q 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","start":"[]","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"fit","totalValue":"c