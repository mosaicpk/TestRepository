{"dataSourceLinksInfo":{"enableAutomaticLinking":true,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[{"maxWidth":1800,"name":"Default","numColumns":50,"pages":[{"label":"Untitled","name":"3b45a797-f474-412f-a10e-c6a03d0b6499","navigationHidden":false,"widgets":[{"colspan":9,"column":0,"name":"text_2","row":1,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":10,"column":19,"name":"text_3","row":1,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":10,"column":40,"name":"text_4","row":1,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":10,"column":9,"name":"text_5","row":1,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":11,"column":29,"name":"text_6","row":1,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":9,"column":0,"name":"number_1","row":4,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":19,"column":0,"name":"number_2","row":6,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":10,"column":9,"name":"number_3","row":4,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":10,"column":19,"name":"number_4","row":4,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":11,"column":29,"name":"number_5","row":4,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":10,"column":40,"name":"number_6","row":4,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":21,"column":19,"name":"number_8","row":6,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":10,"column":40,"name":"number_10","row":6,"rowspan":2,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":50,"column":0,"name":"text_1","row":3,"rowspan":1,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":50,"column":0,"name":"text_8","row":8,"rowspan":1,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#FFFFFF","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"KPIs_Final_Q_1":{"broadcastFacet":true,"groups":[],"label":"KPIs_Final_Q","numbers":[],"query":"q = load \"MFG_SalesAgreementProductSchedule\";\nq = filter q by 'isValidProductSchedule' == \"true\";\nq = filter q by !('SalesAgreementProduct.SalesAgreement.StatusCode' in [\"Draft\", \"Rejected\"]);\nq = foreach q generate 'Id', 'DerivedActualAmount' as 'DerivedActualAmount', 'DerivedPlannedAmount' as 'DerivedPlannedAmount', 'PlannedDailyAmount' as 'PlannedDailyAmount', (DerivedActualAmount/PlannedDaysFinal) as 'ActualDailyAmount',\n'StartDate' as 'StartDate', 'ActualEndDate' as 'ActualEndDate', date_to_string( fiscal_year_first_day(now()), \"yyyy-MM-dd\")  as 'CY_StartDate', date_to_string( fiscal_year_last_day(now()), \"yyyy-MM-dd\")  as 'CY_EndDate',\n date_to_string(fiscal_year_first_day(toDate(number_to_string( string_to_number( date_to_string(now(), \"yyyy\"))-1, \"####\")+\"-\"+date_to_string(now(), \"MM\")+\"-01\",\"yyyy-MM-dd\")), \"yyyy-MM-dd\") as 'PY_StartDate',  date_to_string(fiscal_year_last_day(toDate(number_to_string( string_to_number( date_to_string(now(), \"yyyy\"))-1, \"####\")+\"-\"+date_to_string(now(), \"MM\")+\"-01\",\"yyyy-MM-dd\")), \"yyyy-MM-dd\")  as 'PY_EndDate';\nq_Current = filter q by 'ActualEndDate' > 'CY_StartDate' && 'StartDate' < 'CY_EndDate';\nq_Previous = filter q by 'ActualEndDate' > 'PY_StartDate' && 'StartDate' < 'PY_EndDate';\nresult = cogroup q by 'Id' full, q_Current by 'Id' full, q_Previous by 'Id';\nresult = foreach result generate sum(q_Current.'ActualDailyAmount') as 'CY_ActualDailyAmount', sum(q_Previous.'ActualDailyAmount') as 'PY_ActualDailyAmount', sum(q.'DerivedActualAmount') as 'DerivedActualAmount', sum(q.'DerivedPlannedAmount') as 'DerivedPlannedAmount', sum(q_Current.PlannedDailyAmount) as 'CY_PlannedDailyAmount', sum(q_Previous.PlannedDailyAmount) as 'PY_PlannedDailyAmount', \n--calculate the intersection period dates between SA schedule dates & current year dates\nmax(q_Current.'StartDate', q_Current.'CY_StartDate') as 'Required_StartDate',\nmin(q_Current.'ActualEndDate', q_Current.'CY_EndDate') as 'Required_EndDate',\n--calculate the intersection period dates between SA schedule dates & previous year dates\nmax(q_Previous.'StartDate', q_Previous.'PY_StartDate') as 'Required_StartDatePY',\nmin(q_Previous.'ActualEndDate', q_Previous.'PY_EndDate') as 'Required_EndDatePY';\nresult = foreach result generate 'CY_ActualDailyAmount', 'PY_ActualDailyAmount', 'DerivedActualAmount', 'DerivedPlannedAmount' , 'CY_PlannedDailyAmount', 'PY_PlannedDailyAmount', daysBetween(toDate('Required_StartDate', \"yyyy-MM-dd\"), toDate('Required_EndDate', \"yyyy-MM-dd\"))+1 as 'CY_Days_Diff', daysBetween(toDate('Required_StartDatePY', \"yyyy-MM-dd\"), toDate('Required_EndDatePY', \"yyyy-MM-dd\"))+1 as 'PY_Days_Diff';\nresult = foreach result generate 'CY_ActualDailyAmount', 'PY_ActualDailyAmount', 'DerivedActualAmount', 'DerivedPlannedAmount' , 'CY_PlannedDailyAmount', PY_PlannedDailyAmount, 'CY_Days_Diff'*'CY_PlannedDailyAmount' as 'CY_PlannedFinalAmount', 'PY_Days_Diff'*'PY_PlannedDailyAmount' as 'PY_PlannedFinalAmount', 'CY_Days_Diff'*'CY_ActualDailyAmount' as 'CY_ActualFinalAmount', 'PY_Days_Diff'*'PY_ActualDailyAmount' as 'PY_ActualFinalAmount';\nresult = group result by all;\nresult = foreach result generate sum('DerivedActualAmount') as 'DerivedActualAmount', sum('DerivedPlannedAmount') as 'DerivedPlannedAmount' , sum('CY_PlannedFinalAmount') as 'CY_PlannedAmount', sum('PY_PlannedFinalAmount') as 'PY_PlannedAmount', sum('CY_ActualFinalAmount') as 'CY_ActualAmount', sum('PY_ActualFinalAmount') as 'PY_ActualAmount';\nresult = foreach result generate 'DerivedActualAmount', 'DerivedPlannedAmount' , 'CY_PlannedAmount', 'CY_ActualAmount', \n(sum(CY_ActualAmount)-sum(PY_ActualAmount))/sum(PY_ActualAmount) as 'Actual_Amount_Per',\n (sum(CY_PlannedAmount)-sum(PY_PlannedAmount))/sum(PY_PlannedAmount) as 'Planned_Amount_Per',\n(sum(CY_ActualAmount)/sum(CY_PlannedAmount)) as 'Revenue_Realization_Present', \n(sum(PY_ActualAmount)/sum(PY_PlannedAmount)) as 'Revenue_Realization_Past', \n(((sum(CY_ActualAmount)/sum(CY_PlannedAmount))*100)-((sum(PY_ActualAmount)/sum(PY_PlannedAmount))*100))/((sum(PY_ActualAmount)/sum(PY_PlannedAmount))*100) as 'Revenue_Realization_Per';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1},"widgets":{"number_10":{"parameters":{"compact":true,"exploreLink":true,"interactions":[],"measureField":"Revenue_Realization_Per","noResultsLabel":"-","numberColor":"#FFFFFF","numberSize":12,"showActionMenu":true,"step":"KPIs_Final_Q_1","textAlignment":"left","title":"","titleColor":"#091A3E","titleSize":16,"tooltip":{"customizeTooltip":false}},"type":"number"},"text_1":{"parameters":{"content":{"richTextContent":[{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"number_8":{"parameters":{"compact":true,"exploreLink":true,"interactions":[],"measureField":"Planned_Amount_Per","noResultsLabel":"-","numberColor":"#FFFFFF","numberSize":12,"showActionMenu":true,"step":"KPIs_Final_Q_1","textAlignment":"left","title":"","titleColor":"#091A3E","titleSize":16,"tooltip":{"customizeTooltip":false}},"type":"number"},"number_6":{"parameters":{"compact":false,"exploreLink":true,"interactions":[],"measureField":"Revenue_Realization_Present","numberColor":"#FFFFFF","numberSize":24,"showActionMenu":true,"step":"KPIs_Final_Q_1","textAlignment":"left","title":"","titleColor":"#091A3E","titleSize":16,"tooltip":{"customizeTooltip":false}},"type":"number"},"number_5":{"parameters":{"compact":true,"exploreLink":true,"interactions":[],"measureField":"DerivedPlannedAmount","noResultsLabel":"-","numberColor":"#FFFFFF","numberSize":24,"showActionMenu":true,"step":"KPIs_Final_Q_1","textAlignment":"left","title":"","titleColor":"#091A3E","titleSize":16,"tooltip":{"customizeTooltip":false}},"type":"number"},"number_4":{"parameters":{"compact":true,"exploreLink":true,"interactions":[],"measureField":"CY_PlannedAmount","numberColor":"#FFFFFF","numberSize"