s 'Account.Name', 'Status' as 'Status', 'SalesPrice' as 'SalesPrice', 'Actual Amount' as 'Actual Amount', 'Forecasted Amount' as 'Forecasted Amount';\nFilledData = foreach FilledData generate 'Id' as 'Id', 'Date_Year', 'Date_Month', 'Product.Name' as 'Product.Name', 'Product.Family' as 'Product.Family', 'Account.Name' as 'Account.Name', 'Status' as 'Status', 'Actual Amount' as 'Actual Amount', 'Actual Amount'/'SalesPrice' as 'ActualQuantity', 'Forecasted Amount' as 'Forecasted Amount', \n'Forecasted Amount'/'SalesPrice' as 'ForecastQuantity';\nFilledData = group FilledData by ('Id','Date_Year', 'Date_Month');\nFilledData = foreach FilledData generate 'Id', 'Date_Year'+\"-\"+'Date_Month' as 'Period', first('Product.Name') as 'Product.Name', first('Product.Family') as 'Product.Family', first('Account.Name') as 'Account.Name', first('Status') as 'Status', sum('Actual Amount') as 'ActualAmount', sum('Forecasted Amount') as 'ForecastAmount', sum('ActualQuantity') as 'ActualQuantity', sum('ForecastQuantity') as 'ForecastQuantity';\nresult = group FilledData by ('Product.Name', 'Product.Family', 'Account.Name', 'Status'); \nresult = foreach result generate coalesce('Product.Family', \"NA\") as 'Product Family', coalesce('Product.Name', \"NA\") as 'Product', coalesce('Account.Name', \"NA\") as 'Name', coalesce('Status', \"NA\") as 'Status',  coalesce(sum('ForecastAmount'),0) as 'ForecastedAmount', coalesce(sum('ForecastQuantity'),0) as 'Forecast_Quantity', coalesce(sum('ActualAmount'),0) as 'Actual_Revenue', coalesce(sum('ActualQuantity'),0) as 'Actual_Quantity';","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","start":"[]","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fon