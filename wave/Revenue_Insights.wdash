= load \"Activity2\"; \ncompleted_activities = filter activities by 'Status' == \"Completed\"; \nopen_activities = filter activities by ('Status' != \"Completed\" || 'Status' is null); \noverdue_activities = filter activities by 'IsOverdue' == \"true\" && ('Status' != \"Completed\" || 'Status' is null); \nquota = load \"quota_with_roles\";\nc = group user by all full,  closed_won by all full,  closed_total by all full,  commit by all full,  best_case by all full,  open_pipe by all full,  completed_activities by all full,  open_activities by all full,  overdue_activities by all full, quota by all; \nc = foreach c generate  coalesce(sum(closed_won['Amount']),0) as 'closed_won',  coalesce(sum(commit['Amount']),0) as 'commit',  coalesce(sum(best_case['Amount']),0) as 'best_case',  coalesce(sum(open_pipe['Amount']),0) as 'open_pipe',  coalesce(count(closed_total),0) as 'closed_total',  coalesce(count(closed_won)/count(closed_total),0) as 'win_rate',  coalesce(sum(closed_won['Amount'])/count(closed_won),0) as 'avg_sales_size',  coalesce((sum(closed_won['CloseDate_day_epoch']) - sum(closed_won['CreatedDate_day_epoch']))/count(closed_won),0) as 'avg_days_to_close',  coalesce(count(completed_activities),0) as 'completed_activities',  coalesce(count(open_activities),0) as 'open_activities',  coalesce(count(overdue_activities),0) as 'overdue_activities', coalesce(sum(quota['QuotaAmount']),0) as 'quota',  coalesce(sum(closed_won['Amount']) / sum(quota['QuotaAmount']),0) as 'quota_attainment', case when coalesce(sum(quota['QuotaAmount']) - sum(closed_won['Amount']),0) > 0 then coalesce(sum(quota['QuotaAmount']) - sum(closed_won['Amount']),0) else 0 end as 'gap_to_quota', case when coalesce(sum(open_pipe['Amount']) / (sum(quota['QuotaAmount']) - sum(closed_won['Amount'])),0) > 0 then coalesce(sum(open_pipe['Amount']) / (sum(quota['QuotaAmount']) - sum(closed_won['Amount'])),0) else 0 end as 'pipe_coverage'; \nc = group c by all; \nc = foreach c generate {{cell(team_selector_1.sel