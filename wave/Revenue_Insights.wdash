ar.result, 0, \"last_year\") ,\"1 fiscal_quarter ago\").asString()}}\"];\nresult_a = group closed_a by all full, won_a by all;\nresult_a = foreach result_a generate count(won_a)/count(closed_a)*100 as 'this_period';\nresult_b = group closed_b by all full, won_b by all;\nresult_b = foreach result_b generate count(won_b)/count(closed_b)*100 as 'last_year';\nresult = group result_a by all full, result_b by all;\nresult = foreach result generate round(sum(result_a['this_period']),0) as 'This Period', round(sum(result_b['last_year']),0) as 'Same Time Last Year';","receiveFacetSource":{"mode":"exclude","steps":["CloseDate_1"]},"selectMode":"single","strings":[],"type":"saql","useGlobal":false,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showValues":true,"legend":{"descOrder":false,"showHeader":true,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","binValues":false,"title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":false,"title":"","customDomain":{"showDomain":false}},"theme":"wave","applyConditionalFormatting":true,"dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":false,"icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}},"title":""