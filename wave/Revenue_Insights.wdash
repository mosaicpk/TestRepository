q = foreach q generate 'forecasting_url', 'date_range', 'date_offset', 'count', case       when 'date_range' == \"fiscal_quarter\" && 'date_offset' == \"1\"              then \"NEXT_FISCAL_QUARTER\"       when 'date_range' == \"month\"  && 'date_offset' == \"1\"              then \"NEXT_MONTH\"      when 'date_range' == \"month\"              then \"THIS_MONTH\"      else              \"THIS_FISCAL_QUARTER\"  end  as 'date_literal', case       when 'date_range' == \"fiscal_quarter\"         then \"quarter\"     when 'date_range' == \"month\"         then \"month\"      else         \"quarter\"  end  as 'date_period', case       when 'date_offset' == \"-1\"         then \"0\"     when 'date_offset' == \"0\" && 'date_range' == \"fiscal_quarter\"         then number_to_string(daysBetween(now(), fiscal_quarter_last_day(now()))+1,\"##0\")     when 'date_offset' == \"0\" && 'date_range' == \"month\"         then number_to_string(daysBetween(now(), month_last_day(now()))+1,\"##0\")     when 'date_offset' == \"1\" && 'date_range' == \"fiscal_quarter\"         then number_to_string(daysBetween(toDate(date_to_epoch(fiscal_quarter_last_day(now()))+86400), toDate(date_to_epoch(fiscal_quarter_last_day(toDate(date_to_epoch(fiscal_quarter_last_day(now()))+86400)))+86400)),\"##0\")     when 'date_offset' == \"1\" && 'date_range' == \"month\"         then number_to_string(daysBetween(toDate(date_to_epoch(month_last_day(now()))+86400), toDate(date_to_epoch(month_last_day(toDate(date_to_epoch(month_last_day(now()))+86400)))+86400)),\"##0\")     else         number_to_string(daysBetween(now(), fiscal_quarter_last_day(now()))+1,\"##0\") end  as 'days_remaining'; q = foreach q generate  'date_range',  'date_offset',  'date_period', 'days_remaining', 'forecasting_url',  'count',   \"/lightning/o/Opportunity/pipelineInspection?\" + \"&dateLiteral=\" + 'date_literal' + \"&userId=\" + \"{{cell(intermediate_step.result, 0, \"Id\").asString()}}\" as 'pipe_inspection_url';","receiveFacetSource"