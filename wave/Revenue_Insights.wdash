},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","binValues":false,"title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":false,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":false,"showAxis":false,"title":"","customDomain":{"showDomain":false}},"theme":"wave","applyConditionalFormatting":true,"dimensionAxis":{"showTitle":false,"customSize":"auto","showAxis":false,"icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}},"title":""}},"type":"chart"}},"top_open_opportunities":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"opportunity_revinsights\";\nq = filter q by 'IsClosed' == \"false\";\nq = group q by 'Id';\nq = foreach q generate 'Id', first('Name') as 'Name', first('StageName') as 'Stage', sum('Amount') as 'Amount';\nq = order q by 'Amount' desc nulls last;\nq = limit q 50;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":false,"visualizationParameters":{"parameters":{"borderColor":"#FFFFFF","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{"A":{"parameters":{"alignment":"left","styles":{"linkColor":"#006dcc"}},"type":"text"},"C":{"parameters":{"alignment":"right","styles":{"bold":true}},"type":"text"},"Amount":{"parameters":{"alignment":"right","styles":{"bold":true}},"type":"text"}},"columns":["Name","Stage","Amount"],"customBulkActions":[],"header":{"backgroundColor":"#FFFFFF","fontColor":"#7D98B3","fontSize":11,"textWrap":false},"innerMajorBorderColor":"#FFFFFF","innerMinorBorderColor":"#FFFFFF","interactions":[],"mode":"fittocontainer","numberOfLines":1,"showActionMenu":false,"showRowIndexColumn":false,"totals":true,"verticalPadding":4},"type":"table"}},"time_series_with_forecast":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"q = load \"opportunity_revinsights\"; q = filter q by 'ForecastCategory' == \"Closed\"; k = group q by all; k = foreach k generate \"2000\" as 'Date_Year', \"01\" as 'Date_Month', \"01\" as 'Date_Day'; k = group k by ('Date_Year', 'Date_Month', 'Date_Day'); k = foreach k generate 'Date_Year', 'Date_Month', 'Date_Day', count() as 'sum'; k = fill k by (dateCols=('Date_Year','Date_Month','Date_Day', \"Y-M-D\")); k = timeseries k generate 'sum' as 'cnt' with (length=10000,  dateCols=('Date_Year','Date_Month','Date_Day', \"Y-M-D\")); k = filter k by {{row(CloseDate_1.selection, [0], [\"min\", \"max\"]).asDateRange(\"date('Date_Year','Date_Month', 'Date_Day')\")}}; k = filter k by date('Date_Year','Date_Month', 'Date_Day') in [..\"current day\"]; k = group k by all; k1 = foreach k generate first('Date_Year') as 'CloseDate_Year', first('Date_Month') as 'CloseDate_Month', first('Date_Day') as 'CloseDate_Day', 0 as 'A'; k2 = foreach k generate last('Date_Year') as 'CloseDate_Year', last('Date_Month') as 'CloseDate_Month', last('Date_Day') as 'CloseDate_Day'; k3 = union k1,k2; a = group q by ('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day'); a = foreach a generate 'CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day', sum(q.'Amount') as 'A'; c = union a,k3; c = foreach c generate 'CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day', 'A'; c = fill c by (dateCols=('CloseDate_Year','CloseDate_Month','CloseDate_Day', \"Y-M-D\")); c = filter c by date('CloseDate_Year','CloseDate_Month', 'CloseDate_Day') in [..\"current day\"]; result = group c by ('CloseDate_Year', 'CloseDate_Month', 'CloseDate_Day'); result = foreach result generate c.'CloseDate_Year' + \"~~~\" + c.'CloseDate_Month' + \"~~~\" + c.'CloseDate_Day' as 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day', first('A') as 'A'; result = group result by 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day'; result = foreach result generate 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day', first(A) as 'A', sum(sum(A)) over ([..0] partition by all order by ('CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day')) as 'Cumulative_Amount'; result = order result by ('CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day' asc); start_forecast = group result by all; start_forecast = foreach start_forecast generate last('CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day') as 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day', last('Cumulative_Amount') as 'Cumulative_Amount'; start_forecast = foreach start_forecast generate case when 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day' < \"{{cell(intermediate_date_step.result, 0, \"start_day\").asString()}}\" then \"{{cell(intermediate_date_step.result, 0, \"start_day\").asString()}}\" else 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day' end as 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day', 'Cumulative_Amount'; a1 = load \"opportunity_revinsights\"; a1 = group a1 by all; end_forecast = foreach a1 generate \"{{cell(intermediate_date_step.result, 0, \"end_day\").asString()}}\" as 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day', {{coalesce(cell(saql_commit.result, 0, \"sum_Amount\"),0).asString()}} as 'Cumulative_Amount'; forecast_line = union start_forecast, end_forecast; final = group result by 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day' full, forecast_line by 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day'; final = foreach final generate coalesce(result['CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day'], forecast_line['CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day']) as 'CloseDate_Year~~~CloseDate_Month~~~CloseDate_Day', first(result['Cumulative_Amount']) as 'Closed Won Sales', last(forecast_line['Cumulative_Amount']) as 'Commit Forecast';","receiveFacetSource":{"mode":"include","steps":["CloseDate_1","hierarchy_step"]},"selectMode":"single","start":"[]","strings":[],"type":"saql","useGlobal":false,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","showPoints":false,"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"missingValue":"connect","visualizationType":"time","dashLine":{"measures":"","showDashLine":false},"timeAxis":{"showTitle":true,"showAxis":true,"title":""},"title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"fillArea":true,"showActionMenu":true,"showZero":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"none","theme":"wave","applyConditionalFormatting":true,"drawArea":{"measure":"","bounding1":"","showDrawArea":false,"bounding2":""}},"type":"chart"}},"Team_Performance_AvgKPI3":{"broadcastFacet":true,"groups":[],"label":"","numbers":[],"query":"user = load \"userrole_revinsights\"; \nopp = load \"opportunity_revinsights\"; \nclosed_won = filter opp by 'IsWon' == \"true\"; \nclosed_total = filter opp by 'IsClosed' == \"true\"; \ncommit = filter opp by 'ForecastCategory' in [\"Forecast\", \"Closed\"]; \nbest_case = filter opp by 'ForecastCategory' in [\"BestCase\", \"Forecast\", \"MostLikely\", \"Closed\"]; \nopen_pipe = filter opp by 'ForecastCategory' in [\"BestCase\", \"Forecast\", \"MostLikely\", \"Pipeline\"]; \nactivities = load \"Activity2\"; \ncompleted_activities = filter activities by 'Status' == \"Completed\"; \nopen_activities = filter activities by ('Status' != \"Completed\" || 'Status' is null); \noverdue_activities = filter activities by 'IsOverdue' == \"true\" && ('Status' != \"Completed\" || 'Status' is null); \nquota = load \"quota_with_roles\";\nc = group user by all full,  closed_won by all full,  closed_total by all full,  commit by all full,  best_case by all full,  open_pipe by all full,  completed_activities by all full,  open_activities by all full,  overdue_activities by all full, quota by all; \nc = foreach c generate  coalesce(sum(closed_won['Amount']),0) as 'closed_won',  coalesce(sum(commit['Amount']),0) as 'commit',  coalesce(sum(best_case['Amount']),0) as 'best_case',  coalesce(sum(open_pipe['Amount']),0) as 'open_pipe',  coalesce(count(closed_total),0) as 'closed_total',  coalesce(count(closed_won)/count(closed_total),0) as 'win_rate',  coalesce(sum(closed_won['Amount'])/count(closed_won),0) as 'avg_sales_size',  coalesce((sum(closed_won['CloseDate_day_epoch']) - sum(closed_won['CreatedDate_day_epoch']))/count(closed_won),0) as 'avg_days_to_close',  coalesce(count(completed_activities),0) as 'completed_activities',  coalesce(count(open_activities),0) as 'open_activities',  coalesce(count(overdue_activities),0) as 'overdue_activities', coalesce(sum(quota['QuotaAmount']),0) as 'quota',  coalesce(sum(closed_won['Amount']) / sum(quota['QuotaAmount']),0) as 'quota_attainment', case when coalesce(sum(quota['QuotaAmount']) - sum(closed_won['Amount']),0) > 0 then coalesce(sum(quota['QuotaAmount']) - sum(closed_won['Amount']),0) else 0 end as 'gap_to_quota', case when coalesce(sum(open_pipe['Amount']) / (sum(quota['QuotaAmount']) - sum(closed_won['Amount'])),0) > 0 then coalesce(sum(open_pipe['Amount']) / (sum(quota['QuotaAmount']) - sum(closed_won['Amount'])),0) else 0 end as 'pipe_coverage'; \nc = group c by all; \nc = foreach c generate {{cell(team_se