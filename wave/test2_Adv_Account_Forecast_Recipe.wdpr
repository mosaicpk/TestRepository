      }
    },
    "FORMULA36" : {
      "action" : "computeRelative",
      "sources" : [ "APPEND2" ],
      "parameters" : {
        "partitionBy" : [ "Id" ],
        "orderBy" : [ {
          "fieldName" : "LastModifiedDate",
          "direction" : "ASC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "ValidFromIntermed",
          "label" : "ValidFromIntermed",
          "formulaExpression" : "lag(LastModifiedDate)",
          "format" : "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
          "defaultValue" : "1111-01-01T00:00:00.000Z"
        } ]
      }
    },
    "FORMULA37" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA36" ],
      "parameters" : {
        "partitionBy" : [ "Id" ],
        "orderBy" : [ {
          "fieldName" : "LastModifiedDate",
          "direction" : "ASC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "ValidToIntermed",
          "label" : "ValidToIntermed",
          "formulaExpression" : "lead(LastModifiedDate)",
          "format" : "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
          "defaultValue" : "3000-01-01T00:00:00.000Z"
        } ]
      }
    },
    "FORMULA38" : {
      "action" : "formula",
      "sources" : [ "FORMULA37" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "ValidFrom",
          "label" : "ValidFrom",
          "formulaExpression" : "case when ValidFromIntermed = to_Timestamp('1111-01-01 00:00:00', 'yyyy-MM-dd HH:mm:ss') then to_Timestamp(CreatedDate, 'yyyy-MM-dd HH:mm:ss') else to_Timestamp(LastModifiedDate, 'yyyy-MM-dd HH:mm:ss') end",
          "format" : "yyyy-MM-dd HH:mm:ss",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA39" : {
      "action" : "formula",
      "sources" : [ "FORMULA38" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "ValidTo",
          "label" : "ValidTo",
          "formulaExpression" : "case when ValidToIntermed = to_Timestamp('3000-01-01 00:00:00', 'yyyy-MM-dd HH:mm:ss') then to_Timestamp('3000-01-01 00:00:00','yyyy-MM-dd HH:mm:ss') else to_Timestamp(from_unixtime((to_unix_timestamp(ValidToIntermed) - 1)), 'yyyy-MM-dd HH:mm:ss') end",
          "format" : "yyyy-MM-dd HH:mm:ss",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA40" : {
      "action" : "formula",
      "sources" : [ "FORMULA39" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "IdValidFromToKey",
          "label" : "IdValidFromToKey",
          "formulaExpression" : "concat(Id,'-',string(ValidFrom),'-',string(ValidTo))",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
