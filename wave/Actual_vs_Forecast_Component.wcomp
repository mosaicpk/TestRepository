{"dataSourceLinksInfo":{"enableAutomaticLinking":true,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[{"maxWidth":1800,"name":"Default","numColumns":50,"pages":[{"label":"Untitled","name":"7daeb0b0-e06c-426e-9474-213a30504b10","navigationHidden":false,"widgets":[{"colspan":50,"column":0,"name":"text_1","row":0,"rowspan":3,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}},{"colspan":50,"column":0,"name":"chart_1","row":3,"rowspan":30,"widgetStyle":{"backgroundColor":"#091A3E","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#FFFFFF","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"Actual_vs_Forecast_C_1":{"broadcastFacet":false,"groups":[],"label":"Actual_vs_Forecast_Chart","numbers":[],"query":"q = load \"MFG_AccountProductPeriodForecast\";\nStart = foreach q generate 'Id' as 'Id', 'Period.StartDate_sec_epoch' as 'Period.StartDate_sec_epoch', 'Period.EndDate_sec_epoch' as 'Period.EndDate_sec_epoch', 'ForecastedDailyRevenue' as 'ForecastedDailyRevenue', date_to_string(toDate('Period.StartDate_sec_epoch'),\"yyyy\") as 'Date_Year', date_to_string(toDate('Period.StartDate_sec_epoch'),\"MM\") as 'Date_Month', (daysBetween(toDate('Period.StartDate_sec_epoch'),month_last_day(toDate('Period.StartDate_sec_epoch')))+1) * 'ForecastedDailyRevenue' as 'Forecast_Amount';\nEnd_Value = foreach q generate 'Id' as 'Id', 'Period.StartDate_sec_epoch' as 'Period.StartDate_sec_epoch', 'Period.EndDate_sec_epoch' as 'Period.EndDate_sec_epoch', 'ForecastedDailyRevenue' as 'ForecastedDailyRevenue', date_to_string(toDate('Period.EndDate_sec_epoch'),\"yyyy\") as 'Date_Year', date_to_string(toDate('Period.EndDate_sec_epoch'),\"MM\") as 'Date_Month', (daysBetween(toDate(date_to_epoch(month_last_day(toDate((date_to_epoch(month_last_day(toDate('Period.EndDate_sec_epoch'))) - 2764800))))),toDate('Period.EndDate_sec_epoch'))) * 'ForecastedDailyRevenue' as 'Forecast_Amount';\nDataForFill = union Start, End_Value; \nDataForFill = foreach DataForFill generate 'Id' as 'Id', 'Period.StartDate_sec_epoch' as 'Period.StartDate_sec_epoch', 'Period.EndDate_sec_epoch' as 'Period.EndDate_sec_epoch', 'Date_Year' as 'Date_Year', 'Date_Month' as 'Date_Month', 'ForecastedDailyRevenue' as 'ForecastedDailyRevenue', 'Forecast_Amount' as 'Forecast_Amount';\nFilledData = fill DataForFill by (dateCols=('Date_Year', 'Date_Month', \"Y-M\"), partition='Id'); \nFilledData = group FilledData by ('Id', 'Date_Year', 'Date_Month'); \nFilledData = foreach FilledData generate 'Id', 'Date_Year', 'Date_Month', first('Period.StartDate_sec_epoch') as 'Start', date_to_epoch(toDate('Date_Year'+\"-\"+'Date_Month'+\"-01\",\"yyyy-MM-dd\")) as 'Date',  min(first('Period.StartDate_sec_epoch')) over ([..0] partition by 'Id' order by ('Date_Year','Date_Month')) as 'Start Date', max(first('Period.EndDate_sec_epoch')) over ([..] partition by 'Id' ) as 'End Date', min(first('ForecastedDailyRevenue'))over ([..0] partition by 'Id' order by ('Date_Year','Date_Month')) as 'ForecastedDailyRevenue', sum('Forecast_Amount') as 'Forecast_Amount';\nFilledData = filter FilledData by coalesce('Start',0) != 0 || ('Date' > 'Start Date' && 'Date' < 'End Date'); \nFilledData = foreach FilledData generate 'Id', 'Date_Year', 'Date_Month', (case when 'Forecast_Amount' is null then month_days(toDate('Date'))*'ForecastedDailyRevenue' else 'Forecast_Amount' end) as 'Forecast_Amount'; \nActuals = load \"MFG_OrderProduct\";\nActuals = group Actuals by ('Id', 'Order.EffectiveDate_Year', 'Order.EffectiveDate_Month');\nActuals = foreach Actuals generate 'Id', 'Order.EffectiveDate_Year' as 'Date_Year', 'Order.EffectiveDate_Month' as 'Date_Month', sum('TotalPrice') as 'Actual_Amount';\nResult = cogroup FilledData by ('Date_Year', 'Date_Month') full, Actuals by ('Date_Year', 'Date_Month');\nResult = foreach Result generate coalesce(FilledData.'Date_Year', Actuals.'Date_Year')  as 'Date_Year', coalesce(FilledData.'Date_Month', Actuals.'Date_Month') as 'Date_Month', sum(Actuals.'Actual_Amount') as 'Actual_Amount', sum(FilledData.'Forecast_Amount') as 'Forecast_Amount';\nResult = foreach Result generate 'Date_Year' + \"~~~\" + 'Date_Month' as 'StartDate_Year~~~StartDate_Month', 'Actual_Amount' as 'Actual_Amount', 'Forecast_Amount' as 'Forecast_Amount', coalesce('Actual_Amount',0) - coalesce('Forecast_Amount',0) as 'Actual_vs_Forecast_Amount';\nResult = group Result by 'StartDate_Year~~~StartDate_Month';\nResult = foreach Result generate 'StartDate_Year~~~StartDate_Month' as 'StartDate_Year~~~StartDate_Month', sum('Actual_vs_Forecast_Amount')  as 'Actual_vs_Forecast_Amount', case when (sum(Actual_Amount)-sum(Forecast_Amount))/sum(Actual_Amount) < 0 then (((sum(Actual_Amount)-sum(Forecast_Amount))/sum(Actual_Amount))*-1)/12 else ((sum(Actual_Amount)-sum(Forecast_Amount))/sum(Actual_Amount))/12 end as 'MAPE', case when sum('Actual_vs_Forecast_Amount') < 0 then \"Red\" else \"Green\" end as 'Colour';\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","stack":false,"bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"showPoints":true,"legend":{"descOrder":false,"showHeader":true,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"time-combo","missingValue":"connect","timeAxis":{"showTitle":false,"showAxis":true,"title":""},"title":{"f