    "FORMULA30" : {
      "action" : "computeRelative",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when lag(CreatedDate) is null AND IsClosed = true AND IsWon = true then 1 else 0 end",
          "label" : "IsFirstWonOppty",
          "name" : "IsFirstWonOppty",
          "precision" : 10,
          "scale" : 0,
