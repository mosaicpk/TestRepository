    "FORMULA42" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "1",
          "formulaExpression" : "case when StageName = StageNamePrev then '0' else '1' end",
          "label" : "Stage IsUpdated",
          "name" : "Stage_isUpdated",
          "precision" : 255,
          "type" : "TEXT"
        } ]
      },
      "sources" : [ "FORMULA41" ]
    },
    "FORMULA43" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when Stage_isUpdated = '1' then to_unix_timestamp(ValidToDate) - to_unix_timestamp(ValidFromDate) else 0 end",
          "label" : "Seconds in Stage",
          "name" : "Seconds_inStage",
          "precision" : 10,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
      "sources" : [ "FORMULA42" ]
    },
    "FORMULA44" : {
      "action" : "computeRelative",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "lag(ForecastCategory)",
          "label" : "ForecastCategoryPrev",
          "name" : "ForecastCategoryPrev",
          "precision" : 255,
          "type" : "TEXT"
        } ],
        "orderBy" : [ {
          "direction" : "ASC",
          "fieldName" : "Unique_Sort_Key"
        } ],
        "partitionBy" : [ "OpportunityId" ]
      },
      "sources" : [ "FORMULA43" ]
    },
    "FORMULA47" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when LastActivityDate is null then datediff(LastModifiedDate, now()) when LastModifiedDate > LastActivityDate then datediff(LastModifiedDate, now()) else datediff(LastActivityDate, now()) end",
          "label" : "DaysSinceLastActivity",
          "name" : "DaysSinceLastActivity",
          "precision" : 8,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
      "sources" : [ "FORMULA31" ]
    },
    "FORMULA48" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when DaysSinceLastActivity >= 60 and IsClosed = 'false' then 'true' else 'false' end",
          "label" : "Neglected",
          "name" : "Neglected",
          "precision" : 255,
          "type" : "TEXT"
        } ]
      },
      "sources" : [ "FORMULA47" ]
    },
    "FORMULA49" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when (to_unix_timestamp(CloseDatePrev) > 0) and (to_unix_timestamp(CloseDatePrev) > to_unix_timestamp(CloseDate)) then 1 else 0 end",
          "label" : "IsPulled",
          "name" : "IsPulled",
          "precision" : 8,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
      "sources" : [ "FORMULA44" ]
    },
    "FORMULA50" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when ValidToDate = '3000-01-01T00:00:00.000Z' then\n\nabs(to_unix_timestamp(ValidFromDate) - to_unix_timestamp(now()))\n\nelse\nabs(to_unix_timestamp(ValidFromDate) - to_unix_timestamp(ValidToDate))\n\nend",
          "label" : "Duration",
          "name" : "Duration",
          "precision" : 18,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
      "sources" : [ "FORMULA49" ]
    },
    "FORMULA53" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when \"Stage.SortOrder\" > \"StagePrev.SortOrder\" then 1 else 0 end",
          "label" : "Is_StageProgressed",
          "name" : "Is_StageProgressed",
          "precision" : 2,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
      "sources" : [ "FORMULA34" ]
    },
    "FORMULA54" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when \"Stage.SortOrder\" < \"StagePrev.SortOrder\" then 1 else 0 end",
          "label" : "Is_StageRegressed",
          "name" : "Is_StageRegressed",
          "precision" : 2,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
      "sources" : [ "FORMULA53" ]
    },
    "FORMULA55" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case\n    when Is_StageProgressed = 1 and \"Stage.IsClosed\" = 'false' then 'Progressed'\n\n    when Is_StageRegressed = 1 and \"Stage.IsClosed\" = 'false' then 'Regressed'\n    \n    when \"Stage.IsWon\" = 'true' then 'Won'\n    \n    when \"Stage.IsWon\" = 'false' and \"Stage.IsClosed\" = 'true' then 'Lost'\n    \n    when Is_StageProgressed = 0 and Is_StageRegressed = 0 and \"Stage.IsClosed\" = 'false' then 'Unchanged'\nend\n",
          "label" : "StageProgression",
          "name" : "StageProgression",
          "precision" : 255,
          "type" : "TEXT"
        } ]
      },
      "sources" : [ "FORMULA54" ]
    },
