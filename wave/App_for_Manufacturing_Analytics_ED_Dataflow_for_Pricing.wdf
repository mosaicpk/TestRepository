["{\"nodes\":{\"ED_Story_Augment_Prod_Details_to_SA_Product\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"Product.ProductCode\"],\"operation\":\"LookupSingleValue\",\"relationship\":\"Product\",\"rightKey\":[\"ProductCode\"],\"rightSelect\":[\"AvgMonthlyQty\",\"Schedule.ActualQuantity\",\"Schedule.PlannedQtyTD\",\"ProductCompliance\",\"Schedule.SalesAgreementProduct.SalesAgreement.Account.Parent\",\"Schedule.SalesAgreementProduct.SalesAgreement.Account.ParentsPath\",\"Schedule.SalesAgreementProduct.SalesAgreement.Account.Parent_Name\"]},\"sources\":[\"ED_Story_Extract_MFG_SalesAgreementProduct\",\"ED_Story_Compute_Avg_monthly_qty\"]},\"ED_Story_Augment_Schedule_details_to_SA_Product\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"SalesAgreementId\",\"Product.ProductCode\"],\"operation\":\"LookupMultiValue\",\"relationship\":\"Schedule\",\"rightKey\":[\"SalesAgreementProduct.SalesAgreementId\",\"SalesAgreementProduct.Product.ProductCode\"],\"rightSelect\":[\"PlannedDays_Total\",\"ActualAmount\",\"DerivedPlannedAmount\",\"ActualQuantity\",\"SalesPrice\",\"DerivedActualAmount\",\"PlannedAmtTD\",\"PlannedQtyTD\",\"Counter\",\"DiscountPercentage\",\"SalesAgreementProduct.SalesAgreement.Account.Parent\",\"SalesAgreementProduct.SalesAgreement.Account.ParentsPath\",\"SalesAgreementProduct.SalesAgreement.Account.Parent_Name\"]},\"sources\":[\"ED_Story_Augment_Prod_Details_to_SA_Product\",\"ED_Story_Compute_TDs_for_Schedules\"]},\"ED_Story_Digest_Product\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"Id\"},{\"name\":\"Name\"},{\"name\":\"ProductCode\"}],\"object\":\"Product2\"}},\"ED_Story_Extract_MFG_SalesAgreementProductSchedule\":{\"action\":\"dataset\",\"parameters\":{\"name\":\"MFG_SalesAgreementProductSchedule\"}},\"ED_Story_Slice_Pick_required_fields\":{\"action\":\"sliceDataset\",\"parameters\":{\"fields\":[{\"name\":\"Id\"},{\"name\":\"LastModifiedDate\"},{\"name\":\"ListPrice\"},{\"name\":\"SalesPrice\"},{\"name\":\"SalesAgreement.AgreementType\"},{\"name\":\"SalesAgreement.CancellationDate\"},{\"name\":\"SalesAgreement.EndDate\"},{\"name\":\"SalesAgreement.ScheduleFrequency\"},{\"name\":\"SalesAgreement.StartDate\"},{\"name\":\"SalesAgreement.Status\"},{\"name\":\"SalesAgreement.Owner.Name\"},{\"name\":\"SalesAgreement.Derived_Status\"},{\"name\":\"SalesAgreement.Account.BillingCity\"},{\"name\":\"SalesAgreement.Account.BillingCountry\"},{\"name\":\"SalesAgreement.Account.BillingState\"},{\"name\":\"SalesAgreement.Account.Industry\"},{\"name\":\"SalesAgreement.Account.Name\"},{\"name\":\"SalesAgreement.Account.Type\"},{\"name\":\"SalesAgreement.Account.Owner.Name\"},{\"name\":\"Product.Family\"},{\"name\":\"Product.IsActive\"},{\"name\":\"Product.Name\"},{\"name\":\"PricebookEntry.Name\"},{\"name\":\"Product.Schedule.ActualQuantity\"},{\"name\":\"Product.Schedule.PlannedQtyTD\"},{\"name\":\"Product.ProductCompliance\"},{\"name\":\"Schedule.DerivedPlannedAmount\"},{\"name\":\"Schedule.DerivedActualAmount\"},{\"name\":\"Compliance\"},{\"name\":\"Realization\"},{\"name\":\"ActiveDuration\"},{\"name\":\"DaysTillExpiration\"},{\"name\":\"RenewalFlag\"},{\"name\":\"AvgDiscountSAP\"},{\"name\":\"AvgDiscountVsListPrice\"},{\"name\":\"SalesAgreement.Account.Parent\"},{\"name\":\"SalesAgreement.Account.ParentsPath\"},{\"name\":\"Product.Schedule.SalesAgreementProduct.SalesAgreement.Account.Parent\"},{\"name\":\"Product.Schedule.SalesAgreementProduct.SalesAgreement.Account.ParentsPath\"},{\"name\":\"Schedule.SalesAgreementProduct.SalesAgreement.Account.Parent\"},{\"name\":\"Schedule.SalesAgreementProduct.SalesAgreement.Account.ParentsPath\"},{\"name\":\"SalesAgreement.Account.Parent_Name\"},{\"name\":\"Product.Schedule.SalesAgreementProduct.SalesAgreement.Account.Parent_Name\"},{\"name\":\"Schedule.SalesAgreementProduct.SalesAgreement.Account.Parent_Name\"}],\"mode\":\"select\"},\"sources\":[\"ED_Story_Compute_Fields_for_ED\"]},\"ED_Story_Extract_MFG_SalesAgreementProduct\":{\"action\":\"dataset\",\"parameters\":{\"name\":\"MFG_SalesAgreementProduct\"}},\"ED_Story_Compute_Fields_for_ED\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"label\":\"Compliance\",\"name\":\"Compliance\",\"precision\":12,\"saqlExpression\":\"('Schedule.DerivedActualAmount'/'Schedule.PlannedAmtTD') * 100\",\"scale\":2,\"type\":\"Numeric\"},{\"label\":\"Realization\",\"name\":\"Realization\",\"precision\":12,\"saqlExpression\":\"('Schedule.DerivedActualAmount'/'Schedule.DerivedPlannedAmount')*100\",\"scale\":2,\"type\":\"Numeric\"},{\"label\":\"ActiveDuration\",\"name\":\"ActiveDuration\",\"precision\":16,\"saqlExpression\":\"case when date_to_epoch(now()) >=  'SalesAgreement.EndDate_sec_epoch' then  daysBetween(toDate('SalesAgreement.StartDate_sec_epoch'),toDate('SalesAgreement.EndDate_sec_epoch'))+1  when date_to_epoch(now()) >= 'SalesAgreement.StartDate_sec_epoch' then daysBetween(toDate('SalesAgreement.StartDate_sec_epoch'),now())+1\\nelse\\n0 end\",\"scale\":0,\"type\":\"Numeric\"},{\"label\":\"DaysTillExpiration\",\"name\":\"DaysTillExpiration\",\"precision\":16,\"saqlExpression\":\"case when date_to_epoch(now()) >=  'SalesAgreement.EndDate_sec_epoch' then 0 else daysBetween(now(),toDate('SalesAgreement.EndDate_sec_epoch'))+1\\nend\",\"scale\":0,\"type\":\"Numeric\"},{\"label\":\"RenewalFlag\",\"name\":\"RenewalFlag\",\"saqlExpression\":\"case when date_to_epoch(now()) >=  'SalesAgreement.EndDate_sec_epoch' && 'SalesAgreement.RenewedToAgreementId' is not null\\nthen \\\"True\\\"\\nwhen date_to_epoch(now()) >=  'SalesAgreement.EndDate_sec_epoch'\\nthen \\\"False\\\" end\",\"type\":\"Text\"},{\"label\":\"AvgDiscountSAP\",\"name\":\"AvgDiscountSAP\",\"precision\":16,\"saqlExpression\":\"'Schedule.DiscountPercentage'/'Schedule.Counter'\",\"scale\":2,\"type\":\"Numeric\"},{\"defaultValue\":\"0\",\"label\":\"AvgDiscountVsListPrice\",\"name\":\"AvgDiscountVsListPrice\",\"precision\":16,\"saqlExpression\":\"((ListPrice - (SalesPrice * (1 - ('Schedule.DiscountPercentage'/('Schedule.Counter'*100)))))/ListPrice)*100\",\"scale\":2,\"type\":\"Numeric\"}],\"mergeWithSource\":true},\"sources\":[\"ED_Story_Augment_Schedule_details_to_SA_Product\"]},\"ED_Story_Register_SA_Product_for_ED\":{\"action\":\"register\",\"parameters\":{\"label\":\"SA Product For Renewals ED\",\"name\":\"SAProductForRenewalsED\"},\"sources\":[\"ED_Story_Slice_Pick_required_fields\"]},\"ED_Story_Compute_TDs_for_Schedules\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"label\":\"PlannedAmtTD\",\"name\":\"PlannedAmtTD\",\"precision\":16,\"saqlExpression\":\"case when toDate('StartDate_sec_epoch') > now() then 0 when toDate('ActualEndDate_sec_epoch') > now() then (daysBetween(toDate('StartDate_sec_epoch'),now())+1) * 'PlannedDailyAmount'  else 'DerivedPlannedAmount' end\",\"scale\":2,\"type\":\"Numeric\"},{\"label\":\"PlannedQtyTD\",\"name\":\"PlannedQtyTD\",\"precision\":16,\"saqlExpression\":\"case when toDate('StartDate_sec_epoch') > now() then 0 when toDate('ActualEndDate_sec_epoch') > now() then (daysBetween(toDate('StartDate_sec_epoch'),now())+1) * 'PlannedDailyQuantity'  else 'PlannedQuantity' end\",\"scale\":2,\"type\":\"Numeric\"},{\"label\":\"SalesPriceWeight\",\"name\":\"SalesPriceWeight\",\"precision\":14,\"saqlExpression\":\"(SalesPrice*((100-DiscountPercentage)/100))/'SalesAgreementProduct.PricebookEntry.UnitPrice'\",\"scale\":2,\"type\":\"Numeric\"},{\"defaultValue\":\"1\",\"label\":\"Counter\",\"name\":\"Counter\",\"precision\":12,\"saqlExpression\":\"1\",\"scale\":2,\"type\":\"Numeric\"}],\"mergeWithSource\":true},\"sources\":[\"ED_Story_Extract_MFG_SalesAgreementProductSchedule\"]},\"ED_Story_Augment_Schedule_details_to_Product\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"ProductCode\"],\"operation\":\"LookupMultiValue\",\"relationship\":\"Schedule\",\"rightKey\":[\"SalesAgreementProduct.Product.ProductCode\"],\"rightSelect\":[\"PlannedDailyQuantity\",\"Counter\",\"ActualQuantity\",\"PlannedQtyTD\",\"SalesAgreementProduct.SalesAgreement.Account.Parent\",\"SalesAgreementProduct.SalesAgreement.Account.ParentsPath\",\"SalesAgreementProduct.SalesAgreement.Account.Parent_Name\"]},\"sources\":[\"ED_Story_Digest_Product\",\"ED_Story_Compute_TDs_for_Schedules\"]},\"ED_Story_Compute_Avg_monthly_qty\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"defaultValue\":\"0\",\"label\":\"AvgMonthlyQty\",\"name\":\"AvgMonthlyQty\",\"precision\":12,\"saqlExpression\":\"('Schedule.PlannedDailyQuantity' * 30) / 'Schedule.Counter'\",\"scale\":2,\"type\":\"Numeric\"},{\"label\":\"ProductCompliance\",\"name\":\"ProductCompliance\",\"precision\":16,\"saqlExpression\":\"('Schedule.ActualQuantity'/'Schedule.PlannedQtyTD')*100\",\"scale\":2,\"type\":\"Numeric\"}],\"mergeWithSource\":true},\"sources\":[\"ED_Story_Augment_Schedule_details_to_Product\"]}}}",null]