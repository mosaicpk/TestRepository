<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>contact_sharing_rule</fullName>
        <accessLevel>Read</accessLevel>
        <label>contact sharing rule</label>
        <sharedTo>
            <guestUser>Mosaic_Scheduler</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>Email</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
