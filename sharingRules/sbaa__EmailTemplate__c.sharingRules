<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>PMC_DH_Access_Review_Email_Template</fullName>
        <accessLevel>Read</accessLevel>
        <label>DH Access Review Email Template Sharing Rule</label>
        <sharedTo>
            <guestUser>Digital_Hub</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>equals</operation>
            <value>PMC_DH_AccessReviewRequest</value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
