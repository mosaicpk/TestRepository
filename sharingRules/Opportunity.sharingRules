    <sharingOwnerRules>
        <fullName>PMC_SS_RWAccessToNaSSAFromNASalesManager</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This rule shares the Opportunity records created by users in NA Sales Manager role to users in NA Sales Service Analyst (SSA) role with Read/Write Access</description>
        <label>RW Access To NA SSA From NA Sales Manager</label>
        <sharedTo>
            <role>PMC_SS_NASalesServiceAnalystSSA</role>
        </sharedTo>
        <sharedFrom>
            <role>PMC_NA_SalesManager</role>
        </sharedFrom>
