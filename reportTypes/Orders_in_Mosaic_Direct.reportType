<?xml version="1.0" encoding="UTF-8"?>
<ReportType xmlns="http://soap.sforce.com/2006/04/metadata">
    <baseObject>Order</baseObject>
    <category>busop</category>
    <deployed>false</deployed>
    <description>As a System Administrator,

I want to be able to report on Orders and Order Products from Accounts that have access to Mosaic Direct, 

So that I can better support my business when questions arise.</description>
