    <fields>
        <fullName>campaign_utm_content__c</fullName>
        <description>UTM ID Field that Identifies the content zone, such as a call-to-action message.</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>UTM Content</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>campaign_utm_medium__c</fullName>
        <description>UTM Field that Identifies the medium, such as a search engine, a social media platform, or another platform.</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>UTM Medium</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>campaign_utm_source__c</fullName>
        <description>UTM Source field that Identifies the source of the traffic, such as Google or AdWords. (This can be different from Lead Source)</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>UTM Source</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>campaign_utm_term__c</fullName>
        <description>UTM Term field that Identifies keywords that generate clicks.</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>UTM Term</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>import_id__c</fullName>
        <description>Field to help identify import files</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>Import Id</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <listViews>
        <fullName>AllActiveCampaigns</fullName>
        <columns>CAMPAIGN.NAME</columns>
        <columns>CAMPAIGN.START_DATE</columns>
        <columns>CAMPAIGN.END_DATE</columns>
        <columns>CAMPAIGN.CAMPAIGN_TYPE</columns>
        <columns>CAMPAIGN.STATUS</columns>
        <columns>CORE.USERS.FIRST_NAME</columns>
        <columns>CORE.USERS.LAST_NAME</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CAMPAIGN.ACTIVE</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>All Active Campaigns</label>
    </listViews>
    <listViews>
        <fullName>MyActiveCampaigns</fullName>
        <columns>CAMPAIGN.NAME</columns>
        <columns>CAMPAIGN.START_DATE</columns>
        <columns>CAMPAIGN.END_DATE</columns>
        <columns>CAMPAIGN.CAMPAIGN_TYPE</columns>
        <columns>CAMPAIGN.STATUS</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>CAMPAIGN.ACTIVE</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>My Active Campaigns</label>
    </listViews>
