        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ConfirmedDate__c</fullName>
        <description>Capture the date received from SAP for weekly product data</description>
        <encryptionScheme>None</encryptionScheme>
        <label>Forecasted Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ConfirmedQuantity__c</fullName>
        <description>Capture quantity received from SAP for weekly product data.</description>
        <externalId>false</externalId>
        <label>Forecasted Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
