    <fields>
        <fullName>PMC_CLM_HasPriceChanged__c</fullName>
        <description>This field will indicate if Price has Changed in an Amendment or if a new line was adeed</description>
        <formula>IF(
AND(
TEXT(SBQQ__Quote__r.SBQQ__Type__c)=&apos;Amendment&apos;,
SBQQ__UpgradedSubscription__r.SBQQ__QuoteLine__r.PMC_CPQ_FinalPricePerTonne__c  &lt;&gt; PMC_CPQ_FinalPricePerTonne__c), 
true, 
false
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Has Price Changed</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMC_CLM_HasShipToorPOChanged__c</fullName>
        <description>This field will be used to indicate if the Ship To or Line PO Number fields of Quote Lines in an Amendment Quote has been changed from what they were in the Original Quote Lines</description>
        <formula>IF(
AND(
TEXT(SBQQ__Quote__r.SBQQ__Type__c) = &apos;Amendment&apos;,
OR(
SBQQ__UpgradedSubscription__r.SBQQ__QuoteLine__r.PMC_CPQ_LinePONumber__c &lt;&gt;PMC_CPQ_LinePONumber__c,
SBQQ__UpgradedSubscription__r.SBQQ__QuoteLine__r.PMC_CPQ_ShipTo__c &lt;&gt; PMC_CPQ_ShipTo__c   
)
),
true,
false
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Has Ship-To or PO Changed</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMC_CLM_LatestCadenceDate__c</fullName>
        <label>Latest Cadence Date</label>
        <summarizedField>PMC_CPQ_Cadence__c.PMC_CPQ_ConfirmedDate__c</summarizedField>
        <summaryForeignKey>PMC_CPQ_Cadence__c.PMC_CPQ_QuoteLine__c</summaryForeignKey>
        <summaryOperation>max</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>PMC_CLM_Payment_Terms_Translation__c</fullName>
        <description>Payment term translations to the document language</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>Payment Terms Translation</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CLM_QuoteLineNumber__c</fullName>
        <externalId>false</externalId>
        <formula>IF	(
	TEXT(SBQQ__Quote__r.SBQQ__Type__c) &lt;&gt; &apos;Amendment&apos;,
		SBQQ__Quote__r.PMC_CLM_DocumentNumber__c &amp; &quot;-&quot; &amp; SUBSTITUTE(Name,&quot;QL-&quot;,&quot;&quot;),
		IF	(
				ISNULL(SBQQ__UpgradedSubscription__c) ||  ISBLANK(SBQQ__UpgradedSubscription__c),
				SBQQ__Quote__r.SBQQ__Opportunity2__r.SBQQ__AmendedContract__r.SBQQ__Quote__r.PMC_CLM_DocumentNumber__c &amp; &quot;-&quot; &amp; SUBSTITUTE(Name,&quot;QL-&quot;,&quot;&quot;),
				SBQQ__UpgradedSubscription__r.SBQQ__QuoteLine__r.SBQQ__Quote__r.PMC_CLM_DocumentNumber__c &amp; &quot;-&quot; &amp; SUBSTITUTE(SBQQ__UpgradedSubscription__r.SBQQ__QuoteLine__r.Name ,&quot;QL-&quot;,&quot;&quot;) 	
			)
	)</formula>
        <label>Quote Line Number</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CLM_ShipToInformation__c</fullName>
        <description>This field is created to get the Ship To address information on the Line level - so that it can be shown in the amendment template</description>
        <externalId>false</externalId>
        <formula>PMC_CPQ_ShipTo__r.ShippingStreet + &apos;, &apos; + PMC_CPQ_ShipTo__r.ShippingCity + &apos;, &apos; +  PMC_CPQ_ShipTo__r.ShippingPostalCode + &apos;, &apos; + PMC_CPQ_ShipTo__r.ShippingState + &apos;, &apos; + PMC_CPQ_ShipTo__r.ShippingCountry</formula>
        <label>Ship To Information</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
