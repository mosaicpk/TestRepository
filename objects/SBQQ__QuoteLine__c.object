        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_MarketAdjustment__c</fullName>
        <label>Market Adjustment</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_MaterialGroup__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND(TEXT(SBQQ__Quote__r.PMC_CPQ_QuoteRecordSubType__c ) = &apos;Raw Material&apos;, TEXT(SBQQ__Product__r.PMC_CPQ_MaterialGroup__c) = &apos;Co-Product&apos;), TEXT(10 + PMC_CPQ_ApprovalRequired__c ),

IF(AND(TEXT(SBQQ__Quote__r.PMC_CPQ_QuoteRecordSubType__c) = &apos;Co-Products&apos;, TEXT(SBQQ__Product__r.PMC_CPQ_MaterialGroup__c) = &apos;Co-Product&apos;), TEXT(20 + PMC_CPQ_ApprovalRequired__c ),

IF(TEXT(SBQQ__Product__r.PMC_CPQ_MaterialGroup__c) = &apos;Potash&apos; , TEXT(30 + PMC_CPQ_ApprovalRequired__c ),

IF(TEXT(SBQQ__Product__r.PMC_CPQ_MaterialGroup__c) = &apos;Phosphate&apos; , TEXT(40 + PMC_CPQ_ApprovalRequired__c ), &apos;00&apos; ) )))</formula>
        <label>Material Group</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_MinimumPriceAdjustment__c</fullName>
        <label>Minimum Price Adjustment</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_MoT_Service_Type__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT( PMC_CPQ_ModeofTransportation__c)+ TEXT(PMC_CPQ_Incoterms1__c )</formula>
        <label>MoT &amp; Service Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ModeofTransportation__c</fullName>
        <description>This field is created  to check The mode of transportation</description>
        <inlineHelpText>Select the appropriate mode from the available options to track and manage logistics effectively</inlineHelpText>
        <label>MoT</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <controllingField>PMC_CPQ_QuoteRecordType__c</controllingField>
            <restricted>true</restricted>
            <valueSetName>PMC_CPQ_MoT</valueSetName>
            <valueSettings>
                <controllingFieldValue>Domestic NA</controllingFieldValue>
                <valueName>Barge</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Domestic NA</controllingFieldValue>
                <controllingFieldValue>International</controllingFieldValue>
                <controllingFieldValue>International Distribution</controllingFieldValue>
                <valueName>Rail</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Domestic NA</controllingFieldValue>
                <controllingFieldValue>Domestic SA</controllingFieldValue>
                <controllingFieldValue>International</controllingFieldValue>
                <valueName>Truck</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Domestic NA</controllingFieldValue>
                <controllingFieldValue>International</controllingFieldValue>
                <controllingFieldValue>International Distribution</controllingFieldValue>
                <valueName>Vessel</valueName>
            </valueSettings>
        </valueSet>
    </fields>
