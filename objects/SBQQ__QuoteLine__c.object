    <fields>
        <fullName>PMC_BR_CLM_SSPProduct__c</fullName>
        <description>To check if the product is from the list</description>
        <externalId>false</externalId>
        <formula>IF(OR(
   CONTAINS( SBQQ__Product__r.StockKeepingUnit, &quot;1017214&quot;),
   CONTAINS(SBQQ__Product__r.StockKeepingUnit, &quot;1017367&quot;),
   CONTAINS(SBQQ__Product__r.StockKeepingUnit, &quot;1017275&quot;),
   CONTAINS(SBQQ__Product__r.StockKeepingUnit, &quot;1021533&quot;),
   CONTAINS(SBQQ__Product__r.StockKeepingUnit, &quot;1021418&quot;),
   CONTAINS(SBQQ__Product__r.StockKeepingUnit, &quot;1017351&quot;),
   CONTAINS(SBQQ__Product__r.StockKeepingUnit, &quot;1017295&quot;),
   CONTAINS(SBQQ__Product__r.StockKeepingUnit, &quot;1020230&quot;),
   CONTAINS(SBQQ__Product__r.StockKeepingUnit, &quot;1017812&quot;),
   CONTAINS(SBQQ__Product__r.StockKeepingUnit, &quot;001000031&quot;)
),0,1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>BR CLM SSP Product</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
