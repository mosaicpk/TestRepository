    <fields>
        <fullName>PMC_CPQ_PermittedQuantity__c</fullName>
        <externalId>false</externalId>
        <formula>IF( (ROUND((PMC_CPQ_OriginalQuantity__c *  PMC_CPQ_PercentageOfQuantity__c),0) &gt; SBQQ__Quantity__c )&amp;&amp;  SBQQ__Quote__r.PMC_CPQ_QuoteApproved__c ,0,1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Permitted Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
