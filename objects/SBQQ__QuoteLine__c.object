        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Domestic NA</fullName>
                    <default>false</default>
                    <label>Domestic NA</label>
                </value>
                <value>
                    <fullName>Domestic SA</fullName>
                    <default>false</default>
                    <label>Domestic SA</label>
                </value>
                <value>
                    <fullName>International</fullName>
                    <default>false</default>
                    <label>International</label>
                </value>
                <value>
                    <fullName>International Distribution</fullName>
                    <default>false</default>
                    <label>International Distribution</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
