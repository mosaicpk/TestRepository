        <masterLabel>Preview Approval</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <url>/apex/sbaa__PreviewApprovals?Id={!SBQQ__QuoteLine__c.Id}</url>
    </webLinks>
    <webLinks>
        <fullName>Recall_Approval</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>Recall Approval</masterLabel>
        <openType>sidebar</openType>
        <page>RecallQuoteLine</page>
        <protected>false</protected>
    </webLinks>
    <webLinks>
        <fullName>SBQQ__CalculateQuoteFromQuoteLine</fullName>
        <availability>online</availability>
        <description>Calculates and saves the quote.</description>
        <displayType>button</displayType>
        <linkType>page</linkType>
        <masterLabel>Calculate Quote</masterLabel>
        <openType>replace</openType>
        <page>SBQQ__CalculateQuoteFromQuoteLine</page>
        <protected>false</protected>
    </webLinks>
    <webLinks>
        <fullName>Submit_for_Approval</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>Submit for Approval</masterLabel>
        <openType>sidebar</openType>
        <page>SubmitQuoteLine</page>
        <protected>false</protected>
    </webLinks>
</CustomObject>
