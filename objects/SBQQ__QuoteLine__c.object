        <formula>CASE(SBQQ__Quote__r.RecordType.Name, &quot;Domestic NA&quot;, &quot;Domestic NA&quot;, &quot;Domestic SA&quot;, &quot;Domestic SA&quot;,&quot;International&quot;,&quot;International&quot;,&quot;International Distribution&quot;,&quot;International Distribution&quot;,&quot;&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Quote Record Type Name Ext</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_QuoteRecordType__c</fullName>
        <description>This picklist will hold the record type of Quote and will be used as a controlling field for many other picklist fields.</description>
