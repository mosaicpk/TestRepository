                <field>$Source.PMC_CPQ_ProductLocationLocationBackend__c</field>
                <operation>equals</operation>
                <valueField>Location.PMC_CPQ_ExpeditionPoint__c</valueField>
            </filterItems>
            <filterItems>
                <field>Location.RecordTypeId</field>
                <operation>equals</operation>
                <value>Expedition Point</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Location</referenceTo>
