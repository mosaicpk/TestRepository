    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>FreightPriceGreaterthan0</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
SBQQ__Quote__r.PMC_CPQ_QuoteOrigin__c!=&apos;DH Request&apos;,
ISPICKVAL(PMC_CPQ_Incoterms1__c,&apos;CIF&apos;),
ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_Region__c,&apos;Brazil&apos;),
NOT(OR(
ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_QuoteRecordSubType__c,&apos;B2B - Fertilizer&apos;),
ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_QuoteRecordSubType__c,&apos;B2B - Potash&apos;),
ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_QuoteRecordSubType__c,&apos;B2C - Fertilizer&apos;)
))
,
OR(ISBLANK(PMC_CPQ_EstFreightPrice__c),PMC_CPQ_EstFreightPrice__c&lt;=0),
ISBLANK(SBQQ__Quote__r.PMC_CPQ_LegacyQuoteID__c),
NOT(ISPICKVAL( SBQQ__Quote__r.SBQQ__Type__c ,&apos;Amendment&apos;))

)</errorConditionFormula>
        <errorDisplayField>PMC_CPQ_EstFreightPrice__c</errorDisplayField>
        <errorMessage>Freight value is required and should be more than 0</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FreightPriceGreaterthan01</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
SBQQ__Quote__r.PMC_CPQ_QuoteOrigin__c!=&apos;DH Request&apos;,
ISPICKVAL(PMC_CPQ_Incoterms1__c,&apos;CIF&apos;),
ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_Region__c,&apos;Brazil&apos;),
ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_QuoteRecordSubType__c,&apos;B2C - Fertilizer&apos;),
OR(PMC_CPQ_VCOQuotation__c!=TRUE,ISBLANK(PMC_CPQ_VCOIntercompanyPlant__c),PMC_CPQ_VCOIntercompanyPlant__c=NULL),
OR(ISBLANK(PMC_CPQ_EstFreightPrice__c),PMC_CPQ_EstFreightPrice__c&lt;=0),ISBLANK(SBQQ__Quote__r.PMC_CPQ_LegacyQuoteID__c),
NOT(ISPICKVAL( SBQQ__Quote__r.SBQQ__Type__c ,&apos;Amendment&apos;))
)</errorConditionFormula>
        <errorDisplayField>PMC_CPQ_EstFreightPrice__c</errorDisplayField>
        <errorMessage>Freight value is required and should be more than 0</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IF_Field_Blank_Test</fullName>
        <active>false</active>
        <errorConditionFormula>OR(ISNULL(TEXT( PMC_CPQ_UnitofMeasure__c ) ), ISBLANK(TEXT( PMC_CPQ_UnitofMeasure__c ) ))</errorConditionFormula>
        <errorDisplayField>PMC_CPQ_ModeofTransportation__c</errorDisplayField>
        <errorMessage>Test message</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CLM_BusinessTypeCCC</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
TEXT( SBQQ__Quote__r.PMC_CPQ_QuoteRecordSubType__c )  = &apos;Feed&apos;,
TEXT( PMC_CPQ_ContractType__c )  = &apos;CCC&apos;
)</errorConditionFormula>
        <errorMessage>Error!!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CLM_CCCValidation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
TEXT( PMC_CPQ_ContractType__c )   = &apos;CCC&apos;,
OR(
 SBQQ__Quantity__c &gt; 500,
 TEXT( PMC_CPQ_ModeofTransportation__c ) &lt;&gt; &apos;Truck&apos;,
 TEXT( SBQQ__Quote__r.PMC_CPQ_QuoteRecordSubType__c )  = &apos;Feed&apos;
) 
)</errorConditionFormula>
        <errorMessage>Error!!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_CommissionandCommissonAgent</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(PMC_CPQ_QuoteRegionExtractor__c=&apos;North America&apos;),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
ISBLANK( PMC_CPQ_Commission__c ),
NOT(ISBLANK(  SBQQ__Quote__r.PMC_CPQ_CommissionAgent__c )),
OR(
NOT(ISNEW()),
AND(ISNEW(),ISBLANK(SBQQ__Quote__r.PMC_CPQ_LegacyQuoteID__c))
)
)</errorConditionFormula>
        <errorMessage>Please make sure the Commission value is set for all the line items, as Commission Agent is set at Quote</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_ContractTypeRequired</fullName>
        <active>true</active>
        <description>This rule will trigger when Contract Type is not populated.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT( CONTAINS($Profile.Name,&apos;Digital Hub&apos;)),
ISBLANK( TEXT( PMC_CPQ_ContractType__c )),
OR(
ISBLANK(PMC_CPQ_OpportunityLineItemId__c ),
AND(NOT(ISBLANK(PMC_CPQ_OpportunityLineItemId__c )),NOT(ISNEW()))),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c ))
)</errorConditionFormula>
        <errorMessage>Contract Type is Required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_CropTypeRequiredForSA</fullName>
        <active>true</active>
        <description>This rule will fire when Crop Type is blank for an SA quote line.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT( CONTAINS($Profile.Name,&apos;Digital Hub&apos;)),
ISBLANK( TEXT(PMC_CPQ_CropType__c )),
OR(
ISBLANK(PMC_CPQ_OpportunityLineItemId__c ),
AND(NOT(ISBLANK(PMC_CPQ_OpportunityLineItemId__c )),NOT(ISNEW()))),
NOT( PMC_CPQ_QuoteRegionExtractor__c = &apos;North America&apos;),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c ))
)</errorConditionFormula>
        <errorMessage>Crop Type is Required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_DeliveryDateMandatory</fullName>
        <active>true</active>
        <description>Delivery start date and delivery end date is mandatory for Brazil region</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &apos;Digital Hub&apos;)),
OR(
ISBLANK( PMC_CPQ_DeliveryStartDate__c ),
ISBLANK( PMC_CPQ_DeliveryEndDate__c )
),
OR(
ISBLANK(PMC_CPQ_OpportunityLineItemId__c ),
AND(NOT(ISBLANK(PMC_CPQ_OpportunityLineItemId__c )),NOT(ISNEW()))),
ISPICKVAL( SBQQ__Quote__r.PMC_CPQ_Region__c ,&quot;Brazil&quot;),
OR(
NOT(ISNEW()),
AND(ISNEW(),ISBLANK(SBQQ__Quote__r.PMC_CPQ_LegacyQuoteID__c))
),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c ))
)</errorConditionFormula>
        <errorMessage>Delivery Start Date and Delivery End Date is Required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_DeliveryStartDateBeforeEndDate</fullName>
        <active>false</active>
        <description>Delivery End Date should not be before the Delivery Start Date.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT( CONTAINS($Profile.Name,&apos;Digital Hub&apos;)),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
OR(
IF(NOT(ISBLANK( PMC_CPQ_DeliveryStartDate__c )),IF(ISBLANK( PMC_CPQ_DeliveryEndDate__c ),true,false),false),
IF(NOT(ISBLANK( PMC_CPQ_DeliveryEndDate__c )),IF(ISBLANK( PMC_CPQ_DeliveryStartDate__c ),true,false),false),
IF(AND(NOT(ISBLANK( PMC_CPQ_DeliveryStartDate__c )),NOT(ISBLANK( PMC_CPQ_DeliveryEndDate__c ))), IF(PMC_CPQ_DeliveryEndDate__c-PMC_CPQ_DeliveryStartDate__c&lt;0,true,false),false)
)
)</errorConditionFormula>
        <errorMessage>Delivery End Date should not be before the Delivery Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_DeliveryStartDateValidation</fullName>
        <active>false</active>
        <description>In both create and update Delivery Start Date cannot be in the past</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
$Profile.Name &lt;&gt; &apos;Product Manager&apos;,
NOT( CONTAINS($Profile.Name,&apos;Digital Hub&apos;)),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
PMC_CPQ_DeliveryStartDate__c &lt; TODAY(),
TEXT(SBQQ__Quote__r.SBQQ__Status__c) = &apos;Draft&apos;,
NOT( TEXT( SBQQ__Quote__r.SBQQ__Type__c )=&quot;Amendment&quot;),
NOT( TEXT( SBQQ__Quote__r.SBQQ__Type__c )=&quot;Renewal&quot;)
)</errorConditionFormula>
        <errorMessage>Delivery Start Date cannot be in the past.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_FPDToggleSwitch</fullName>
        <active>true</active>
        <description>To Prevent Account Managers from creating FPD Quotes when FPD Toggle Switch is OFF</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
$CustomMetadata.PMC_CPQ_FPDToggleSwitch__mdt.PMC_CPQ_FPDQuoting.PMC_CPQ_Switch__c =False, 
 OR( ISPICKVAL(PMC_CPQ_QuoteRecordType__c,&apos;Domestic NA&apos;),ISPICKVAL(PMC_CPQ_QuoteRecordType__c,&apos;International&apos;)), 
OR(ISPICKVAL(PMC_CPQ_ContractType__c,&apos;FPD&apos;),ISPICKVAL(PMC_CPQ_ContractType__c,&apos;FPD Ex-Space&apos;)) 
)</errorConditionFormula>
        <errorMessage>The ability to Quote FPDs is currently on hold. For more information, please reach out to a Product Manager</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_IncotermCPTValidation</fullName>
        <active>true</active>
        <description>Incoterms CPT is applicable only for North America if the Mode of transport is selected as Rail or Truck</description>
        <errorConditionFormula>AND(
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
ISPICKVAL(PMC_CPQ_Incoterms1__c ,&quot;CPT&quot;),
NOT(ISPICKVAL( PMC_CPQ_ModeofTransportation__c ,&quot;Rail&quot;)),
NOT(ISPICKVAL( PMC_CPQ_ModeofTransportation__c ,&quot;Truck&quot;)),
ISPICKVAL( SBQQ__Quote__r.PMC_CPQ_Region__c ,&quot;North America&quot;)
)</errorConditionFormula>
        <errorMessage>Incoterms CPT is only Applicable for MOT Rail and Truck</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_NonVCOQuoteShipTo</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
OR(
ISBLANK(PMC_CPQ_OpportunityLineItemId__c ),
AND(NOT(ISBLANK(PMC_CPQ_OpportunityLineItemId__c )),NOT(ISNEW()))
),
NOT(PMC_CPQ_VCOQuotation__c) ,
NOT(PMC_CPQ_QuoteRegionExtractor__c=&apos;North America&apos;),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
ISBLANK( PMC_CPQ_SoldToShipToJunction__c )
)</errorConditionFormula>
        <errorMessage>Please kindly populate the Ship To field for the Non VCO Quote Lines</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_PackTypeMandatory</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &apos;Digital Hub&apos;)),
ISPICKVAL( PMC_CPQ_PackType__c , &apos;&apos;),
OR(
ISBLANK(PMC_CPQ_OpportunityLineItemId__c ),
AND(NOT(ISBLANK(PMC_CPQ_OpportunityLineItemId__c )),NOT(ISNEW()))),
ISPICKVAL( SBQQ__Quote__r.PMC_CPQ_Region__c ,&quot;Brazil&quot;),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c ))
)</errorConditionFormula>
        <errorMessage>Pack Type is Mandatory</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_PackageTypeMandatory</fullName>
        <active>true</active>
        <description>Package Type on Quote Line is mandatory if Pack type is choose as Packed for brazil</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &apos;Digital Hub&apos;)),
ISPICKVAL( PMC_CPQ_PackType__c , &apos;Packed&apos;),  
ISPICKVAL(PMC_CPQ_PackageType__c,&quot;&quot;),
OR(
ISBLANK(PMC_CPQ_OpportunityLineItemId__c ),
AND(NOT(ISBLANK(PMC_CPQ_OpportunityLineItemId__c )),NOT(ISNEW()))),
ISPICKVAL( SBQQ__Quote__r.PMC_CPQ_Region__c ,&quot;Brazil&quot;),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c ))
)</errorConditionFormula>
        <errorMessage>Packaging type is mandatory for Pack type of Packed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_PaymentDateInPast</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISBLANK(PMC_CPQ_PaymentDate__c )),
PMC_CPQ_PaymentDate__c &lt; TODAY(),
NOT(ISCLONE()),
NOT(ISPICKVAL( SBQQ__Quote__r.SBQQ__Type__c ,&apos;Amendment&apos;)),
ISPICKVAL($User.PMC_CPQ_SalesRegion__c, &apos;Brazil&apos;),
ISBLANK(SBQQ__Quote__r.PMC_CPQ_LegacyQuoteID__c)
)</errorConditionFormula>
        <errorMessage>Payment Date cannot be in the past.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_PaymentDateValidation</fullName>
        <active>true</active>
        <errorConditionFormula>AND( NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
OR(
CONTAINS(TEXT(PMC_CPQ_PaymentTerms__c), &apos;Prepayment&apos;),
CONTAINS(TEXT(PMC_CPQ_PaymentTerms__c), &apos;Fixed Date&apos;)
),
OR(
ISBLANK(PMC_CPQ_PaymentDate__c),
AND(
NOT(ISBLANK(PMC_CPQ_PaymentDate__c)),
PMC_CPQ_PaymentDate__c &lt; TODAY()
)
),
AND(
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
ISPICKVAL( SBQQ__Quote__r.PMC_CPQ_Region__c , &apos;Brazil&apos;)
),
NOT(ISCLONE()),
NOT(ISPICKVAL( SBQQ__Quote__r.SBQQ__Type__c ,&apos;Amendment&apos;)),
ISBLANK(SBQQ__Quote__r.PMC_CPQ_LegacyQuoteID__c)
)</errorConditionFormula>
        <errorMessage>Payment Date is required when the Payment Method selected is &apos;Prepayment&apos; or &apos;Fixed Date&apos;. Payment Date must not be in the past</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_PrePayPaymentDateValidation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
    AND(
            $Profile.Name &lt;&gt; &apos;System Administrator&apos;,
            $Profile.Name &lt;&gt; &apos;API Only profile&apos;,
            ISPICKVAL($User.LocaleSidKey, &apos;pt_BR&apos;)
    ),
    AND(
        NOT(ISBLANK(PMC_CPQ_PaymentDate__c)),
        OR(
                WEEKDAY(PMC_CPQ_PaymentDate__c) = 1,
                WEEKDAY(PMC_CPQ_PaymentDate__c) = 7
        )
    ),
OR(
NOT(ISNEW()),
AND(ISNEW(),ISBLANK(SBQQ__Quote__r.PMC_CPQ_LegacyQuoteID__c))
)
)</errorConditionFormula>
        <errorMessage>Please ensure that the Payment Date falls on a business day</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_PriceByDateMandatory</fullName>
        <active>true</active>
        <description>Price By Date is mandatory for Contract type of FPD in North America Region</description>
        <errorConditionFormula>AND(
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_Region__c,&quot;North America&quot; ),
ISPICKVAL( PMC_CPQ_ContractType__c , &quot;FPD&quot;),
ISBLANK(  PMC_CPQ_PriceByDate__c  )
)</errorConditionFormula>
        <errorMessage>Price By Date is required for FPD Contract Type</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_PriceDueDateMandatory</fullName>
        <active>false</active>
        <description>Incorrect validation rule to be deleted</description>
        <errorConditionFormula>AND(
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_Region__c,&quot;North America&quot; ),
 ISPICKVAL( PMC_CPQ_ContractType__c , &quot;FPD&quot;),
ISBLANK( PMC_CPQ_PriceDueDate__c ) 
)</errorConditionFormula>
        <errorMessage>Price due date is mandatory for FPD contract</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_QuoteSubmittedForApproval</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
ISPICKVAL(   SBQQ__Quote__r.ApprovalStatus__c, &quot;Pending&quot;)
 
)</errorConditionFormula>
        <errorMessage>You may not edit a Quote once it has been submitted for approval. If you wish to make any changes, click the &apos;Recall Approvals&apos; button on the Quote detail page</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_RejectionValidation</fullName>
        <active>true</active>
        <description>If the Final Price Per Tonne below the floor price. then Validation error will occur</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
NOT(ISCHANGED( PMC_CPQ_FlowVRBypassToggle__c )),
NOT( $CustomMetadata.PMC_CPQ_BypassQuoteFloorPriceValidat__mdt.PMC_CPQ_BypassRecord.PMC_CPQ_BypassFloorPriceValidation__c ),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
PMC_CPQ_QuoteRegionExtractor__c= &apos;Brazil&apos;,
PMC_CPQ_ListPriceDiscountMarkup__c&lt;PMC_CPQ_PriceGuidanceFloor__c )</errorConditionFormula>
        <errorMessage>The discount entered is too large. Please adjust the discount so that the price is greater than or equal to the Floor Price</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_RestrictAMonApprovedandAccepted</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT( CONTAINS($Profile.Name,&apos;Digital Hub&apos;)),
NOT(ISCHANGED(   PMC_CPQ_FlowVRBypassToggle__c )),
OR( ISPICKVAL( SBQQ__Quote__r.SBQQ__Status__c , &quot;Approved&quot;) , 
    ISPICKVAL(SBQQ__Quote__r.SBQQ__Status__c, &quot;Accepted&quot;),
	ISPICKVAL(SBQQ__Quote__r.SBQQ__Status__c, &quot;Presented&quot;)
  )

)</errorConditionFormula>
        <errorMessage>You can only edit the Quote Line when the Quote is in the Draft Status. Update the Quote Status to Draft to continue editing</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_SalesOrgNotBlank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
Error_Sales_Org__c
)</errorConditionFormula>
        <errorMessage>You have one or more Inactive, Restricted or Blocked product. Please remove all of them to proceed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_ShippingTypeMandatory</fullName>
        <active>true</active>
        <description>Shipping type is mandatory for brazil region if the product location name starts with PORTO -</description>
        <errorConditionFormula>AND(
AND(
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;
),
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_Region__c,&quot;Brazil&quot; ),
BEGINS((PMC_CPQ_ProductLocation__r.Name), &apos;Porto - &apos;),
ISBLANK( PMC_CPQ_ExpeditionPoint__c )
)</errorConditionFormula>
        <errorMessage>Shipping Type is Mandatory for Porto Locations</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_VCOQuoteDeliveryRegion</fullName>
        <active>false</active>
        <description>Marked for deletion not in use</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name =&apos;Sales User&apos;,
PMC_CPQ_VCOQuotation__c ,
PMC_CPQ_QuoteRegionExtractor__c=&apos;Brazil&apos;,
ISPICKVAL( PMC_CPQ_VCODeliveryRegion__c , &apos;&apos;)
)</errorConditionFormula>
        <errorMessage>Please populate the Delivery Region for the respective VCO Quote Lines</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_ValidateCIF</fullName>
        <active>false</active>
        <description>Validate if the field PMC_CPQ_Incoterms1__c = &apos;CIF&apos; to require to inform the PMC_CPQ_ContractShippingInstructions__c on the parent Quote</description>
        <errorConditionFormula>ISPICKVAL( SBQQ__Quote__r.PMC_CPQ_Region__c , &quot;Brazil&quot;)&amp;&amp;
ISPICKVAL(PMC_CPQ_Incoterms1__c, &quot;CIF&quot;) &amp;&amp; 
ISBLANK(SBQQ__Quote__r.PMC_CPQ_ContractShippingInstructions__c)</errorConditionFormula>
        <errorDisplayField>PMC_CPQ_Incoterms1__c</errorDisplayField>
        <errorMessage>Please inform the Shipping Instructions on the Quote before creating a Quote Line with Incoterms = CIF</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_Quantity_Percentage</fullName>
        <active>true</active>
        <errorConditionFormula>OR( PMC_CPQ_PercentageOfQuantity__c &lt; 0, PMC_CPQ_PercentageOfQuantity__c &gt; 1)</errorConditionFormula>
        <errorMessage>Percentage must be between 0 and 100</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Additional_discount_percent_or_amount</fullName>
        <active>true</active>
        <description>Validates additional discount is specified as a percentage or absolute amount but not both.</description>
        <errorConditionFormula>AND(NOT(ISBLANK(SBQQ__Discount__c)), NOT(ISBLANK(SBQQ__AdditionalDiscountAmount__c)),NOT(SBQQ__Incomplete__c))</errorConditionFormula>
        <errorMessage>You may not specify additional discount as both percentage and absolute amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Invalid_Subscription_Term</fullName>
        <active>true</active>
        <description>Validates that subscription term is positive</description>
        <errorConditionFormula>IF( AND( NOT(ISNULL(SBQQ__SubscriptionTerm__c)), SBQQ__SubscriptionTerm__c &lt;= 0), TRUE, null)</errorConditionFormula>
        <errorMessage>The subscription term must be a positive number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Markup_percent_or_amount</fullName>
        <active>true</active>
        <description>Validates markup is specified as a percentage or absolute amount but not both.</description>
        <errorConditionFormula>AND(NOT(ISBLANK(SBQQ__MarkupRate__c)), NOT(ISBLANK(SBQQ__MarkupAmount__c)),NOT(SBQQ__Incomplete__c))</errorConditionFormula>
        <errorMessage>You may not specify markup as both percentage and absolute amount.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__RecurringChargeTypeMustHaveBillingType</fullName>
        <active>true</active>
        <description>When Charge Type is Recurring, a Billing Type must be selected.</description>
        <errorConditionFormula>AND(ISPICKVAL(SBQQ__ChargeType__c, &apos;Recurring&apos;), ISPICKVAL(SBQQ__BillingType__c, &apos;&apos;))</errorConditionFormula>
        <errorDisplayField>SBQQ__BillingType__c</errorDisplayField>
        <errorMessage>When Charge Type is Recurring, a Billing Type must be selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Validate_billing_frequency</fullName>
        <active>true</active>
        <description>When Charge Type is One-Time, Billing Frequency must not be selected.</description>
        <errorConditionFormula>AND(ISPICKVAL(SBQQ__ChargeType__c, &apos;One-Time&apos;), NOT(ISPICKVAL(SBQQ__BillingFrequency__c, &apos;&apos;)))</errorConditionFormula>
        <errorDisplayField>SBQQ__BillingFrequency__c</errorDisplayField>
        <errorMessage>When Charge Type is One-Time, a Billing Frequency value cannot be selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Validate_billing_type</fullName>
        <active>true</active>
        <description>When Charge Type is One-Time or Usage, a Billing Type cannot be selected.</description>
        <errorConditionFormula>OR( 
AND(ISPICKVAL(SBQQ__ChargeType__c, &apos;One-Time&apos;), NOT(ISPICKVAL(SBQQ__BillingType__c, &quot;&quot;))), 
AND(ISPICKVAL(SBQQ__ChargeType__c, &apos;Usage&apos;), NOT(ISPICKVAL(SBQQ__BillingType__c, &quot;&quot;))))</errorConditionFormula>
        <errorDisplayField>SBQQ__BillingType__c</errorDisplayField>
        <errorMessage>When Charge Type is One-Time or Usage, a Billing Type value cannot be selected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Test_validation</fullName>
        <active>false</active>
        <errorConditionFormula>OR(
		  ISCHANGED(PMC_CPQ_VCOQuotation__c),
				ISCHANGED(PMC_CPQ_AdvanceBilling__c),
    ISCHANGED(PMC_SS_UnitOfMeasure__c),
				ISCHANGED(PMC_CPQ_SoldToShipToJunction__c),
    ISCHANGED(PMC_CPQ_Discount__c),
    ISCHANGED(PMC_CPQ_DeliveryStartDate__c),
				ISCHANGED(PMC_CPQ_DeliveryEndDate__c),
    ISCHANGED(PMC_CPQ_CropType__c),
				ISCHANGED(PMC_CPQ_PaymentTerms__c),
    ISCHANGED(SBQQ__Quantity__c),
				ISCHANGED(PMC_CPQ_LinePONumber__c),
				ISCHANGED(PMC_CPQ_PaymentDate__c),
    ISCHANGED(PMC_CPQ_PriceBookValue__c)
				 )</errorConditionFormula>
        <errorDisplayField>PMC_CPQ_PercentageOfQuantity__c</errorDisplayField>
        <errorMessage>User cannot change the Accepted quote Field Value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>length10</fullName>
        <active>false</active>
        <errorConditionFormula>LEN(PMC_DH_QuoteID__c)!=10</errorConditionFormula>
        <errorDisplayField>PMC_DH_QuoteID__c</errorDisplayField>
        <errorMessage>QuoteID length should be equals to 10!</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
