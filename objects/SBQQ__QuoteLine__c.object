    <fields>
        <fullName>PMC_CPQ_Allocation__c</fullName>
        <description>This field is created  to check the allocation data of quote lines</description>
        <externalId>false</externalId>
        <label>Allocation (MTN)</label>
        <precision>12</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ApprovalRequired__c</fullName>
        <externalId>false</externalId>
        <formula>IF( (ISPICKVAL(PMC_CPQ_ContractType__c, &apos;FPD&apos;)),0,
IF(
AND(
SBQQ__Quantity__c &gt;= 10000,
PMC_CPQ_NetUnitPrice__c&gt;=PMC_CPQ_PriceGuidanceTarget__c,
PMC_CPQ_NetUnitPrice__c&lt;= PMC_CPQ_PriceGuidanceCeiling__c
), 2,
IF(
AND(
SBQQ__Quantity__c &lt; 10000,
PMC_CPQ_NetUnitPrice__c &gt;=PMC_CPQ_PriceGuidanceFloor__c,
PMC_CPQ_NetUnitPrice__c&lt; PMC_CPQ_PriceGuidanceTarget__c
), 3,
IF(
AND(
SBQQ__Quantity__c &gt;= 10000,
PMC_CPQ_NetUnitPrice__c&gt;= PMC_CPQ_PriceGuidanceFloor__c,
PMC_CPQ_NetUnitPrice__c&lt; PMC_CPQ_PriceGuidanceTarget__c
), 4,
IF(
AND(
SBQQ__Quantity__c &lt; 10000,
PMC_CPQ_NetUnitPrice__c&lt; PMC_CPQ_PriceGuidanceFloor__c
), 5,
IF(
AND(
SBQQ__Quantity__c &gt;= 10000,
PMC_CPQ_NetUnitPrice__c&lt; PMC_CPQ_PriceGuidanceFloor__c
), 6,0

))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Approval Required</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ApprovalRule__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This field is created as the part of Approval setup.</description>
        <label>Approval Rule</label>
        <referenceTo>sbaa__ApprovalRule__c</referenceTo>
        <relationshipLabel>Quote Lines</relationshipLabel>
        <relationshipName>Quote_Lines</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ApprovalType__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
   AND(
        SBQQ__Quantity__c &gt;= 10000,
        SBQQ__ListPrice__c -  PMC_CPQ_Discount__c &gt;   PMC_CPQ_PriceGuidanceTarget__c,
        SBQQ__ListPrice__c -  PMC_CPQ_Discount__c &lt;=   PMC_CPQ_PriceGuidanceCeiling__c
       ),  $Label.PMC_CPQ_NAApprovalRow2,
IF(
   AND(
        SBQQ__Quantity__c &lt; 10000,
        SBQQ__ListPrice__c -  PMC_CPQ_Discount__c &gt;   PMC_CPQ_PriceGuidanceFloor__c,
        SBQQ__ListPrice__c -  PMC_CPQ_Discount__c &lt;=   PMC_CPQ_PriceGuidanceTarget__c  
       ),   $Label.PMC_CPQ_ForNADiscountApprovalRow3T2 ,
IF(
   AND(
        SBQQ__Quantity__c &gt;= 10000,
        SBQQ__ListPrice__c -  PMC_CPQ_Discount__c &gt;   PMC_CPQ_PriceGuidanceFloor__c,
        SBQQ__ListPrice__c -  PMC_CPQ_Discount__c &lt;=   PMC_CPQ_PriceGuidanceTarget__c  
       ),    $Label.PMC_CPQ_ForNADiscountApprovalRow4 ,
IF(
   AND(
        SBQQ__Quantity__c &lt; 10000,
        SBQQ__ListPrice__c -  PMC_CPQ_Discount__c &lt; PMC_CPQ_PriceGuidanceFloor__c 
       ), $Label.PMC_CPQ_ForNADiscountApprovalRow5,
IF(
   AND(
        SBQQ__Quantity__c &gt;= 10000,
        SBQQ__ListPrice__c -  PMC_CPQ_Discount__c &lt; PMC_CPQ_PriceGuidanceFloor__c 
       ),  $Label.PMC_CPQ_ForNADiscountApprovalRow6 ,&apos;&apos;
)))))</formula>
        <label>Approval Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
