    <fields>
        <fullName>TestDeleteformula__c</fullName>
        <formula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
SBQQ__Quote__r.PMC_CPQ_QuoteOrigin__c!=&apos;DH Request&apos;,
NOT(ISPICKVAL(SBQQ__Quote__r.SBQQ__Type__c,&apos;Amendment&apos;)),
ISPICKVAL(PMC_CPQ_Incoterms1__c,&apos;CIF&apos;),
ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_Region__c,&apos;Brazil&apos;),
NOT(OR(
     ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_QuoteRecordSubType__c,&apos;B2B - Fertilizer&apos;),
	 ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_QuoteRecordSubType__c,&apos;B2B - Potash&apos;),
	 AND(
	     NOT(ISPICKVAL(SBQQ__Quote__r.PMC_CPQ_QuoteRecordSubType__c,&apos;B2C - Fertilizer&apos;)),
		 NOT(PMC_CPQ_VCOQuotation__c=TRUE),
		 NOT(PMC_CPQ_VCOIntercompanyPlant__c!=NULL)
	 )
   )
),
OR(ISBLANK(PMC_CPQ_EstFreightPrice__c),PMC_CPQ_EstFreightPrice__c&lt;=0)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>TestDeleteformula</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Test_V_Change_in_Qty__c</fullName>
        <defaultValue>0</defaultValue>
        <description>DO NOT USE</description>
        <externalId>false</externalId>
        <label>Test V Change in Qty</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
