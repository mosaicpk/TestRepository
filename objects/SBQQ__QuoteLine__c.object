    <fields>
        <fullName>PMC_CPQ_NALineTotalPriceFormula__c</fullName>
        <formula>(SBQQ__ListPrice__c + PMC_CPQ_Discount__c + PMC_CPQ_VolumeDiscount__c + PMC_CPQ_EstFreightPrice__c)* SBQQ__EffectiveQuantity__c</formula>
