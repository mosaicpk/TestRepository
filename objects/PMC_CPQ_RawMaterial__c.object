    <fields>
        <fullName>PMC_CPQ_Account__c</fullName>
        <description>This field is to show the Account associated with the record.</description>
        <externalId>false</externalId>
        <formula>PMC_CPQ_Quote__r.SBQQ__Account__r.Name</formula>
        <label>Account</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ListCFR__c</fullName>
        <description>This field is to store the List CFR amount.</description>
        <externalId>false</externalId>
        <label>List CFR (USD)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
