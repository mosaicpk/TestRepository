        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>PMC_CPQ_SettingValueNumber__c</fullName>
        <description>This is to store setting values that are in number format.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Setting Value Number</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>PMC CPQ Integration Settings</label>
    <pluralLabel>PMC CPQ Integration Settings</pluralLabel>
    <visibility>Public</visibility>
