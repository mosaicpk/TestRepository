    <fields>
        <fullName>PMC_SS_TotalCost__c</fullName>
        <formula>PMC_SS_DaysOfDemurrage_c__c  *  PMC_SS_CostPerDay__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Cost</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>PMC_SS_TotalScore__c</fullName>
        <description>This field determines the Mosaic Quality Risk Score (MQRS)</description>
        <externalId>false</externalId>
        <formula>CASE(PMC_SS_IncidentFrequency__c, &quot;1st Occurrence&quot;, 1, &quot;2nd Occurrence&quot;, 2, &quot;More than 2 Occurrences&quot;, 3, 0)
+
CASE(PMC_SS_IncidentProbability__c, &quot;Not Likely&quot;, 0, &quot;Likely&quot;, 1, &quot;Very Likely&quot;, 2, 0)
+
CASE(PMC_SS_IncidentSeverity__c, &quot;$0 - $1,000&quot;, 0, &quot;$1,001 - $5,000&quot;, 1, &quot;$5,001 - $15,000&quot;, 2, &quot;$15,001 - $25,000&quot;, 3, &quot;$25,001 - $50,000&quot;, 4, &quot;More than $50,000&quot;, 5, 0)
+
CASE(PMC_SS_CustomerImpact__c, &quot;No impact to customer’s supply / operations / safety / health&quot;, 0, &quot;Minor impact to customer’s supply / operations / safety / health&quot;, 1, &quot;Significant impact to customer’s supply / operations / safety / health&quot;, 3, &quot;Rejection / Loss of Cargo and/or risk of losing a customer&quot;, 5, 0)
+
CASE(PMC_SS_IncidentQuantity__c, &quot;0 – 100 tons&quot;, 0, &quot;100 – 300 tons&quot;, 1, &quot;1000 – 3000 tons&quot;, 3, &quot;Greater than 3000 tons&quot;, 5, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_SS_TotalTonnageImpacted__c</fullName>
        <description>Report the total amount of product that is scrapped, sold at a discount, or otherwise directly impacted by the quality issue.  Total Tonnage Impacted may be all or part of the tons involved in the case</description>
        <externalId>false</externalId>
        <label>Total Tonnage Impacted</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_SS_Total_Cost_to_Satisfy__c</fullName>
        <label>Total Cost to Satisfy</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>PMC_SS_UOM__c</fullName>
        <label>UOM</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>true</sorted>
                <value>
                    <fullName>Each</fullName>
                    <default>false</default>
                    <label>Each</label>
                </value>
                <value>
                    <fullName>Item</fullName>
                    <default>false</default>
                    <label>Item</label>
                </value>
                <value>
                    <fullName>MTN</fullName>
                    <default>false</default>
                    <label>MTN</label>
                </value>
                <value>
                    <fullName>STN</fullName>
                    <default>false</default>
                    <label>STN</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMC_SS_ValidationRuleBypass__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Field to bypass validation rule.</description>
        <label>Validation Rule Bypass</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMC_SS_VehicleId__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>Vehicle Id</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_SS_WeightDelta__c</fullName>
        <externalId>false</externalId>
        <formula>PMC_SS_OriginalWeight__c  -  PMC_SS_CorrectedWeight__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Weight Delta</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
