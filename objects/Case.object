    <fields>
        <fullName>ContactId</fullName>
        <description>States the name of the Case Contact</description>
        <inlineHelpText>This field will only show ACTIVE contacts. Inactive contacts can be accessed from Global Search.</inlineHelpText>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Contact is either inactive or does not exist</errorMessage>
            <filterItems>
                <field>Contact.PMC_SS_Status__c</field>
                <operation>equals</operation>
                <value>Active</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
