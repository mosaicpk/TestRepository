ISPICKVAL( PMC_SS_IssueReason__c ,&apos;Ship Date / Scheduling&apos;),
ISPICKVAL( PMC_SS_IssueReason__c ,&apos;Warehouse&apos;)),
AND(OR(ISPICKVAL( Status , &apos;Closed&apos;),ISPICKVAL( Status , &apos;Closure Pending&apos;)), ISBLANK( PMC_SS_VehicleId__c   )))</errorConditionFormula>
        <errorDisplayField>PMC_SS_VehicleId__c</errorDisplayField>
        <errorMessage>Vehicle Id cannot be empty.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Date_Investigation_For_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    RecordType.Name = &quot;Quality&quot;,
    ISPICKVAL(Status, &quot;Closed&quot;),
    ISBLANK(PMC_SS_Date_Investigation_Sent_to_CS__c)
)</errorConditionFormula>
        <errorDisplayField>PMC_SS_Date_Investigation_Sent_to_CS__c</errorDisplayField>
        <errorMessage>Before closing this case, you must send this investigation to Customer Service. Please indicate the date that you sent the investigation to the team.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Packing_Sent_to_Analysis</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    RecordType.Name = &quot;Quality&quot;,
    ISPICKVAL(Issue_Sub_Reason__c, &quot;Packing&quot;),
    ISBLANK(TEXT(PMC_SS_Packing_Sent_to_Analysis__c))
)</errorConditionFormula>
        <errorDisplayField>PMC_SS_Packing_Sent_to_Analysis__c</errorDisplayField>
        <errorMessage>Please indicate whether the packing was sent for analysis.</errorMessage>
    </validationRules>
