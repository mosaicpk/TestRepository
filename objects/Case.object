    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Duplicate</fullName>
        <active>true</active>
        <errorConditionFormula>PMC_CPQ_DuplicateRecord__c  = True</errorConditionFormula>
        <errorMessage>Duplicate Request created for NPK</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LocationRequired</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
				AND(
								OR(
							    	ISPICKVAL(PMC_SS_AtFaultParty__c, &apos;Plant / Operations&apos;) ,
								    ISPICKVAL(PMC_SS_AtFaultParty__c, &apos;Warehouse&apos;)
				    ),
								 ISBLANK(PMC_SS_Location__c) 
				),
				true,
				false
)</errorConditionFormula>
        <errorDisplayField>PMC_SS_Location__c</errorDisplayField>
        <errorMessage>Location is required when At Fault Party is &apos;Plant / Operations&apos; or &apos;Warehouse&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_DH_StatusNotEditable</fullName>
        <active>false</active>
        <errorConditionFormula>OR(
AND(
CONTAINS( $Profile.Name , &apos;Digital Hub&apos; ) ,
 ISCHANGED( Status ),  
 ISNULL(ClosedDate)
), 
AND(
CONTAINS( $Profile.Name , &apos;Digital Hub&apos; ) ,
 ISCHANGED( Status ),
 ISPICKVAL( PRIORVALUE(Status), &apos;Closed&apos;)&amp;&amp; NOT( ISPICKVAL(Status, &apos;Re-Open&apos;))
)
)</errorConditionFormula>
        <errorMessage>User can&apos;t update the Case Status field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_AccountMangerCannotbeBlank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),NOT(CONTAINS( $Profile.Name , &apos;Digital Hub&apos; )),OR(
ISPICKVAL( PMC_SS_ContractCancellation__c , &apos;Cancellation due to customer death&apos;),
ISPICKVAL( PMC_SS_ContractCancellation__c , &apos;Commercial input error&apos;),
ISPICKVAL( PMC_SS_ContractCancellation__c , &apos;Insufficient loading balance&apos;),
