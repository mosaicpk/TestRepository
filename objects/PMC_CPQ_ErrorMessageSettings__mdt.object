<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>These error messages settings will be applicable for the Get Price Interface.</description>
    <fields>
        <fullName>PMC_CPQ_ConvertedErrorMessage__c</fullName>
        <description>The transformed/converted error message will be displayed here.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Converted Error Message</label>
        <required>false</required>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_RegexExpression__c</fullName>
        <description>The LIKE Expression should be entered here.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Regex Expression</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_SampleErrorMessage__c</fullName>
        <description>This is used to capture a sample of the types of messages that will be covered.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Sample Error Message</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Integration Error Message Settings</label>
    <pluralLabel>PMC_CPQ_IntegrationErrorMessageSettings</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
