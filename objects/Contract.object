    <fields>
        <fullName>DaysBeforeExpiry__c</fullName>
        <externalId>false</externalId>
        <formula>EndDate -  DATEVALUE( NOW() )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>DaysBeforeExpiry</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Description</fullName>
        <trackHistory>true</trackHistory>
    </fields>
    <fields>
        <fullName>EndDate</fullName>
        <trackHistory>true</trackHistory>
    </fields>
    <fields>
        <fullName>Name</fullName>
        <trackHistory>true</trackHistory>
    </fields>
    <fields>
        <fullName>OwnerExpirationNotice</fullName>
        <trackHistory>true</trackHistory>
    </fields>
    <fields>
        <fullName>OwnerId</fullName>
        <trackHistory>true</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PMC_CLM_AmendmentNumber__c</fullName>
        <defaultValue>0</defaultValue>
        <description>This field will store the numerical value representing the number of times this contract has been amended</description>
        <externalId>false</externalId>
        <label>Amendment Number</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CLM_ContractReferenceNumber__c</fullName>
        <externalId>false</externalId>
        <formula>TRIM(SUBSTITUTE( SBQQ__Quote__r.Name ,&quot;Q-&quot;,&quot;&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contract Reference Number</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_AccountManager__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Account Manager</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Contracts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_BillToAccount__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>This field will take only Accounts that are of type Bill To.</description>
        <label>Bill To Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Contracts</relationshipLabel>
        <relationshipName>Contracts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ContractNumberIdentifier__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>This field will store the contract number(AutoNumber) which will be used as an External Id for 066I.</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>true</externalId>
        <label>Contract Number Identifier</label>
        <length>20</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ContractShippingInstructions__c</fullName>
        <description>Shipping Instructions</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>Shipping Instructions</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ContractType__c</fullName>
        <description>This field will be used to indicate the Contract Type wrt to the Mode to Transportation (Rail, Truck, Barge) and FPD/Priced/CCC</description>
        <label>Contract Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Priced Contract Barge</fullName>
                    <default>false</default>
                    <label>Priced Contract Barge</label>
                </value>
                <value>
                    <fullName>Priced Contract Truck</fullName>
                    <default>false</default>
                    <label>Priced Contract Truck</label>
                </value>
                <value>
                    <fullName>Priced Contract Rail</fullName>
                    <default>false</default>
                    <label>Priced Contract Rail</label>
                </value>
                <value>
                    <fullName>FPD Contract Barge</fullName>
                    <default>false</default>
                    <label>FPD Contract Barge</label>
                </value>
                <value>
                    <fullName>FPD Contract Rail</fullName>
                    <default>false</default>
                    <label>FPD Contract Rail</label>
                </value>
                <value>
                    <fullName>FPD Contract Truck</fullName>
                    <default>false</default>
                    <label>FPD Contract Truck</label>
                </value>
                <value>
                    <fullName>CCC Contract Truck</fullName>
                    <default>false</default>
                    <label>CCC Contract Truck</label>
                </value>
                <value>
                    <fullName>Third Party Delivery</fullName>
                    <default>false</default>
                    <label>Third Party Delivery</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMC_CPQ_Contract_Blocked__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If new contract created by Block/Replace Button then this field will be checked</description>
        <label>Contract Blocked</label>
        <trackHistory>true</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_LastPricedDate__c</fullName>
