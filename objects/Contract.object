    <validationRules>
        <fullName>PMC_CLM_ContractRenewalValidation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
SBQQ__RenewalQuoted__c = true,
EndDate - DATEVALUE(NOW())&gt;30

)</errorConditionFormula>
        <errorMessage>Renewal Quote can be created only before 30 or less days from Contract End Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_SSASSREditAccessRestriction</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT( ISCHANGED( SBQQ__RenewalForecast__c ) ),
NOT( ISCHANGED(  SBQQ__RenewalQuoted__c ) )
)</errorConditionFormula>
        <errorMessage>You Don&apos;t have edit access on contract</errorMessage>
    </validationRules>
