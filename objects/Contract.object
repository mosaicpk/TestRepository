        </displayedFields>
        <displayedFields>
            <field>EndDate</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <label>Active Contract Lookup</label>
    </fieldSets>
