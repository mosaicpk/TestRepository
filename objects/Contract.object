    <compactLayoutAssignment>PMC_CPQ_ContractCompactLayout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>PMC_CPQ_ContractCompactLayout</fullName>
        <fields>ContractNumber</fields>
        <fields>AccountId</fields>
        <fields>StartDate</fields>
        <fields>EndDate</fields>
        <fields>Status</fields>
        <fields>PMC_CPQ_PO__c</fields>
        <label>Contract Compact Layout</label>
    </compactLayouts>
    <enableFeeds>false</enableFeeds>
    <fieldSets>
        <fullName>SBQQ__ActiveContractLookup</fullName>
        <availableFields>
            <field>ContractTerm</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </availableFields>
        <availableFields>
            <field>StatusCode</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </availableFields>
        <description>Used by Select Contract page to render active contracts.</description>
        <displayedFields>
            <field>Status</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <displayedFields>
            <field>ContractNumber</field>
            <isFieldManaged>false</isFieldManaged>
