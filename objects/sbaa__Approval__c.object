    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>FRTest</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
AND(
ISPICKVAL(Quote__r.PMC_CPQ_Region__c,&apos;Brazil&apos;) ,NOT(ISPICKVAL(Quote__r.PMC_CPQ_QuoteRecordSubType__c,&apos;B2B - Fertilizer&apos;)),NOT(ISPICKVAL(Quote__r.PMC_CPQ_QuoteRecordSubType__c,&apos;B2B - Potash&apos;))),
AND(
(Quote__r.PMC_CPQ_QuoteOrigin__c==&apos;DH Request&apos;),
OR(ISBLANK(QuoteLine__r.PMC_CPQ_EstFreightPrice__c),
QuoteLine__r.PMC_CPQ_EstFreightPrice__c&lt;=0)
))</errorConditionFormula>
        <errorDisplayField>sbaa__ApprovalChain__c</errorDisplayField>
        <errorMessage>Go to edit lines and enter freight value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_QuoteSubmissionNoBeyondFriday5PM</fullName>
        <active>false</active>
        <description>This validation will prevent approval record from getting created when quote is submitted after friday 5pm</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
ISNEW(),
WEEKDAY( DATEVALUE( CreatedDate ) ) = 3,
HOUR( TIMEVALUE(CreatedDate) ) &gt;= 17
)</errorConditionFormula>
        <errorMessage>Cannot Submit Quote for Approval after Friday 5 PM !!!</errorMessage>
    </validationRules>
