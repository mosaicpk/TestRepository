    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>OpportunityAccessLevel</fullName>
        <description>Opportunity access level for this team member.</description>
    </fields>
    <fields>
        <fullName>OpportunityId</fullName>
        <description>ID of the Opportunity associated with this opportunity team. This field can’t be updated</description>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>TeamMemberRole</fullName>
        <description>Role that the team member has on the opportunity. The org’s admin sets the valid values in the Opportunity Team Roles picklist</description>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>UserId</fullName>
        <description>ID of the User who is a member of the opportunity team</description>
        <type>Lookup</type>
    </fields>
