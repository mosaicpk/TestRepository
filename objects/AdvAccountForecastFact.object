    <listViews>
        <fullName>My_Advanced_Account_Forecast_Facts</fullName>
        <columns>Name</columns>
        <columns>AdvAcctForecastSetPartner</columns>
        <columns>Period</columns>
        <columns>Status</columns>
        <columns>AdvAcctForecastSetUse</columns>
        <filterScope>Mine</filterScope>
