    </listViews>
    <listViews>
        <fullName>Recently_Created_Forecast_Fact</fullName>
        <columns>Name</columns>
        <columns>AdvAcctForecastSetPartner</columns>
        <columns>Period</columns>
        <columns>Status</columns>
        <columns>AdvAcctForecastSetUse</columns>
        <columns>CreatedDate</columns>
        <columns>Account</columns>
        <columns>LastModifiedDate</columns>
        <columns>PMC_SS_OpenOrders__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>AdvAcctForecastSetUse</field>
            <operation>contains</operation>
            <value>KLM</value>
        </filters>
        <label>Recently Created Forecast Fact</label>
    </listViews>
