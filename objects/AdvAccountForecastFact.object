    </fields>
    <fields>
        <fullName>Formula_Field__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(PMC_SS_CurrentSalesPlanMTN__c)) &amp;&amp; PMC_SS_UnitOfMeasureName__c=&apos;STN&apos;,PMC_SS_CurrentSalesPlanMTN__c*1.10,
IF(NOT(ISBLANK(PMC_SS_CurrentSalesPlanMTN__c)) &amp;&amp; PMC_SS_UnitOfMeasureName__c=&apos;MTN&apos;,PMC_SS_CurrentSalesPlanMTN__c*0.90,null))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Formula Field</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>LastYearOrderQuantity</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>LastYearOrderRevenue</fullName>
        <trackHistory>false</trackHistory>
    </fields>
