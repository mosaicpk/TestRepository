    <fields>
        <fullName>PMC_SS_AccountManager__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>States the Account Manager related to the forecast.</description>
        <label>Account Manager</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Advanced_Account_Forecast_Facts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PMC_SS_Accuracy__c</fullName>
        <description>Formula to calculate the Accuracy</description>
        <externalId>false</externalId>
        <formula>IF( NOT(ISNULL(PMC_SS_CurrentSalesPlan__c))&amp;&amp; ABS((PMC_SS_ShippedQuantity__c/ PMC_SS_CurrentSalesPlan__c) * 100)&gt;=200,0,IF(NOT(ISNULL(PMC_SS_CurrentSalesPlan__c))&amp;&amp; ABS((PMC_SS_ShippedQuantity__c/PMC_SS_CurrentSalesPlan__c) * 100)&gt;=150,50,IF(NOT(ISNULL(PMC_SS_CurrentSalesPlan__c)),ABS((PMC_SS_ShippedQuantity__c/ PMC_SS_CurrentSalesPlan__c) * 100),0)))</formula>
        <label>Accuracy %</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_SS_ActiveContracts__c</fullName>
        <description>States number of Active contracts.</description>
        <externalId>false</externalId>
