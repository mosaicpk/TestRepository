    <fields>
        <fullName>PMC_CPQ_SAPSalesOrganization__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Field to uniquely identify SAP Sales Organization</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>true</externalId>
        <label>SAP Sales Organization</label>
        <length>40</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>PMC_DH_SalesArea__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(PMC_SS_SalesOrganization__c)&amp;&quot; &quot; &amp;  
CASE( TEXT(PMC_SS_Division__c),
					&quot;10&quot;,&quot;Domestic&quot;,
					&quot;20&quot;,&quot;Export&quot;,
					&quot;30&quot;,&quot;Intercompany&quot;,&quot;&quot;) &amp;&quot; &quot;
					&amp; CASE( TEXT(PMC_SS_DistributionChannel__c),
					&quot;0&quot;,&quot;Common&quot;,
					&quot;00&quot;,&quot;Common&quot;,
					&quot;&quot;)</formula>
        <label>Sales Area</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_SS_DistributionChannel__c</fullName>
        <description>Specifies the Distribution Channel</description>
        <label>Distribution Channel</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>00</fullName>
                    <default>false</default>
                    <label>Common</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMC_SS_Division__c</fullName>
        <description>Specifies the Division</description>
        <label>Division</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>10</fullName>
                    <default>false</default>
                    <label>Domestic</label>
                </value>
                <value>
                    <fullName>20</fullName>
                    <default>false</default>
                    <label>Export</label>
                </value>
                <value>
                    <fullName>30</fullName>
                    <default>false</default>
                    <label>Intercompany</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMC_SS_EntityAddress__c</fullName>
        <description>This field is primarily created with the objective of capturing the address of the Mosaic Entity and to show it in the Contract Documents</description>
        <encryptionScheme>None</encryptionScheme>
