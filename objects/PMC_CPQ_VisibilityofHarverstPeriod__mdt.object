<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This Metadata has been created to provide Product Manager access to be able to enable or disable Harvest Period field to be made available for Account Manager to use on the Quote Line during quote configurations.</description>
    <fields>
        <fullName>PMC_CPQ_EnableHarverstPeriod__c</fullName>
        <defaultValue>false</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Enable Harverst Period</label>
        <type>Checkbox</type>
    </fields>
    <label>Visibility of Harverst Period</label>
    <pluralLabel>Visibility of Harverst Period</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
