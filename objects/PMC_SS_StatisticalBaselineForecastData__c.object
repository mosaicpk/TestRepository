    <listViews>
        <fullName>All</fullName>
        <columns>PMC_SS_Product__c</columns>
        <columns>PMC_SS_Account__c</columns>
        <columns>PMC_SS_Location__c</columns>
        <columns>PMC_SS_AccountManager__c</columns>
        <columns>PMC_SS_PeriodDate__c</columns>
        <columns>PMC_SS_UnitofMeasure__c</columns>
        <columns>PMC_SS_Quantity__c</columns>
        <columns>PMC_SS_FinalQuantity__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>NAME</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>My_Stat_Baselines</fullName>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>PMC_SS_FinalQuantity__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </filters>
        <label>My Stat Baselines</label>
    </listViews>
    <nameField>
        <displayFormat>SBF-{00000}</displayFormat>
        <label>Statistical Baseline Forecast Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Statistical Baseline Forecast Data</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
