        <deleteConstraint>SetNull</deleteConstraint>
        <label>Product</label>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Statistical Baseline Forecast Data</relationshipLabel>
        <relationshipName>Statistical_Baseline_Forecast_Data</relationshipName>
