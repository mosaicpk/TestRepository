    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Junction object to link Sales Agreement with Sales Area.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>PMC_SS_SalesAgreement__c</fullName>
        <description>Sales Agreement Master-Detail field</description>
        <label>Sales Agreement</label>
        <referenceTo>SalesAgreement</referenceTo>
        <relationshipLabel>Sales Area</relationshipLabel>
        <relationshipName>PMC_SS_SalesAgreementSalesAreaRel</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>PMC_SS_SalesArea__c</fullName>
        <description>Sales Area Master-Detail field</description>
        <label>Sales Area</label>
        <referenceTo>PMC_SS_SalesArea__c</referenceTo>
        <relationshipLabel>Sales Agreement Sales Area Relation</relationshipLabel>
        <relationshipName>PMC_SS_SalesAgreementSalesAreaRelation</relationshipName>
        <relationshipOrder>1</relationshipOrder>
        <reparentableMasterDetail>true</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <label>Sales Agreement Sales Area Relation</label>
    <nameField>
        <displayFormat>SAR-{00000}</displayFormat>
        <label>Sales Agreement Sales Area Relation Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Sales Agreement Sales Area Relations</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>PMC_SS_SalesAreaChangeValidation</fullName>
        <active>true</active>
        <description>This validation rule does not allow Sales area to be edited when Sales Agreement status is Activated, Amended, Expired or Draft.</description>
        <errorConditionFormula>AND(
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ) ,
OR(
ISPICKVAL(PMC_SS_SalesAgreement__r.PMC_SS_ApprovalStatus__c , &apos;Approved&apos;),
ISPICKVAL(PMC_SS_SalesAgreement__r.PMC_SS_ApprovalStatus__c, &apos;Under Revision&apos;)
)
)</errorConditionFormula>
        <errorMessage>Sales Agreement Sales Area Relation can’t be created/edited at this stage. Please Amend the Sales Agreement to make revisions to Sales Agreement Sales Area Relation.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
