    <fields>
        <fullName>PMC_SS_ExternalUniqueIdentifier__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Stores unique identifier of record with concatenation of: SAP account number + Sales Org + Division + Distribution Channel</description>
