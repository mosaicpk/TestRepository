    <fields>
        <fullName>PMC_CPQ_DistributionChannel__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( TEXT( PMC_SS_SalesArea__r.PMC_SS_DistributionChannel__c ),
&quot;0&quot;,&quot;Common&quot;,
&quot;00&quot;,&quot;Common&quot;,
&quot;&quot;)</formula>
        <label>Distribution Channel</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_Division__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( TEXT(PMC_SS_SalesArea__r.PMC_SS_Division__c),
&quot;10&quot;,&quot;Domestic&quot;,
&quot;20&quot;,&quot;Export&quot;,
&quot;30&quot;,&quot;Intercompany&quot;,&quot;&quot;)</formula>
        <label>Division</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
