    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>CurrencyIsoCode</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Description</fullName>
        <description>Specifies the description of the rebate program</description>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>EndDate</fullName>
        <description>Specifies the end date of the Rebate Program</description>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Frequency</fullName>
        <description>Specifies frequency of rebate program</description>
        <inlineHelpText>The basis for the number of rebate program payout periods generated.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>GracePeriodDayCount</fullName>
        <description>Number of days from end date of an instance of a payout period. Transactions submitted until this day are considered for rebate calculation.</description>
        <inlineHelpText>The number of days after the program end date that transactions can be submitted.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Name</fullName>
        <description>Specifies name of the Rebate Program</description>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>OwnerId</fullName>
        <description>Specifies the owner of the Rebate Program</description>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PMC_CLM_RebateProgramOrder__c</fullName>
        <description>Number indicating the position within its group or sales agreement.</description>
        <externalId>false</externalId>
        <label>Rebate Program Order</label>
        <precision>5</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_SS_Projected_Incentive__c</fullName>
        <label>Projected Incentive</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>PMC_SS_SalesAgreement__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lookup to Sales Agreement</description>
        <label>Sales Agreement</label>
        <referenceTo>SalesAgreement</referenceTo>
        <relationshipLabel>Rebate Programs</relationshipLabel>
        <relationshipName>Rebate_Programs</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PayoutCalculationDayCount</fullName>
        <description>Number of days from period end date. The payment will be calculated after this date. For example, a payout calculation day count of 14 means 14 days after period end date.</description>
        <inlineHelpText>The number of days after the payout period end date that the payout is calculated.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>ProgramReferenceNumber</fullName>
        <description>The reference number assigned to this rebate program. This field is unique within the organization. This field is available in API version 52.0 and later.</description>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>RebateProgramUrl</fullName>
        <description>URL of the rebate program</description>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>StartDate</fullName>
        <description>Specifies start date of rebate program.</description>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Status</fullName>
        <description>Possible states of Rebate Program. Possible values are: Active, Draft, Inactive</description>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Type</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <listViews>
        <fullName>All_RebatePrograms</fullName>
        <filterScope>Everything</filterScope>
        <label>AllRebatePrograms</label>
    </listViews>
    <listViews>
        <fullName>My_Activated_Rebates</fullName>
        <columns>Name</columns>
        <columns>StartDate</columns>
        <columns>EndDate</columns>
        <columns>Frequency</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>Status</field>
            <operation>equals</operation>
            <value>2</value>
        </filters>
        <label>My Activated Rebates</label>
    </listViews>
    <listViews>
        <fullName>My_RebatePrograms</fullName>
        <columns>Name</columns>
        <columns>Status</columns>
        <columns>StartDate</columns>
        <columns>EndDate</columns>
        <columns>Owner</columns>
        <columns>CreatedDate</columns>
        <filterScope>Mine</filterScope>
        <label>My Rebate Programs</label>
    </listViews>
