    <validationRules>
        <fullName>PMC_SS_PreventLettersDomBroker</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  NOT(ISBLANK(Domestic_Broker_Text__c)),
  NOT(REGEX(Domestic_Broker_Text__c, &quot;^[0-9]*$&quot;))
)</errorConditionFormula>
        <errorDisplayField>Domestic_Broker_Text__c</errorDisplayField>
        <errorMessage>Provide only numbers for Domestic Broker</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_Prevent_Dot_In_Email</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
    REGEX( PMC_DH_Email__c , &quot;^\\..*&quot;),  /* Checks if the email starts with a dot */
    REGEX(PMC_DH_Email__c, &quot;.*\\.$&quot;)   /* Checks if the email ends with a dot */
)</errorConditionFormula>
        <errorDisplayField>PMC_DH_Email__c</errorDisplayField>
        <errorMessage>&quot;The Email field cannot start or end with a dot (.)&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateAddressCityLenght</fullName>
        <active>true</active>
        <description>Validate Account Address City lenght is not longer than 40 characters</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
LEN( BillingCity ) &gt; 40
)</errorConditionFormula>
        <errorDisplayField>BillingCity</errorDisplayField>
        <errorMessage>City Name should not exceed 40 characters.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateAddressFieldsPopulated</fullName>
        <active>false</active>
        <description>Validate Account Address Fields are populated</description>
        <errorConditionFormula>AND(
NOT(
$Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c
),
OR(
OR
(
ISBLANK( BillingStreet ),
ISBLANK( BillingCountry ),
ISBLANK( BillingCity ),
ISBLANK( BillingState ),
ISBLANK( BillingPostalCode )
)
)
)</errorConditionFormula>
        <errorMessage>Please fill all Address Fields</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateAddressPostalCodeFormat</fullName>
        <active>true</active>
        <description>Validate Account Address Postal Code format</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
OR (
AND( 
ISPICKVAL( BillingCountryCode , &quot;BR&quot;),
!REGEX(  BillingPostalCode ,&quot;^(\\d{5}\\-\\d{3})?$&quot;)
),
LEN( BillingPostalCode ) &gt; 10
)
)</errorConditionFormula>
        <errorDisplayField>BillingPostalCode</errorDisplayField>
        <errorMessage>Postal Code should not exceed 10 characters. For Brazil, please adjust ZIP/Postal Code format to: 00000-000</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateAddressStatePupuated</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(  BillingStateCode , &quot;&quot;), ISPICKVAL(Type, &quot;Sold-to&quot;))</errorConditionFormula>
        <errorDisplayField>BillingStateCode</errorDisplayField>
        <errorMessage>Complete this field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateAddressStreetLenght</fullName>
        <active>true</active>
        <description>Validate Account Address Street lenght is not longer than 60 characters</description>
