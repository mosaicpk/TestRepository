    <fields>
        <fullName>PMC_SS_SoldToAccount__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lookup field on the Ship-to Account that is looking up to the Sold-to Account</description>
        <inlineHelpText>Provide the Sold-to customer for linking</inlineHelpText>
        <label>Sold-to partner related</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 AND 2</booleanFilter>
            <filterItems>
                <field>Account.Type</field>
                <operation>equals</operation>
                <value>Sold-to</value>
            </filterItems>
            <filterItems>
                <field>Account.PMC_SS_SAPCustomerNumber__c</field>
                <operation>notEqual</operation>
                <value></value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Sold-to partner related</relationshipLabel>
        <relationshipName>Shipto_Sold</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
