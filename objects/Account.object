    <validationRules>
        <fullName>PMC_CPQ_SSAAccountEditaccess</fullName>
        <active>false</active>
        <description>deprecated</description>
        <errorConditionFormula>AND(
  NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ),
  NOT( ISCHANGED( PMC_CPQ_FlowAccountVRByPassToggle__c ) ),
  NOT( ISNEW()),
  NOT($User.Id  =  OwnerId),
  OR($UserRole.Name =&apos;NA Sales Service Analyst (SSA)&apos;,
     $UserRole.Name =&apos;SA Sales Service Analyst (SSA)&apos;
     )
)</errorConditionFormula>
        <errorMessage>You do not have permission to edit accounts.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_BlockEditCNPJ</fullName>
        <active>true</active>
        <description>Prevents that any user other than team members of Master data and System Administrator edit the field value</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
(
ISCHANGED(PMC_SS_TaxIDOrCNPJOrCPF__c) &amp;&amp; NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;) || CONTAINS($Profile.Name, &quot;System Administrator&quot;))&amp;&amp; ISPICKVAL($User.UserType, &quot;Standard&quot;)
))</errorConditionFormula>
        <errorDisplayField>PMC_SS_TaxIDOrCNPJOrCPF__c</errorDisplayField>
        <errorMessage>CNPJ - Only Master Data or System Administrator team members can edit this field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_BlockEditCPF</fullName>
        <active>true</active>
        <description>Prevents that any user other than team members of Master data and System Administrator edit the field value</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
ISCHANGED(PMC_SS_CPF__c)
)</errorConditionFormula>
        <errorDisplayField>PMC_SS_CPF__c</errorDisplayField>
        <errorMessage>Only Master Data or System Administrator team members can edit this field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_BlockEditCustomerType</fullName>
        <active>true</active>
        <description>Block the field PMC_SS_CustomerType__c for edition by users thar are not of Master Data or Admin profile</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
ISCHANGED(PMC_SS_CustomerType__c)
)</errorConditionFormula>
        <errorDisplayField>PMC_SS_CustomerType__c</errorDisplayField>
        <errorMessage>Only Master Data or System Administrator team members can edit this field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_BlockEditIndustry</fullName>
        <active>true</active>
        <description>Prevents that any user other than team members of Master data and System Administrator edit the field value</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
NOT(CONTAINS($Profile.Name, &quot;Sales User&quot;)),
NOT(CONTAINS($Profile.Name, &quot;Service User&quot;)),
ISCHANGED(Industry),
ISPICKVAL($User.UserType, &quot;Standard&quot;)
)</errorConditionFormula>
        <errorDisplayField>Industry</errorDisplayField>
        <errorMessage>Industry - Only Master Data or System Administrator team members can edit this field</errorMessage>
    </validationRules>
    <validationRules>
