NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
LEN( BillingStreet ) &gt; 60
)</errorConditionFormula>
        <errorDisplayField>BillingStreet</errorDisplayField>
        <errorMessage>Address Street should not exceed 60 characters.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateAgentAccountParent</fullName>
        <active>true</active>
        <description>Rule to block parent account for agent accounts.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
RecordType.DeveloperName == &apos;PMC_SS_Agent&apos;,
NOT(ISBLANK( ParentId ))
)</errorConditionFormula>
        <errorDisplayField>ParentId</errorDisplayField>
        <errorMessage>Agent accounts are standalone accounts and cannot have parents</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateCNPJFormat</fullName>
        <active>true</active>
        <description>Validate Account CNPJ format</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
ISPICKVAL( BillingCountryCode , &quot;BR&quot;),
ISPICKVAL(  PMC_SS_CustomerType__c , &quot;B2B&quot;),
!REGEX(PMC_SS_TaxIDOrCNPJOrCPF__c ,&quot;^\\d{14}?$&quot;)
)</errorConditionFormula>
        <errorDisplayField>PMC_SS_TaxIDOrCNPJOrCPF__c</errorDisplayField>
        <errorMessage>Please inform CNPJ by using only numbers (14 numbers).</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateCPFFormat</fullName>
        <active>true</active>
        <description>Validate Account CPF format</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
ISPICKVAL( BillingCountryCode , &quot;BR&quot;),
ISPICKVAL(  PMC_SS_CustomerType__c , &quot;B2C&quot;),
!REGEX(  PMC_SS_CPF__c ,&quot;^\\d{11}?$&quot;)
)</errorConditionFormula>
        <errorDisplayField>PMC_SS_CPF__c</errorDisplayField>
        <errorMessage>Please inform CPF by using only numbers (11 numbers).</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateEmailLenght</fullName>
        <active>true</active>
        <description>Validate Account Email Address lenght is not longer than 60 characters</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
LEN( PMC_DH_Email__c ) &gt; 60
)</errorConditionFormula>
        <errorDisplayField>PMC_DH_Email__c</errorDisplayField>
        <errorMessage>Email Address should not exceed 60 characters.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateFaxLenght</fullName>
        <active>true</active>
        <description>Validate Fax Number Lenght is no longer than 30 characters</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
LEN( Fax ) &gt; 30
)</errorConditionFormula>
        <errorDisplayField>Fax</errorDisplayField>
        <errorMessage>Fax number should not exceed 30 characters.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateIEFormat</fullName>
        <active>false</active>
        <description>Validate Account State Tax Number format</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
ISPICKVAL( BillingCountryCode , &quot;BR&quot;),
!REGEX(  PMC_SS_StateTaxNumber__c  ,&quot;^(\\w{1,20})?$&quot;)
)</errorConditionFormula>
        <errorDisplayField>PMC_SS_StateTaxNumber__c</errorDisplayField>
        <errorMessage>State Tax Number should not exceed 20 characteres and cannot contain special carachters (no dot, no comma, no hifen).</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateNameLenght</fullName>
        <active>true</active>
        <description>Validate Account Name lenght is not longer than 35 characters</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
LEN( Name ) &gt; 35
)</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>Account Name should not exceed 35 characters.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateParentAccount</fullName>
        <active>true</active>
        <description>Checks if the parent account is valid.</description>
        <errorConditionFormula>AND(
	NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
	$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
	$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
	$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
	NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
	NOT( RecordType.DeveloperName == &apos;PMC_SS_Agent&apos; ),
	NOT( ISBLANK( ParentId ) ),
	OR(
		AND(
			NOT(ISPICKVAL( Type , &apos;Others&apos;)),
			OR(
				ISPICKVAL( Parent.Type , &apos;Ship-to&apos;),
				ISPICKVAL( Parent.Type , &apos;Bill-to&apos;),
				ISPICKVAL( Parent.Type , &apos;Payer&apos;),
				Parent.RecordType.DeveloperName == &apos;PMC_SS_Agent&apos;,
				Parent.RecordType.DeveloperName == &apos;PMC_SS_Prospect&apos;
			)
		),
		AND(
			OR(
				ISPICKVAL( Type , &apos;Ship-to&apos;),
				ISPICKVAL( Type , &apos;Bill-to&apos;),
				ISPICKVAL( Type , &apos;Payer&apos;),
				ISPICKVAL( Type , &apos;Sold-to&apos;)
			),
			NOT(ISPICKVAL( Parent.Type , &apos;Sold-to&apos;)),
			NOT(ISPICKVAL( Parent.Type , &apos;Others&apos; ))
		),
		AND(
			ISPICKVAL( Type , &apos;Others&apos;),
			NOT(ISPICKVAL( Parent.Type , &apos;Sold-to&apos;)),
			NOT(ISPICKVAL( Parent.Type , &apos;Ship-to&apos;))
		)
	)
)</errorConditionFormula>
        <errorDisplayField>ParentId</errorDisplayField>
        <errorMessage>The Parent Account association is invalid, please add a valid Sold-to/Ship-to Account for Other Account or Sold-to/Other for a Sold-to Account as Parent Account.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidatePhoneFormat</fullName>
        <active>true</active>
        <description>Validate Phone Format for BR Accounts and Phone Lenght</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
ISPICKVAL(BillingCountryCode, &quot;BR&quot;),
NOT(REGEX(Phone, &quot;^((\\+\\d{2}\\s)?\\(\\d{2}\\)\\s?\\d{4}\\d?\\-\\d{4})?$&quot;))
)</errorConditionFormula>
        <errorDisplayField>Phone</errorDisplayField>
        <errorMessage>Phone Number lenght should not exceed 11 digits. For Brazil, please adjust Phone format to: (00) 00000-0000</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidatePhoneFormatUS</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
    ISPICKVAL(BillingCountryCode, &quot;US&quot;),
    NOT(REGEX(Phone, &quot;^(\\+1\\s?)?(\\(\\d{3}\\)|\\d{3})[\\s.-]?\\d{3}[\\s.-]?\\d{4}$&quot;))
)</errorConditionFormula>
        <errorDisplayField>Phone</errorDisplayField>
        <errorMessage>Please enter the phone number in the correct format: (XXX) XXX-XXXX or XXX-XXX-XXXX for US</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateRUCFormat</fullName>
        <active>true</active>
        <description>Validate Paraguay RUC accepts only number and letters</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
ISPICKVAL( BillingCountryCode , &quot;PY&quot;),
!REGEX( PMC_SS_RUC__c ,&quot;^\\d{1,35}?$&quot;)
)</errorConditionFormula>
        <errorDisplayField>PMC_SS_RUC__c</errorDisplayField>
        <errorMessage>Only numbers are accepted for RUC</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateSoldToAccount</fullName>
        <active>true</active>
        <description>Checks if Account is a Sold-To/Other Customer Account before letting user add Parent Account</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(CONTAINS( $Profile.Name , &apos;Digital Hub&apos; )),
NOT(CONTAINS($Profile.Name, &quot;Master Data&quot;)),
	OR(
		AND(
			NOT(ISPICKVAL(Type, &apos;Sold-to&apos;)),
			NOT(ISPICKVAL(Type, &apos;Others&apos;))
		),
		RecordType.DeveloperName != &apos;PMC_SS_Customer&apos;
	),
	NOT(ISBLANK( ParentId ))
)</errorConditionFormula>
        <errorMessage>The Account you’re on is not a Sold-to/Other Account. Only Sold-to/Other accounts can use the Parent Account field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RequireBillingCity</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
ISBLANK(BillingCity)
)</errorConditionFormula>
        <errorDisplayField>BillingCity</errorDisplayField>
        <errorMessage>Please provide the City</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RequireBillingPostalCode</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
    OR(
        ISPICKVAL(BillingCountryCode, &quot;BR&quot;),
        ISPICKVAL(BillingCountryCode, &quot;PY&quot;)
    ),
    ISBLANK(BillingPostalCode)
)</errorConditionFormula>
        <errorDisplayField>BillingPostalCode</errorDisplayField>
        <errorMessage>Please provide the Zip/Postal Code</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RequireBillingStreet</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;Administrador do sistema&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
ISBLANK(BillingStreet))</errorConditionFormula>
        <errorDisplayField>BillingStreet</errorDisplayField>
        <errorMessage>Please provide the Street Name</errorMessage>
    </validationRules>
