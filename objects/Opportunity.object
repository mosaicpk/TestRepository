    <businessProcesses>
        <fullName>Opportunity Process</fullName>
        <description>Helps users to manage the Sales cycle by moving them through pre-defined Opportunity stages</description>
        <isActive>true</isActive>
        <values>
            <fullName>Analysis</fullName>
            <default>false</default>
        </values>
        <values>
            <fullName>Closed Lost</fullName>
            <default>false</default>
        </values>
        <values>
            <fullName>Closed Won</fullName>
            <default>false</default>
        </values>
        <values>
            <fullName>Proposal</fullName>
            <default>false</default>
        </values>
        <values>
            <fullName>Prospecting</fullName>
            <default>false</default>
        </values>
    </businessProcesses>
    <compactLayoutAssignment>New_Awesome_Companct_Layout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>New_Awesome_Companct_Layout</fullName>
        <fields>Name</fields>
        <fields>AccountId</fields>
        <fields>CloseDate</fields>
        <fields>Amount</fields>
        <fields>OwnerId</fields>
        <label>New Awesome Compact Layout</label>
    </compactLayouts>
    <enableEnhancedLookup>true</enableEnhancedLookup>
    <enableFeeds>true</enableFeeds>
    <enableHistory>true</enableHistory>
