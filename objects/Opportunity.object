    <fields>
        <fullName>ExpectedRevenue</fullName>
        <description>Read-only field that is equal to the product of the opportunity Amount field and the Probability. You can’t directly set this field, but you can indirectly set it by setting the Amount or Probability fields.</description>
    </fields>
    <fields>
