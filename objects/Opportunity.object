    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>PMC_SS_ReasonLostRequired</fullName>
        <active>true</active>
        <description>This validation rule checks that the Reason Lost field is populated before the Opportunity Stage is changed to &quot;Closed Lost&quot;.</description>
        <errorConditionFormula>AND(
 NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ) ,
 ISPICKVAL( StageName , &apos;Closed Lost&apos;) ,
 ISBLANK( TEXT( PMC_SS_ReasonLost__c ) ) 

)</errorConditionFormula>
        <errorDisplayField>PMC_SS_ReasonLost__c</errorDisplayField>
        <errorMessage>Please indicate the reason why this opportunity was lost in the field “Reason Lost”</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_RestrictOppForNonSoldToAccounts</fullName>
        <active>true</active>
        <description>Validation rule to block the creation of opportunity when account type is Ship-to, Bill-to or Payer.</description>
        <errorConditionFormula>AND(
    NOT( 
    $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c 
    ),
    AND(
        Account.RecordType.DeveloperName == &apos;PMC_SS_Customer&apos;,
        OR(
            ISPICKVAL(Account.Type, &apos;Ship-to&apos;),
            ISPICKVAL(Account.Type, &apos;Bill-to&apos;),
            ISPICKVAL(Account.Type, &apos;Payer&apos;)
        )
    )
)</errorConditionFormula>
        <errorMessage>Only Sold-to Accounts can have Opportunities. Please select a Sold-to Account to create an Opportunity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_RestrictOpportunityStageUpdate</fullName>
        <active>true</active>
        <description>This validation rules restricts the Stage updates on opportunities related to Prospect Accounts</description>
        <errorConditionFormula>IF(
	AND(
		NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
        ISCHANGED(StageName),
        Account.RecordType.DeveloperName = &apos;PMC_SS_Prospect&apos;,
        NOT( ISPICKVAL( Type , &apos;Indirect Sales&apos;) ), 
		OR(
		  ISPICKVAL(StageName,&apos;Proposal&apos;),
		  ISPICKVAL(StageName,&apos;Finalize Quote&apos;),
		  ISPICKVAL(StageName,&apos;Closed Won&apos;)
		)    
       
    ), 
true, 
false
)</errorConditionFormula>
        <errorMessage>Prospect Accounts are not eligible for the stage you’re selecting. Please start the Credit Check Process to convert this account to a Customer Account</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>SBQQ__Amend_Assets</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Amend Assets</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <url>/apex/SBQQ__AssetSelector?accountId={!Opportunity.AccountId}&amp;oppId={!Opportunity.Id}</url>
    </webLinks>
