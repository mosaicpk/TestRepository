<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This Metadata has been created to provide Product Manager access for bypassing Quote&apos;s Floor Price Validation such that Account Managers can edit Quotes where final price of any Quote Line is less than Floor price.</description>
    <fields>
        <fullName>PMC_CPQ_BypassFloorPriceValidation__c</fullName>
        <businessStatus>Active</businessStatus>
        <defaultValue>false</defaultValue>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Bypass Floor Price Validation</label>
        <securityClassification>Public</securityClassification>
        <type>Checkbox</type>
    </fields>
    <label>Bypass Quote Floor Price Validation</label>
    <pluralLabel>Bypass Quote Floor Price Validations</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
