    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>PMC_SS_RestrictMemberModification</fullName>
        <active>true</active>
        <description>This Validation rule will not allow create/update on Rebate Program Member once the Rebate program is Inactive.</description>
        <errorConditionFormula>AND(
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ) ,
OR(
ISPICKVAL(  PRIORVALUE(MemberStatus)  , &apos;Inactive&apos;),
ISNEW()
), 
ISPICKVAL( RebateProgram.Status , &apos;Inactive&apos;) 
)</errorConditionFormula>
        <errorMessage>Cannot create/update Rebate Program Member once Rebate Program is Inactive</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_RestrictRebTest</fullName>
        <active>false</active>
        <description>This validation rule is used to restrict the user from editing or creating Rebate Program Member for Under Revision or Approved Sales Agreement.</description>
        <errorConditionFormula>AND( 
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ) ,
NOT(
AND(
ISCHANGED(  MemberStatus ) ,
ISPICKVAL(  MemberStatus , &apos;Active&apos;) ,
ISPICKVAL( RebateProgram.PMC_SS_SalesAgreement__r.Status , &apos;Activated&apos;)

)
),
NOT(ISPICKVAL(  RebateProgram.PMC_SS_SalesAgreement__r.Status , &apos;Cancelled&apos;)),
OR( ISPICKVAL(  RebateProgram.PMC_SS_SalesAgreement__r.PMC_SS_ApprovalStatus__c  , &apos;Approved&apos;), 
ISPICKVAL( RebateProgram.PMC_SS_SalesAgreement__r.PMC_SS_ApprovalStatus__c , &apos;Under Revision&apos;)  )
)</errorConditionFormula>
        <errorMessage>TEST Rebate Program Members can’t be edited at this stage. Please Amend the Sales Agreement to make revisions to Rebate Program Members.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_RestrictRebateProgramMemberEdit</fullName>
        <active>true</active>
        <description>This validation rule is used to restrict the user from editing or creating Rebate Program Member for Under Revision or Approved Sales Agreement.</description>
        <errorConditionFormula>AND( 
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ) ,
NOT(
OR(
AND(
ISCHANGED(  MemberStatus ) ,
ISPICKVAL(  MemberStatus , &apos;Active&apos;) ,
ISPICKVAL( RebateProgram.PMC_SS_SalesAgreement__r.Status , &apos;Activated&apos;)
),
AND(
ISCHANGED(  MemberStatus ) ,
ISPICKVAL(  MemberStatus , &apos;Inactive&apos;) ,
ISPICKVAL( RebateProgram.PMC_SS_SalesAgreement__r.Status , &apos;Expired&apos;)
)
)
),
NOT(ISPICKVAL(  RebateProgram.PMC_SS_SalesAgreement__r.Status , &apos;Cancelled&apos;)),
OR( ISPICKVAL(  RebateProgram.PMC_SS_SalesAgreement__r.PMC_SS_ApprovalStatus__c  , &apos;Approved&apos;), 
ISPICKVAL( RebateProgram.PMC_SS_SalesAgreement__r.PMC_SS_ApprovalStatus__c , &apos;Under Revision&apos;)  )
)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>Rebate Program Members can’t be created/edited at this stage. Please Amend the Sales Agreement to make revisions to Rebate Program Members.</errorMessage>
    </validationRules>
</CustomObject>
