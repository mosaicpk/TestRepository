        <fullName>User_time_zone__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(DATEVALUE(DATETIMEVALUE(TEXT(YEAR(PMC_CPQ_ContractStart__c))&amp;&apos;-&apos;&amp; TEXT(MONTH(PMC_CPQ_ContractStart__c))&amp;&apos;-&apos;
&amp;TEXT(DAY(PMC_CPQ_ContractStart__c))&amp;&apos; &apos;&amp; TEXT(TIMEVALUE(NOW())))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>User time zone</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>V_Test_Diff_Dates__c</fullName>
        <description>Testing</description>
        <externalId>false</externalId>
        <formula>((YEAR(PMC_CPQ_ContractStart__c) - YEAR(PMC_CPQ_ContractEnd__c))*12) + (MONTH(PMC_CPQ_ContractEnd__c) - MONTH(PMC_CPQ_ContractStart__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>V Test Diff Dates</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
