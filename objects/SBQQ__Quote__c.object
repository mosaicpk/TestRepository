        <description>If region is North America, then English, else if region is Brazil, then ask Account Manager to select Spanish or Portuguese</description>
        <label>Output Document Language</label>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <controllingField>PMC_CPQ_Region__c</controllingField>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>English</fullName>
                    <default>false</default>
                    <label>English</label>
                </value>
                <value>
                    <fullName>Portuguese</fullName>
                    <default>false</default>
                    <label>Portuguese</label>
                </value>
                <value>
                    <fullName>Spanish</fullName>
                    <default>false</default>
                    <label>Spanish</label>
                </value>
            </valueSetDefinition>
            <valueSettings>
                <controllingFieldValue>Brazil</controllingFieldValue>
                <valueName>Portuguese</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>Brazil</controllingFieldValue>
                <valueName>Spanish</valueName>
            </valueSettings>
            <valueSettings>
                <controllingFieldValue>North America</controllingFieldValue>
                <valueName>English</valueName>
            </valueSettings>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ContractPeriod__c</fullName>
        <description>This field calculate number of months between contract start and end date.</description>
        <externalId>false</externalId>
        <formula>((YEAR(PMC_CPQ_ContractEnd__c) - YEAR(PMC_CPQ_ContractStart__c))*12) + (MONTH(PMC_CPQ_ContractEnd__c) - MONTH(PMC_CPQ_ContractStart__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Contract Period</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
