    <fields>
        <fullName>EditLinesFieldSetName__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    ISPICKVAL(PMC_CPQ_Region__c, &apos;North America&apos;),
    IF(
    OR(
    RecordType.DeveloperName = &apos;PMC_CPQ_International&apos;,
    RecordType.DeveloperName = &apos;PMC_CPQ_InternationalDistribution&apos;
    ),
    &quot;PMC_CPQ_NAInternational&quot;
    ,
    &quot;PMC_CPQ_QLEDomesticNACoPr&quot;
    ),
    &quot;PMC_CPQ_QLEB2BDOMINTBRFERT&quot;
)</formula>
        <label>QLE Column Conditionality</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
