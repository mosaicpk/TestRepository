    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>PMC_CLM_BrazilContractMandatories</fullName>
        <active>false</active>
        <description>The validation rule will enforce fields necessary in Brazil Contract Document is populated before generating the contract document</description>
        <errorConditionFormula>AND
(
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
CONTAINS(TEXT(PMC_CPQ_Region__c) , &apos;Brazil&apos;),
TEXT(SBQQ__Status__c) = &apos;Approved&apos;,
OR(
PMC_WitnessSigner1Name__c = &apos;&apos;,
PMC_WitnessSigner1Email__c  = &apos;&apos;,
PMC_WitnessSigner2Name__c  = &apos;&apos; ,
PMC_WitnessSigner2Email__c  = &apos;&apos;
) 
)</errorConditionFormula>
        <errorMessage>Please populate fields pertaining to Witness Name and Email in the Contract Information Section</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CLM_RestricContractDocStatusUpdate</fullName>
        <active>false</active>
        <description>This is used to make the contract document status field editable only to the account manager when the record type is international and the quote sub type is raw material.</description>
        <errorConditionFormula>AND
(
$Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ,
ISCHANGED(PMC_CPQ_ContractStageName__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
OR(
RecordType.DeveloperName = &apos;PMC_CPQ_Domestic&apos;,
RecordType.DeveloperName = &apos;PMC_CPQ_DomesticBR&apos;,
RecordType.DeveloperName = &apos;PMC_CPQ_DomesticNA&apos;,
RecordType.DeveloperName = &apos;PMC_CPQ_InternationalDistribution&apos;,
TEXT(PMC_CPQ_QuoteRecordSubType__c) = &apos;Feed&apos;,
TEXT(PMC_CPQ_QuoteRecordSubType__c) = &apos;Industrial&apos;,
TEXT(PMC_CPQ_QuoteRecordSubType__c) = &apos;B2C - Fertilizer&apos;,
TEXT(PMC_CPQ_QuoteRecordSubType__c) = &apos;B2B - Feed&apos;,
TEXT(PMC_CPQ_QuoteRecordSubType__c) = &apos;B2B - Fertilizer&apos;,
TEXT(PMC_CPQ_QuoteRecordSubType__c) = &apos;B2B - Specialties&apos;,
TEXT(PMC_CPQ_QuoteRecordSubType__c) = &apos;B2C - Paraguay&apos;,
TEXT(PMC_CPQ_QuoteRecordSubType__c) = &apos;B2B - Potash&apos;
)
)</errorConditionFormula>
        <errorMessage>Contract Document Status can be updated manually only in International Raw Material Quote</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_AMReadOnlyfieldsonRequestStatus</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;, 
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT( CONTAINS($Profile.Name,&apos;Digital Hub&apos;)),
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
NOT( ISNEW() ) ,
ISPICKVAL( SBQQ__Status__c , &quot;Request&quot;) ,  NOT( ISCHANGED( PMC_CPQ_RejectedReason__c ) )   )</errorConditionFormula>
        <errorMessage>Please move the Quote status from &apos;Request&apos; to &apos;Draft&apos; to accept the Quote Request from the customer and proceed with quoting</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_AcceptanceConditionMandatory</fullName>
        <active>true</active>
        <description>When moving quote life cycle to Accepted  stage this Customer Acceptance Method and Primary field is mandatory</description>
        <errorConditionFormula>AND(
 NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
 NOT( RecordType.DeveloperName = &apos;PMC_CPQ_InternationalDistribution&apos;),
 ISPICKVAL( SBQQ__Status__c , &quot;Accepted&quot;),
 OR( 
      ISPICKVAL( PRIORVALUE( SBQQ__Status__c ) , &quot;Approved&quot;),
       ISPICKVAL( PRIORVALUE( SBQQ__Status__c ) , &quot;Presented&quot;) 
 ),
 ISPICKVAL( PMC_CPQ_CustomerAcceptanceMethod__c , &quot;&quot;)
 )</errorConditionFormula>
        <errorMessage>Customer Acceptance Method is required for Accepted Quotes
has context menu</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_AccountManagerEditAccess</fullName>
        <active>false</active>
        <description>Restrict account manager role to prevent editing other account manager quote (POC)</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
NOT(ISNEW()),
NOT(ISCLONE()),
OR(
	$UserRole.DeveloperName = &apos;PMC_SA_B2BSalesTeam&apos;,
	$UserRole.DeveloperName = &apos;PMC_SA_B2CSalesTeam&apos;,
	$UserRole.DeveloperName = &apos;PMC_NA_SalesTeam&apos;
),
$User.Id &lt;&gt; PMC_CPQ_AccountManager__c 

)</errorConditionFormula>
        <errorMessage>Oops! you don&apos;t have privilege to access this record</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_AccountNameValidation</fullName>
        <active>true</active>
        <description>This validation rule has been created as part of user story to throw error when an Account on Quote is changed.</description>
        <errorConditionFormula>AND(
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISCHANGED( SBQQ__Account__c ),
ISBLANK(PMC_CPQ_LegacyQuoteID__c) 
)</errorConditionFormula>
        <errorDisplayField>SBQQ__Account__c</errorDisplayField>
        <errorMessage>You cannot change account value on quote</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_ApprovalConditionMandatory</fullName>
        <active>false</active>
        <description>This validation fires when mosaic user tried to move status from draft to approved via chevron and approval condition field is not populated.</description>
        <errorConditionFormula>AND(NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c), ISPICKVAL(PRIORVALUE(SBQQ__Status__c) ,&quot;Draft&quot;), ISPICKVAL( SBQQ__Status__c , &quot;Approved&quot;),  ISPICKVAL( ApprovalStatus__c , &quot;&quot;)  , ISPICKVAL( PMC_CPQ_ApprovalCondition__c , &quot;&quot;) )</errorConditionFormula>
        <errorDisplayField>PMC_CPQ_ApprovalCondition__c</errorDisplayField>
        <errorMessage>Approval Condition is Mandatory for manual Approval</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_BRBusinessTypeChangeException</fullName>
        <active>true</active>
        <description>To prevent AM BR from changing Business Type on a quote which has quote lines.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISPICKVAL(  PMC_CPQ_Region__c , &apos;Brazil&apos;),
SBQQ__LineItemCount__c &gt; 0,
ISCHANGED( PMC_CPQ_QuoteRecordSubType__c )
)</errorConditionFormula>
        <errorMessage>Delete the Product from Cart to make changes to business type or create a fresh quote for another business type.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_ClosedOpportunityValidation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
ISNEW(),
 ISPICKVAL(SBQQ__Opportunity2__r.SBQQ__PrimaryQuote__r.PMC_CPQ_ContractStageName__c ,&apos;Accepted&apos;),
SBQQ__Primary__c 
)</errorConditionFormula>
        <errorMessage>Unable to set quote as primary due to an existing contracted quote within the same opportunity; consider creating a new opportunity for this quote or deselect the &apos;Primary&apos; checkbox.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_ContractDateMandatory</fullName>
        <active>false</active>
        <description>Created part of story 7850 story poc not used</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c), NOT(  ISCLONE()  ) ,  
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
OR(    ISNULL(PMC_CPQ_ContractStart__c ) , 
       ISNULL( PMC_CPQ_ContractEnd__c )
)
)</errorConditionFormula>
        <errorMessage>Please Enter Contract valid from and Contract valid to details</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_ContractValidFromValidation</fullName>
        <active>true</active>
        <description>Contract Valida From should be in the past</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),

OR(AND(
PMC_CPQ_ContractStart__c &lt; TODAY(), ISNEW()
),
IF(ISBLANK(PMC_CPQ_ContractStart__c),false,
AND(
( DATEVALUE(DATETIMEVALUE(PMC_CPQ_ContractStart__c)) ) &lt; ( DATEVALUE(DATETIMEVALUE(DATEVALUE(CreatedDate))) ),
NOT(ISNEW())
)
)),
NOT(AND(ISCLONE(), ISNEW())),
NOT( TEXT(SBQQ__Type__c)=&quot;Amendment&quot;),
NOT( TEXT(SBQQ__Type__c)=&quot;Renewal&quot;),
ISBLANK(PMC_CPQ_LegacyQuoteID__c)
)</errorConditionFormula>
        <errorMessage>Contract Valid From date cannot be in the past.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_ContractValidToBeforeValidFrom</fullName>
        <active>true</active>
        <description>Contract Valid To date should not be before the Contract Valid From date</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
NOT(ISBLANK(PMC_CPQ_ContractStart__c)),
NOT(ISBLANK(PMC_CPQ_ContractEnd__c)),
PMC_CPQ_ContractEnd__c - PMC_CPQ_ContractStart__c &lt;=0
)</errorConditionFormula>
        <errorMessage>Contract Valid To date should not be before the Contract Valid From date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_ContractValidToFromValidation</fullName>
        <active>true</active>
        <description>Validation to check the contract valid to and contract valid from difference is greater than 30 days to support salesforce OOB contract creation.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
PMC_CPQ_ContractEnd__c -  PMC_CPQ_ContractStart__c &lt;30 
)</errorConditionFormula>
        <errorMessage>Please ensure the duration in between Contract Valid From and Contract Valid To date is more than 30 days</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_ContractValidToValidation</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
  NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
  NOT(ISBLANK(PMC_CPQ_ContractStart__c)),
  NOT(ISBLANK(PMC_CPQ_ContractEnd__c)),
  (PMC_CPQ_ContractEnd__c - PMC_CPQ_ContractStart__c) &gt; 547
)</errorConditionFormula>
        <errorMessage>The Contract Valid To date should not be more than 1 year and 6 months from the created date of the quote</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_CurrencyChangeforQuote</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
 NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISCHANGED(CurrencyIsoCode ),

 NOT(
   OR(
      TEXT($User.LocaleSidKey) = &apos;en_US&apos; &amp;&amp; TEXT(CurrencyIsoCode) = &apos;USD&apos;,
      TEXT($User.LocaleSidKey) = &apos;en_US&apos; &amp;&amp; TEXT(CurrencyIsoCode) = &apos;CAD&apos;,
      TEXT($User.LocaleSidKey) = &apos;pt_BR&apos; &amp;&amp; TEXT(CurrencyIsoCode) = &apos;USD&apos;,
      TEXT($User.LocaleSidKey) = &apos;pt_BR&apos; &amp;&amp; TEXT(CurrencyIsoCode) = &apos;BRL&apos;
    
    )
  )
)</errorConditionFormula>
        <errorMessage>Please select a valid currency based on your assigned Locale.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_DeliveryStartDateBeforeEndDate</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT( CONTAINS($Profile.Name,&apos;Digital Hub&apos;)),
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
NOT(ISBLANK( PMC_CPQ_DeliveryStartDate__c )),
NOT(ISBLANK( PMC_CPQ_DeliveryEndDate__c )),
PMC_CPQ_DeliveryEndDate__c - PMC_CPQ_DeliveryStartDate__c &lt;=0
)</errorConditionFormula>
        <errorMessage>Delivery Start Date should not be before the Delivery Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_DeliveryStartDateValidation</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT( CONTAINS($Profile.Name,&apos;Digital Hub&apos;)),
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
OR(AND(
 PMC_CPQ_DeliveryStartDate__c &lt; TODAY(), ISNEW()
),
IF(ISBLANK(PMC_CPQ_DeliveryStartDate__c ),false,
AND(
( DATEVALUE(DATETIMEVALUE(TEXT(YEAR(PMC_CPQ_DeliveryStartDate__c  ))&amp;&apos;-&apos;&amp; TEXT(MONTH(PMC_CPQ_DeliveryStartDate__c  ))&amp;&apos;-&apos;&amp;TEXT(DAY(PMC_CPQ_DeliveryStartDate__c  ))&amp;&apos; &apos;&amp; TEXT(TIMEVALUE(NOW())))) ) &lt; DATEVALUE(CreatedDate),
NOT(ISNEW())
)
)),
NOT(AND(ISCLONE(), ISNEW())),
NOT( TEXT(SBQQ__Type__c)=&quot;Amendment&quot;)
)</errorConditionFormula>
        <errorMessage>Delivery Start Date cannot be in the past.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_DraftStatusValidation</fullName>
        <active>true</active>
        <description>This validation rule is to restrict user from moving from draft to presented or accepted without going through approval process.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISPICKVAL( PRIORVALUE(SBQQ__Status__c ), &quot;Draft&quot;) ,
 NOT( ISPICKVAL(SBQQ__Status__c, &quot;Draft&quot;) ), 

 OR(
      ISPICKVAL(SBQQ__Status__c, &quot;Presented&quot;), 
   ISPICKVAL( SBQQ__Status__c , &quot;Accepted&quot;),
    ISPICKVAL( SBQQ__Status__c , &quot;Expired&quot;) 
 ),
  NOT( ISNEW() ) 
 

)</errorConditionFormula>
        <errorMessage>Please adhere to the sequential quote process: submit the quote for approval before moving to Presented or Accepted.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_ExpiredQuoteValidation</fullName>
        <active>false</active>
        <description>This Validation Rule will trigger whenever a expired quote is edited.</description>
        <errorConditionFormula>AND(
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ),
IF((AND(LastModifiedDate  &gt; PMC_CPQ_ExpiresOn__c, PMC_CPQ_Old_Value_Primary__c &lt;&gt;  SBQQ__Primary__c,  NOT(SBQQ__Primary__c))), false, 

If(AND (LastModifiedDate  &gt; PMC_CPQ_ExpiresOn__c,(PMC_CPQ_Old_Value_Primary__c =  SBQQ__Primary__c )), true,

 IF(LastModifiedDate  &lt; PMC_CPQ_ExpiresOn__c, false, true)))
    )</errorConditionFormula>
        <errorMessage>The quote has expired based on the expiration date/time. If you wish to continue with the quote, please click the ‘Clone with Related’ button.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_LaycanDateMissing</fullName>
        <active>false</active>
        <description>Kindly populate both Laycan Start and Laycan End Date.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISPICKVAL( PMC_CPQ_Region__c , &apos;North America&apos;),
NOT(ISBLANK( PMC_CPQ_LaycanStartDate__c )),
NOT(ISBLANK( PMC_CPQ_LaycanEndDate__c )),
OR(RecordType.DeveloperName = &apos;PMC_CPQ_International&apos;,
RecordType.DeveloperName = &apos;PMC_CPQ_InternationalDistribution&apos;
),
OR(
IF(NOT(ISBLANK( PMC_CPQ_LaycanStartDate__c )),IF(ISBLANK( PMC_CPQ_LaycanEndDate__c),true,false),false),
IF(NOT(ISBLANK( PMC_CPQ_LaycanEndDate__c)),IF(ISBLANK( PMC_CPQ_LaycanStartDate__c ),true,false),false)
))</errorConditionFormula>
        <errorDisplayField>SBQQ__Account__c</errorDisplayField>
        <errorMessage>Kindly populate both Laycan Start and Laycan End Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_LaycanStartDateBeforeEndDate</fullName>
        <active>false</active>
        <description>Laycan End Date should not be before the Laycan Start Date</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISPICKVAL( PMC_CPQ_Region__c , &apos;North America&apos;),
NOT(ISBLANK( PMC_CPQ_LaycanStartDate__c )),
NOT(ISBLANK( PMC_CPQ_LaycanEndDate__c )),
OR(RecordType.DeveloperName = &apos;PMC_CPQ_International&apos;,
RecordType.DeveloperName = &apos;PMC_CPQ_InternationalDistribution&apos;
),
PMC_CPQ_LaycanEndDate__c- PMC_CPQ_LaycanStartDate__c &lt;0
)</errorConditionFormula>
        <errorMessage>Laycan End Date should not be before the Laycan Start Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_LaycanStartDateValidation</fullName>
        <active>false</active>
        <description>In NA International and International Distribution quotes the Laycan start date should not be past</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
$Profile.Name &lt;&gt; &apos;Product Manager&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISPICKVAL( PMC_CPQ_Region__c , &apos;North America&apos;),
OR(RecordType.DeveloperName = &apos;PMC_CPQ_International&apos;,
 RecordType.DeveloperName = &apos;PMC_CPQ_InternationalDistribution&apos;
  ),
AND(!ISPICKVAL( SBQQ__Type__c , &apos;Amendment&apos;), !ISPICKVAL( SBQQ__Type__c , &apos;Renewal&apos;)),
ISPICKVAL( SBQQ__Status__c , &apos;Draft&apos;),
NOT(ISCLONE()),
PMC_CPQ_LaycanStartDate__c &lt; TODAY()
)</errorConditionFormula>
        <errorDisplayField>SBQQ__Account__c</errorDisplayField>
        <errorMessage>Laycan Start Date cannot be in the past.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_NAAmendmentQuoteCreation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
$UserRole.DeveloperName &lt;&gt; &quot;PMC_SS_NASalesServiceAnalystSSA&quot;,
$UserRole.DeveloperName &lt;&gt; &quot;PMC_SS_NASalesServiceRepresentativeSSR&quot;,
ISPICKVAL( PMC_CPQ_Region__c , &apos;North America&apos;),
Text(SBQQ__Type__c) = &quot;Amendment&quot;,
ISNEW()
)</errorConditionFormula>
        <errorMessage>Insufficient privilege to create Amendment Quotes. Only SSA or SSR is allowed to perform.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_PaymentBusinessDateValidation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),         
ISPICKVAL(  PMC_CPQ_Region__c  , &apos;Brazil&apos;),
    AND(
        NOT(ISBLANK(PMC_CPQ_PaymentDate__c)),
        OR(
                WEEKDAY(PMC_CPQ_PaymentDate__c) = 1,
                WEEKDAY(PMC_CPQ_PaymentDate__c) = 7
        )
    ),
OR(
NOT(ISNEW()),
AND(ISNEW(),ISBLANK(PMC_CPQ_LegacyQuoteID__c))
)
)</errorConditionFormula>
        <errorMessage>Please ensure that the Payment Date falls on a business day</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_PaymentDateBlankValidation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(   NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
    OR(
        CONTAINS(TEXT(SBQQ__PaymentTerms__c), &apos;Prepayment&apos;),
        CONTAINS(TEXT(SBQQ__PaymentTerms__c), &apos;Fixed Date&apos;)
    ),
    OR(
    ISBLANK(PMC_CPQ_PaymentDate__c),
    AND(
        NOT(ISBLANK(PMC_CPQ_PaymentDate__c)),
        PMC_CPQ_PaymentDate__c &lt; TODAY()
    )
    ),
ISPICKVAL(  PMC_CPQ_Region__c  , &apos;Brazil&apos;),
NOT(ISPICKVAL( SBQQ__Type__c ,&apos;Amendment&apos;)),
ISBLANK(PMC_CPQ_LegacyQuoteID__c)   
)</errorConditionFormula>
        <errorMessage>Payment Date is required when the Payment Method selected is &apos;Prepayment&apos; or &apos;Fixed Date&apos;. Payment Date must not be in the past</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_PrimaryContactBlank</fullName>
        <active>true</active>
        <description>Restricting users to create a quote without Primary Contact</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISBLANK( PMC_CPQ_PrimaryContact__c ), 
NOT(
OR(
ISPICKVAL( SBQQ__Type__c , &apos;Amendment&apos;),
ISPICKVAL( SBQQ__Type__c , &apos;Renewal&apos;),
ISBLANK(PMC_CPQ_LegacyQuoteID__c)
)
) 
)</errorConditionFormula>
        <errorMessage>Please populate Contact value in order to proceed with the quote</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_PrimaryMandatoryAtAcceptance</fullName>
        <active>true</active>
        <description>Quote Must be Primary at Accepted stage</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
NOT( RecordType.DeveloperName = &apos;PMC_CPQ_InternationalDistribution&apos;),
ISPICKVAL( SBQQ__Status__c , &quot;Accepted&quot;),
OR(
ISPICKVAL( PRIORVALUE( SBQQ__Status__c ) , &quot;Approved&quot;),
ISPICKVAL( PRIORVALUE( SBQQ__Status__c ) , &quot;Presented&quot;)
),
SBQQ__Primary__c = false 
)</errorConditionFormula>
        <errorMessage>Quote must be made primary at Accepted Stage</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_QuantityForQuoteLine</fullName>
        <active>false</active>
        <errorConditionFormula>AND (
 PMC_CPQ_TotalQuantity__c &gt;= 999000,
 PMC_CPQ_TotalDiscount__c = 0
)</errorConditionFormula>
        <errorMessage>Quantity is greater than what is allowed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_QuoteSubTypeForSalesOrg</fullName>
        <active>false</active>
        <errorConditionFormula>OR (

AND (
OR ( TEXT(00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGOvN ) = &apos;US01&apos;,
TEXT(00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGOvN ) = &apos;CA01&apos;,
TEXT(00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGOvN ) = &apos;BR05&apos;
),
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Feed&apos;))
),

AND (
TEXT(00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGOvN ) = &apos;CA02&apos;,
AND (
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Fertilizer&apos;)),
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Industrial&apos;)),
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Co-Products&apos;))
)
),

AND (
TEXT(00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGOvN ) = &apos;US07&apos;,
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Raw Material&apos;))
),

AND (
TEXT( 00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGOvN ) = &apos;US02&apos;,
AND (
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Fertilizer&apos;)),
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Industrial&apos;)),
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Co-Products&apos;)),
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Raw Material&apos;))
)
),

AND (
TEXT(00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGOvN ) = &apos;BR02&apos;,
ISPICKVAL (SBQQ__Account__r.PMC_SS_CustomerType__c, &apos;B2C&apos;),
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Fertilizer&apos;))
),

AND (
TEXT(00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGOvN ) = &apos;BR06&apos;,
ISPICKVAL (SBQQ__Account__r.PMC_SS_CustomerType__c, &apos;B2B&apos;), 
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Fertilizer&apos;))
),

AND (
TEXT(00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGOvN ) = &apos;BR08&apos;,
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Potash&apos;))
),

AND (
TEXT( 00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGOvN ) = &apos;BR07&apos;,
AND (
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Specialities&apos;)),
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Co-Products&apos;))
)
),

AND (
TEXT (00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGOvN ) = &apos;PY01&apos;,
ISPICKVAL (SBQQ__Account__r.PMC_SS_CustomerType__c, &apos;B2C&apos;),
NOT (ISPICKVAL (PMC_CPQ_QuoteRecordSubType__c, &apos;Paraguay&apos;))
)

)</errorConditionFormula>
        <errorMessage>The Quote Sub-Type Selected is inaccurate please check path guidance for accurate Sub-Type</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_QuoteSubmissionDeadline</fullName>
        <active>false</active>
        <description>This validation will prevent expiration date from getting updated when quote is submitted after friday 5pm</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
NOT(PMC_CPQ_ApprovalValidated__c)
)</errorConditionFormula>
        <errorMessage>Cannot Submit Quote for Approval after Friday 5 PM !!!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_QuoteSubmittedForApproval</fullName>
        <active>true</active>
        <description>This Validation Rule was configured to prevent AM from editing a Quote once a Quote is submitted for Approval.</description>
        <errorConditionFormula>AND(
    NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
    $Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
     AND(  ISPICKVAL( PRIORVALUE( ApprovalStatus__c ) , &apos;Pending&apos;) ,ISPICKVAL( ApprovalStatus__c , &apos;Pending&apos;) ) ,
    
    NOT(ISCHANGED(SubmittedUser__c)),  
    NOT(ISCHANGED(SubmittedDate__c))
)</errorConditionFormula>
        <errorMessage>You may not edit a Quote once it has been submitted for approval. If you wish to make any changes, click the &apos;Recall Approvals&apos; button</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_RailShipmentPeriodStart</fullName>
        <active>false</active>
        <description>In NA International quotes the Rail Shipment Period Start should not be past</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
$Profile.Name &lt;&gt; &apos;Product Manager&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISPICKVAL( PMC_CPQ_Region__c , &apos;North America&apos;),
RecordType.DeveloperName = &apos;PMC_CPQ_International&apos;,
AND(!ISPICKVAL( SBQQ__Type__c , &apos;Amendment&apos;), !ISPICKVAL( SBQQ__Type__c , &apos;Renewal&apos;)),
ISPICKVAL( SBQQ__Status__c , &apos;Draft&apos;),
NOT(ISCLONE()),
PMC_CPQ_RailShipmentPeriodStart__c &lt; TODAY()
)</errorConditionFormula>
        <errorDisplayField>SBQQ__Account__c</errorDisplayField>
        <errorMessage>Rail Shipment Period Start Date cannot be in the past.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_RailShipmentStartBeforeEndDate</fullName>
        <active>true</active>
        <description>Rail Shipment Period End should not be before the Rail Shipment Period Start.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
ISPICKVAL( PMC_CPQ_Region__c , &apos;North America&apos;),
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
NOT(ISBLANK( PMC_CPQ_RailShipmentPeriodStart__c )),
NOT(ISBLANK( PMC_CPQ_RailShipmentPeriodEnd__c )),
RecordType.DeveloperName = &apos;PMC_CPQ_International&apos;,
PMC_CPQ_RailShipmentPeriodEnd__c - PMC_CPQ_RailShipmentPeriodStart__c &lt;0
)</errorConditionFormula>
        <errorMessage>Rail Shipment Period End should not be before the Rail Shipment Period Start.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_RecordTypeForDistributionChannel</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c), 
OR (
AND (
Text(00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGP9K) = &quot;10&quot;,
NOT ( RecordType.Name  = &apos;Domestic&apos;)
),
AND (
Text(00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGP9K) = &quot;20&quot;,
NOT ( RecordType.Name= &apos;Domestic&apos;)
),
AND (
Text(00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGP9K) = &quot;30&quot;,
NOT (  RecordType.Name = &apos;International&apos;),
NOT(ISPICKVAL (00NDn00000ak0O7.00NDT00000QFgxo, &apos;Distributor&apos;))
),
AND (
Text(00NDn00000ak0Ob.00NDT00000QGF8l.00NDT00000QGP9K) = &quot;30&quot;,
NOT ( RecordType.Name= &apos;International Distribution&apos;),
ISPICKVAL (00NDn00000ak0O7.00NDT00000QFgxo, &apos;Distributor&apos;)
)
)
)</errorConditionFormula>
        <errorMessage>The Quote Record Type Selected and Opportunity&apos;s Distribution Channel are incorrectly mapped.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_RejectedReasonBlankOther</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISPICKVAL(PMC_CPQ_RejectedReason__c, &apos;Other&apos;),
ISBLANK(PMC_CLM_OtherRejectionReason__c)
)</errorConditionFormula>
        <errorDisplayField>PMC_CLM_OtherRejectionReason__c</errorDisplayField>
        <errorMessage>Populate &quot;Other Rejected Reason&quot; open text field before selecting &quot;Rejected Reason&quot; as &quot;Other.&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_RejectedValidation</fullName>
        <active>true</active>
        <description>Restricting user not to edit on Rejected Status.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
OR(
AND(ISPICKVAL(PRIORVALUE(SBQQ__Status__c), &quot;Rejected&quot;),NOT(ISPICKVAL(SBQQ__Status__c, &quot;Draft&quot;))),
AND(ISPICKVAL(PRIORVALUE (SBQQ__Status__c),&quot;Rejected&quot;),PMC_CPQ_QuoteOrigin__c = &quot;DH Request&quot;)
),
NOT(ISNEW())    
)</errorConditionFormula>
        <errorMessage>Once a Quote has been rejected, it can no longer be edited. Please click the &apos;Clone with Related&apos; button to continue quoting with the same data on a new quote</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_RequestQuoteRejectionReasonBlank</fullName>
        <active>true</active>
        <description>This Validation Rule was configured to prevent AM from Rejecting a Quote without selecting reason</description>
        <errorConditionFormula>AND(
    NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c) 
    ,
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
    ISCHANGED(SBQQ__Status__c), 
    ISPICKVAL(SBQQ__Status__c, &apos;Rejected&apos;),
    ISPICKVAL( PMC_CPQ_RejectedReason__c , &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>PMC_CPQ_RejectedReason__c</errorDisplayField>
        <errorMessage>Please provide the Rejection Reason before rejecting the quote</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_RestrictAMonApprovedandAccepted</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT( CONTAINS($Profile.Name,&apos;Digital Hub&apos;)),
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
OR(AND( ISPICKVAL(PRIORVALUE( SBQQ__Status__c),&quot;Approved&quot;),ISPICKVAL( SBQQ__Status__c , &quot;Approved&quot;) ),
AND( ISPICKVAL(PRIORVALUE( SBQQ__Status__c),&quot;Accepted&quot;), ISPICKVAL( SBQQ__Status__c , &quot;Accepted&quot;) ),AND( ISPICKVAL(PRIORVALUE( SBQQ__Status__c ), &quot;Presented&quot;),ISPICKVAL( SBQQ__Status__c , &quot;Presented&quot;) )
) ,
NOT(ISCHANGED( ApprovalStatus__c)),
NOT(ISCHANGED( PMC_CPQ_ExpiresOn__c)),
NOT(ISCHANGED(  PMC_CPQ_ExpirationDate__c  )),
NOT(ISCHANGED( PMC_CPQ_ExpirationTime__c )),
NOT(ISCHANGED( PMC_CPQ_IntegrationStatus__c)),
NOT(ISCHANGED( PMC_CPQ_IntegrationMessage__c)),
NOT(ISCHANGED( PMC_CPQ_SAPContractReference__c)),
NOT(ISCHANGED( PMC_CPQ_ContractShippingInstructions__c))
)</errorConditionFormula>
        <errorMessage>A Quote can only be edited while in the &apos;Draft&apos; Status. Please set the Quote Status to &apos;Draft&apos; in order to continue with any modifications</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_RestrictQuoteCreationSAPIDBlank</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISBLANK(SBQQ__Account__r.PMC_SS_SAPCustomerNumber__c),
ISNEW(),
NOT(CONTAINS($Profile.Name, &apos;Digital Hub&apos;)) 
)</errorConditionFormula>
        <errorMessage>A Quote cannot be created for an Account that is yet to be registered in SAP. Please wait until the SAP ID field has been populated on the Account indicating successful registration.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_RestrictUserToApproveQuote</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
AND(
ISCHANGED( SBQQ__Status__c ),
ISPICKVAL(SBQQ__Status__c, &apos;Approved&apos;)
),
NOT(ISPICKVAL(ApprovalStatus__c, &apos;Approved&apos;))
)</errorConditionFormula>
        <errorMessage>A Quote can only be &apos;Approved&apos; by clicking the &apos;Submit for Approval&apos; button and after receiving the required set of approvals</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_SAAmendmentQuoteCreation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
$UserRole.DeveloperName &lt;&gt; &quot;PMC_SS_SASalesServiceRepresentativeSSR&quot;,
ISPICKVAL( PMC_CPQ_Region__c , &apos;Brazil&apos;),
Text(SBQQ__Type__c) = &quot;Amendment&quot;,
ISNEW()
)</errorConditionFormula>
        <errorMessage>Insufficient privilege to create Amendment Quotes. Only SSA is allowed to perform amendments.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_SSAAccessForQuote</fullName>
        <active>true</active>
        <description>Restricting the SSA Role not to create quote based on the Quote Classification</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
$UserRole.Name =&quot;SA Sales Service Analyst (SSA)&quot;,
AND(
   OR(Text(PMC_CPQ_QuoteClassification__c) = &quot;Bid&quot;,   
      Text(PMC_CPQ_QuoteClassification__c) = &quot;Deal&quot;),
   Text(SBQQ__Type__c) = &quot;Quote&quot;)
 ,
ISNEW())</errorConditionFormula>
        <errorMessage>Sales Support Analyst can create only List and Amendment Quotes</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_SSRAccessForQuote</fullName>
        <active>false</active>
        <description>Restricting the SSR Role not to create quote based on the Quote Classification
will be deleted part of 9508 story</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name =&quot;Sales User&quot;,
$UserRole.Name =&quot;SA Sales Service Representative (SSR)&quot;,AND(Text(PMC_CPQ_QuoteClassification__c) != &quot;List&quot;,   
NOT(ISPICKVAL(SBQQ__Type__c,&apos;Amendment&apos;) )  ) ,
ISNEW())</errorConditionFormula>
        <errorMessage>Sales Service User can create only List and Amendment Quotes</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_SalesDirectorEditAccess</fullName>
        <active>false</active>
        <description>Restrict account manager role to prevent editing other account manager quote(poc)</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
NOT(ISNEW()),
NOT(ISCLONE()),
$UserRole.DeveloperName = &apos;PMC_CPQ_SalesDirector&apos;,

OR(

PMC_CPQ_AccountManager__r.UserRole.DeveloperName=&apos;PMC_NA_SalesManager&apos;,
PMC_CPQ_AccountManager__r.UserRole.DeveloperName =&apos;PMC_SA_B2BSalesManager&apos;,
PMC_CPQ_AccountManager__r.UserRole.DeveloperName = &apos;PMC_SA_B2CSalesManager&apos;,
PMC_CPQ_AccountManager__r.UserRole.DeveloperName = &apos;PMC_CPQ_SalesDirector&apos;
),
$User.Id &lt;&gt; PMC_CPQ_AccountManager__c

)</errorConditionFormula>
        <errorMessage>Oops! you don&apos;t have privilege to access this record</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_SalesManagerEditAccess</fullName>
        <active>false</active>
        <description>Restrict account manager role to prevent editing other account manager quote</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
NOT(ISNEW()),
NOT(ISCLONE()),
OR(
	$UserRole.DeveloperName = &apos;PMC_NA_SalesManager&apos;,
	$UserRole.DeveloperName = &apos;PMC_SA_B2BSalesManager&apos;,
	$UserRole.DeveloperName = &apos;PMC_SA_B2CSalesManager&apos;
),
OR(

PMC_CPQ_AccountManager__r.UserRole.DeveloperName=&apos;PMC_NA_SalesManager&apos;,
PMC_CPQ_AccountManager__r.UserRole.DeveloperName =&apos;PMC_SA_B2BSalesManager&apos;,
PMC_CPQ_AccountManager__r.UserRole.DeveloperName = &apos;PMC_SA_B2CSalesManager&apos;
),
$User.Id &lt;&gt; PMC_CPQ_AccountManager__c

)</errorConditionFormula>
        <errorMessage>Oops! you don&apos;t have privilege to access this record</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_ShortDescriptionForRejectedState</fullName>
        <active>true</active>
        <description>Short Description should be read only for Rejected Status</description>
        <errorConditionFormula>AND
(
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISPICKVAL( SBQQ__Status__c , &quot;Rejected&quot; ) , 
ISCHANGED( PMC_CPQ_QuoteShortNameDescription__c )
)</errorConditionFormula>
        <errorMessage>This field cannot be edited as Quote status has been Rejected.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_StartDateValidation</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
$Profile.Name &lt;&gt; &apos;Product Manager&apos;,
NOT( CONTAINS($Profile.Name,&apos;Digital Hub&apos;)),
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
AND(!ISPICKVAL( SBQQ__Type__c , &apos;Amendment&apos;), !ISPICKVAL( SBQQ__Type__c , &apos;Renewal&apos;)),
ISPICKVAL( SBQQ__Status__c , &apos;Draft&apos;),
OR( PMC_CPQ_ContractStart__c &lt;  TODAY(),  PMC_CPQ_LaycanStartDate__c &lt; TODAY(),
PMC_CPQ_RailShipmentPeriodStart__c &lt; TODAY(),
PMC_CPQ_DeliveryStartDate__c  &lt; TODAY())
)</errorConditionFormula>
        <errorMessage>Contract Start or Laycan Start or Rail Shipment Start or Delivery Start cannot be less than today.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_CPQ_VCOQuoteDeliveryRegion</fullName>
        <active>false</active>
        <description>marked for deletion not in use</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
 $Profile.Name =&apos;Sales User&apos;,
 PMC_CPQ_VCOQuotation__c ,
 ISPICKVAL( PMC_CPQ_DeliveryRegion__c , &quot;&quot;) 
)</errorConditionFormula>
        <errorMessage>Delivery region is Mandatory for VCO Quotes</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Quote_is_approved_field_cannot_be_edited</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
$Profile.Name &lt;&gt; &apos;System Administrator&apos;,
$Profile.Name &lt;&gt; &apos;API Only profile&apos;,
NOT(ISCHANGED( PMC_CPQ_FlowVRByPassToggle__c )),
ISPICKVAL( PMC_CPQ_Region__c , &apos;Brazil&apos;),
PMC_CPQ_QuoteApproved__c,
OR(
ISCHANGED(PMC_CPQ_VCOQuotation__c),
ISCHANGED(PMC_CPQ_AdvanceBilling__c),
ISCHANGED(PMC_CPQ_SoldToShipToJunction__c),
ISCHANGED(PMC_CPQ_UnitOfMeasure__c),
ISCHANGED(PMC_CPQ_DiscountMarkup__c),
ISCHANGED(PMC_CPQ_DeliveryStartDate__c),
ISCHANGED(PMC_CPQ_DeliveryEndDate__c),
ISCHANGED(PMC_CPQ_CropType__c),
ISCHANGED(SBQQ__PaymentTerms__c),
ISCHANGED(PMC_CPQ_PaymentDate__c),
ISCHANGED(PMC_CPQ_PriceBookType__c),
ISCHANGED(PMC_CPQ_SalesAreaCombination__c)
))</errorConditionFormula>
        <errorMessage>User cannot change the approved quote field value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__End_Date_Before_Start_Date</fullName>
        <active>true</active>
        <description>Validates End Date comes after the Start Date</description>
        <errorConditionFormula>IF( AND( NOT(ISNULL(SBQQ__EndDate__c)), SBQQ__EndDate__c &lt; SBQQ__StartDate__c), TRUE, null)</errorConditionFormula>
        <errorMessage>The End Date must come after the Start Date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Invalid_First_Segment_Term_End_Date</fullName>
        <active>false</active>
        <errorConditionFormula>NOT(ISNULL(SBQQ__FirstSegmentTermEndDate__c)) &amp;&amp; NOT(ISNULL(SBQQ__StartDate__c)) &amp;&amp; (NOT(ISNULL(SBQQ__SubscriptionTerm__c)) || NOT(ISNULL(SBQQ__EndDate__c))) &amp;&amp;
            (SBQQ__FirstSegmentTermEndDate__c &lt; SBQQ__StartDate__c || IF(NOT(ISNULL(SBQQ__EndDate__c)),SBQQ__FirstSegmentTermEndDate__c &gt; SBQQ__EndDate__c, IF(LOWER($Setup.SBQQ__GeneralSettings__c.SBQQ__SubscriptionTermUnit__c)=&apos;day&apos;, SBQQ__FirstSegmentTermEndDate__c &gt; SBQQ__StartDate__c + SBQQ__SubscriptionTerm__c-1, SBQQ__FirstSegmentTermEndDate__c &gt; SBQQ__StartDate__c + (SBQQ__SubscriptionTerm__c * 30.4375))))</errorConditionFormula>
        <errorDisplayField>SBQQ__FirstSegmentTermEndDate__c</errorDisplayField>
        <errorMessage>First Segment Term End Date must fall between Quote Start Date and Quote End Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Invalid_Subscription_Term</fullName>
        <active>true</active>
        <description>Validates that subscription term is positive</description>
        <errorConditionFormula>IF( AND( NOT(ISNULL(SBQQ__SubscriptionTerm__c)), SBQQ__SubscriptionTerm__c &lt;= 0), TRUE, null)</errorConditionFormula>
        <errorMessage>The subscription term must be a positive number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Test_Quote_Validation_Rule</fullName>
        <active>false</active>
        <errorConditionFormula>PMC_CPQ_IsSubmissionReady__c</errorConditionFormula>
        <errorMessage>Cannot Submit Quote for Approval after Friday 5 PM !!!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Vignesh_Test_validation</fullName>
        <active>false</active>
        <description>Test</description>
        <errorConditionFormula>TEXT( PMC_CPQ_IntegrationStatus__c ) == &quot;Error&quot;</errorConditionFormula>
        <errorMessage>Vignesh Integration Test error</errorMessage>
    </validationRules>
