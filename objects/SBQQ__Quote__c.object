            <valueSettings>
                <controllingFieldValue>Rejected</controllingFieldValue>
                <valueName>Shipment Window not appropriate</valueName>
            </valueSettings>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMC_CPQ_RejectionReason__c</fullName>
        <description>This field is created as a part of story to handle/store value of Rejection Reason for any Quote.</description>
        <encryptionScheme>None</encryptionScheme>
        <inlineHelpText>Reason for which the Quote was rejected</inlineHelpText>
        <label>Rejection Reason</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_RemittanceRegion__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <inlineHelpText>Field to hold Remittance Region</inlineHelpText>
        <label>Remittance Region</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ReplacementMargin__c</fullName>
        <label>Replacement margin</label>
        <summarizedField>SBQQ__QuoteLine__c.PMC_CPQ_ReplacementCost__c</summarizedField>
        <summaryForeignKey>SBQQ__QuoteLine__c.SBQQ__Quote__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_RequestStatusDuration__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL(SBQQ__Status__c , &quot;Request&quot;) &amp;&amp; NOT( ISBLANK( PMC_CPQ_QuoteInRequestStatusTime__c  ) ) , TEXT(ROUND(  PMC_CPQ_PriorRequestStatusDuration__c  +((NOW() - PMC_CPQ_QuoteInRequestStatusTime__c )*24),1))&amp;&apos; Hours&apos; , TEXT( PMC_CPQ_PriorRequestStatusDuration__c  ) &amp;&apos; Hours&apos; )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Request Status Duration</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_RequestedExpirationDateNumber__c</fullName>
        <externalId>false</externalId>
        <formula>UNIXTIMESTAMP( PMC_CPQ_RequestedExpirationDateTime__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Requested Expiration Date Number</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_RequestedExpirationDateTime__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <label>Requested Expiration Date/Time</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_RollupSeedzPoints__c</fullName>
        <description>This field populates the Rolled up seez points which is used Only for Brazil Account Managers</description>
        <label>Rolled-up Seedz Points</label>
        <summarizedField>SBQQ__QuoteLine__c.SBQQ__BatchQuantity__c</summarizedField>
