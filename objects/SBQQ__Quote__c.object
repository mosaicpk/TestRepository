    <fields>
        <fullName>PMC_CPQ_SalesOrg__c</fullName>
        <description>Pull the Sales Org Value from Opportunity/Account/SalesOrg Object</description>
        <externalId>false</externalId>
        <formula>LEFT( PMC_CPQ_SalesArea__r.PMC_SS_SalesArea__r.PMC_CPQ_SAPSalesOrganization__c ,4)</formula>
        <label>Sales Org</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_SecondaryBusinessType__c</fullName>
        <label>Secondary Business Type</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>PMC_CPQ_QuoteBusinessType</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMC_CPQ_SellingPriceCompetitor__c</fullName>
        <description>Field to hold the competitor selling price</description>
        <label>Selling Price (Competitor)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ServiceDirectorUser__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Service Director User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>CPQ_Quotes</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ShipTo__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Ship To</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>CPQ Quotes (Ship To)</relationshipLabel>
        <relationshipName>CPQ_Quotes</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_SignatureDateSent__c</fullName>
        <description>This field will be used to store the date at which the signature will be sent.</description>
        <encryptionScheme>None</encryptionScheme>
        <label>Signature Date Sent</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_SignatureTimeSent__c</fullName>
        <description>This field will be used to store the time at which the signature will be sent.</description>
        <label>Signature Time Sent</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Time</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_SoldToShipToJunction__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Ship To</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>PMC_SS_AccountPartnerRelationships__c.PMC_SS_Account__c</field>
                <operation>equals</operation>
                <valueField>$Source.SBQQ__Account__c</valueField>
            </filterItems>
            <filterItems>
                <field>PMC_SS_AccountPartnerRelationships__c.PMC_SS_Type__c</field>
                <operation>equals</operation>
                <value>Ship-to</value>
            </filterItems>
            <filterItems>
                <field>PMC_SS_AccountPartnerRelationships__c.PMC_SS_RelatedAccountSalesArea__c</field>
                <operation>equals</operation>
                <valueField>$Source.PMC_CPQ_SalesArea__c</valueField>
            </filterItems>
            <filterItems>
                <field>PMC_SS_AccountPartnerRelationships__c.PMC_SS_RelatedAccountSalesArea__c</field>
                <operation>notEqual</operation>
                <value></value>
            </filterItems>
            <filterItems>
                <field>PMC_SS_AccountPartnerRelationships__c.PMC_SS_RelatedAccount__r.PMC_SS_SAPCustomerNumber__c</field>
                <operation>notEqual</operation>
                <value></value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>PMC_SS_AccountPartnerRelationships__c</referenceTo>
        <relationshipLabel>CPQ Quotes</relationshipLabel>
        <relationshipName>CPQ_Quotes</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_SubmissionDate__c</fullName>
        <description>This field is created as a part of story to handle/store value of Submission Date for any Quote.</description>
        <encryptionScheme>None</encryptionScheme>
        <label>Submission Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_SumOfLineTotalPrice__c</fullName>
        <label>Sum of Line Total Price</label>
        <summarizedField>SBQQ__QuoteLine__c.PMC_CPQ_LineTotalPrice__c</summarizedField>
        <summaryForeignKey>SBQQ__QuoteLine__c.SBQQ__Quote__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_SystemUserBackend__c</fullName>
        <defaultValue>$Label.PMC_CPQ_SystemUserBackend</defaultValue>
        <description>This field is used to bypass Quote Expiration Validation rule for System User</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>System User Backend</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_TargetPriceMaximumDiffrence__c</fullName>
        <label>Target Price (Maximum Diffrence))</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_TimeCheck__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Time check</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_TimeZoneOffset__c</fullName>
        <externalId>false</externalId>
        <formula>IF( TEXT($User.TimeZoneSidKey) == &apos;America/Bahia&apos;, &apos;-3&apos; , IF(TEXT($User.TimeZoneSidKey) == &apos;America/Los_Angeles&apos;, &apos;-7&apos; , IF(TEXT($User.TimeZoneSidKey) == &apos;America/New_York&apos;, &apos;-4&apos; , IF(TEXT($User.TimeZoneSidKey) == &apos;Asia/Kolkata&apos;, &apos;5.3&apos; , &apos;0&apos;))))</formula>
        <label>Time Zone Offset</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
