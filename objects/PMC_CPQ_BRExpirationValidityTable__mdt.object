<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This custom metadata table will be used to store the number of days from which the Quote should expire based on Quote Classification.</description>
    <fields>
        <fullName>PMC_CPQ_BusinessType__c</fullName>
        <description>The Primary Business type of the metadata record.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Business Type</label>
        <length>64</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_Classification__c</fullName>
        <description>The type of Quote Classification.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Classification</label>
        <length>32</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_NumberOfDays__c</fullName>
        <description>The number of days from which the quote should be expired.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Number Of Days</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>BR Expiration Validity Table</label>
    <pluralLabel>BR Expiration Validity Tables</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
