<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This is to configure Sales Region ranges.</description>
    <fields>
        <fullName>PMC_CPQ_EndValue__c</fullName>
        <description>End Value of the Sales Region range</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>End value is included in range.</inlineHelpText>
        <label>End Value</label>
        <precision>6</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_Region__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Region</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Brazil</fullName>
                    <default>false</default>
                    <label>Brazil</label>
                </value>
                <value>
                    <fullName>Global</fullName>
                    <default>false</default>
                    <label>Global</label>
                </value>
                <value>
                    <fullName>North America</fullName>
                    <default>false</default>
                    <label>North America</label>
                </value>
                <value>
                    <fullName>Canada</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Canada</label>
                </value>
                <value>
                    <fullName>US</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>US</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMC_CPQ_StartValue__c</fullName>
        <description>Start value of the Sales Region Range.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Start value is included in range.</inlineHelpText>
        <label>Start Value</label>
        <precision>6</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Sales Region Range Setting</label>
    <pluralLabel>Sales Region Range Settings</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
