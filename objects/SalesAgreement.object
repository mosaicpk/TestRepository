    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>PMC_SS_RestrictSalesAgmtEditWhenArchived</fullName>
        <active>true</active>
        <description>Restrict Edit or Update of Sales Agreement when the Status is Archived.</description>
        <errorConditionFormula>AND(
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ) ,
ISPICKVAL(  PRIORVALUE(Status) , &apos;Archived&apos;)  
)</errorConditionFormula>
        <errorMessage>Archived Sales Agreement cannot be updated.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_RestrictSalesAgreementEdit</fullName>
        <active>true</active>
        <description>Prevents user from editing a Sales Agreement if it is Under Revision or Approved.</description>
        <errorConditionFormula>AND(
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ) ,
OR( ISCHANGED(OwnerId),
ISCHANGED(Name),
ISCHANGED(StartDate),
ISCHANGED(AccountId),
ISCHANGED(ScheduleFrequency),
ISCHANGED(ScheduleCount),
ISCHANGED(CurrencyIsoCode),
ISCHANGED(EndDate),
ISCHANGED(ProductLevel),
ISCHANGED(Description),
ISCHANGED(ActualsCalculationMode),
ISCHANGED(PMC_SS_UnitofMeasure__c),
ISCHANGED(PMC_SS_AgreementType__c),
ISCHANGED(PMC_SS_Pricing__c),
ISCHANGED(PMC_SS_TotalPotentialIncentives__c),
ISCHANGED(PMC_SS_TotalGrowthIncentives__c),
ISCHANGED(PMC_SS_TotalExSpaceIncentives__c),
ISCHANGED(PMC_SS_TotalVolumeIncentives__c),
ISCHANGED(PMC_SS_PreviousStatus__c  ),
ISCHANGED(PMC_SS_AgreementType__c ),
ISCHANGED(PMC_SS_SalesAgreementExternalId__c )
),
NOT(OR(ISPICKVAL(PMC_SS_ApprovalStatus__c,&apos;Not Submitted&apos;), ISPICKVAL(PMC_SS_ApprovalStatus__c,&apos;Denied&apos;)))
)</errorConditionFormula>
        <errorDisplayField>AccountId</errorDisplayField>
        <errorMessage>This Sales Agreement can’t be edited at this stage. Please reach out to your Salesforce Administrator for assistance.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_RestrictStatusChangeAfterApproved</fullName>
        <active>true</active>
        <description>Restrict the Sales Agreement to move it from Approved to Draft.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c) ,
ISCHANGED( Status ),
ISPICKVAL(PRIORVALUE(Status),&quot;Approved&quot;),
(ISPICKVAL( Status , &apos;Draft&apos;) || ISPICKVAL( Status , &apos;Archived&apos;))
)</errorConditionFormula>
        <errorMessage>Sales Agreement can’t be moved from Approved to other stage. Please amend the Sales Agreement to make any changes.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_RestrictStatusJustPendingWithCust</fullName>
        <active>true</active>
        <description>This validation rule ensures that Sales agreement status cannot be manually changed to Pending with Customer.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
ISPICKVAL( Status , &apos;Pending with Customer&apos;),
NOT(ISPICKVAL( PMC_SS_ApprovalStatus__c , &apos;Approved&apos;))
)</errorConditionFormula>
        <errorMessage>Sales Agreement must be approved internally prior to sending to customer, therefore this SA cannot be created/updated with the status of &quot;Pending with Customer&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_RestrictStatusPendingCustToDraft</fullName>
        <active>true</active>
        <description>This validation rule ensures that Sales agreement status cannot be moved from Pending with Customer to Draft or Approved.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
ISCHANGED( Status ),
ISPICKVAL(PRIORVALUE(Status),&apos;Pending with Customer&apos;),
OR(
ISPICKVAL( Status , &apos;Draft&apos;),
ISPICKVAL( Status , &apos;Archived&apos;)
)
)</errorConditionFormula>
        <errorMessage>This agreement has already been approved, therefore it cannot be moved to Draft or Archived. Please amend the new Sales Agreement if modifications are needed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_RestrictStatusPendingWithCustomer</fullName>
        <active>false</active>
        <description>This validation rule ensures that Sales agreement status cannot be manually changed to Pending with Customer. Also, status cannot be moved from Pending with Customer to Draft or Approved.</description>
        <errorConditionFormula>AND(
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c) ,
OR(

AND(
 ISPICKVAL( Status , &apos;Pending with Customer&apos;),
 NOT(ISPICKVAL(  PMC_SS_ApprovalStatus__c  , &apos;Approved&apos;)) 
),

AND(
ISCHANGED( Status ),
ISPICKVAL(PRIORVALUE(Status),&apos;Pending with Customer&apos;),
OR(
ISPICKVAL( Status , &apos;Draft&apos;),
ISPICKVAL( Status , &apos;Archived&apos;)
)
)

)

)</errorConditionFormula>
        <errorMessage>Sales Agreement can&apos;t be created with &apos;Pending with Customer&apos; status or manually updated to/from &apos;Pending with Customer&apos; status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SP10ValidationRule</fullName>
        <active>false</active>
        <description>Test</description>
        <errorConditionFormula>ISCHANGED(Status) &amp;&amp; ISPICKVAL( Status, &apos;Activated&apos;)</errorConditionFormula>
        <errorMessage>Error Message Test</errorMessage>
    </validationRules>
