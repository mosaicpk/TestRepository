    <recordTypes>
        <fullName>PMC_SS_AnnualSalesAgreement</fullName>
        <active>true</active>
        <description>South America Sales Agreement</description>
        <label>Annual Sales Agreement</label>
        <picklistValues>
            <picklist>CancellationReason</picklist>
            <values>
                <fullName>Changes in Circumstance</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Changes to Terms</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Dispute</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Error Correction</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>New Product Interests</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>PMC_CLM_AgreementDocumentStatus__c</picklist>
            <values>
                <fullName>Accepted</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Partially Signed</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Pending Signatures</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>PMC_SS_AgreementType__c</picklist>
            <values>
                <fullName>Annual Sales Agreement</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Business Partner Agreement</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Ex-Space Agreement</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Master Sales Agreement</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>PMC_SS_AmendedReason__c</picklist>
            <values>
                <fullName>Changes in Circumstance</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Changes to Terms</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Dispute</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Error Correction</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>New Product Interests</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>PMC_SS_ApprovalStatus__c</picklist>
            <values>
                <fullName>Approved</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Denied</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Not Submitted</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>Under Revision</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>PMC_SS_UnitofMeasure__c</picklist>
            <values>
                <fullName>L</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>LTN</fullName>
                <default>false</default>
