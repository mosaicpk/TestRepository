    <fields>
        <fullName>PMC_CLM_ProductTierAppend__c</fullName>
        <description>This field will be used to concatenate Product Family and Scale Level - so that data ordering can be enabled while pulling data in DocuSign.
To be used completely for backend purposes</description>
        <externalId>false</externalId>
        <formula>TEXT(PMC_SS_ProductFamily__c) &amp; TEXT( PMC_SS_ScaleLevel__c )</formula>
        <label>ProductTierAppend</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CLM_ProgramRebateType__c</fullName>
        <description>This field will be used to get the value of Type field of Rebate Type record associated with Program Rebate Type Benefit</description>
        <externalId>false</externalId>
        <formula>TEXT(ProgramRebateType.PMC_SS_Type__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Program Rebate Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
