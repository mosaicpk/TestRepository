    <fields>
        <fullName>PMC_CPQ_Address__c</fullName>
        <description>This field was created as part of US to store/handle complete Detailed Address for Location.</description>
        <externalId>false</externalId>
        <formula>PMC_CPQ_Location__r.PMC_CPQ_Street__c + &apos; &apos; + PMC_CPQ_Location__r.PMC_CPQ_City__c + &apos; &apos; + PMC_CPQ_Location__r.PMC_CPQ_Region__c + &apos; &apos; +  PMC_CPQ_Location__r.PMC_CPQ_Country__c + &apos; &apos;+ PMC_CPQ_Location__r.PMC_CPQ_PostalCode__c</formula>
        <label>Address</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_DeletionIndicator__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field is created  to check if the field is considered for Deletion.</description>
        <label>Deletion Indicator</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
