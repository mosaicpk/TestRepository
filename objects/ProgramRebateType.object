    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>false</enableFeeds>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>AccrualRate</fullName>
        <description>The rate you want to accrue at for the rebate program member. This rate is in the same units as the specified measure type, for example percent or amount. This field is available in API version 52.0 and later.</description>
        <inlineHelpText>The rate of accrual based on the value selected in the Measure Type field. For example, when the measure type is percent and you enter 10, the accrual rate is 10%.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>AggregateObjectName</fullName>
        <description>Name of the custom aggregation entity. For example, RebateMemberProductAggregate.</description>
        <inlineHelpText>The object that stores the aggregation results.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>BenefitQualifierField</fullName>
        <description>Represents an attribute in the aggregate object whose value will be used, in conjunction with Aggregate Field and Rebate Type Benefit Field attributes from the PgmRebateTypBnftMapping entity, to determine the Benefit Value from the ProgramRebateTypeBenefit entity.</description>
        <inlineHelpText>The aggregation object field to use as the basis for calculating minimum and maximum qualifying benefit values.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>CalcObjectId</fullName>
        <description>Specifies the data processing engine definition used for the calculation. Only active data processing engine definitions can be used.</description>
        <inlineHelpText>Calculation definitions are managed in the Data Processing Engine.</inlineHelpText>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CalculationBasis</fullName>
        <description>Specify the basis for rebate amount calculation.</description>
        <inlineHelpText>Specify the basis for rebate amount calculation.Payout calculates the payout amount based on the benefit setup. Accrual calculates payouts based on the accrual rate, when provided, or the benefit setup. Payout and Accrual uses both methods to calculate the payout.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>CalculationMethod</fullName>
        <description>Specifies the rule for calculating rebate benefits.</description>
        <inlineHelpText>Applies to tiered benefits with Measure Type of Percent of Revenue and Amount per unit. Use Stepped to apportion the payout based on tiers and Retrospective to apply full benefit on the amount/quantity.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>CalculationType</fullName>
        <description>Type of calculation for the rebate type.</description>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>CurrencyIsoCode</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>FilterAction</fullName>
        <description>Contains the filter action options that are offered</description>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>FilterLogic</fullName>
        <description>Contains the filter criteria options that are offered - AND, OR, Custom.</description>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Formula</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IsIntegratable</fullName>
        <description>This field determines if the rebate type record is of type template or not, based on which the record can be associated with an opportunity,contract, quote, or any other eligible object.</description>
        <inlineHelpText>When selected, this rebate type appears in the list of rebate types that can be applied to records like orders, quotes, or opportunities.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>MeasureField</fullName>
        <description>Stores the reference to the aggregate object that will be used for rebate amount calculations based on the measure type selected and the benefit value fetched.</description>
        <inlineHelpText>The aggregation object field used with measure type and benefit value to calculate the rebate amount. This is required for the Amount per Unit and Percentage of Revenue measure types.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Name</fullName>
        <description>Name of the program rebate type.</description>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>OwnerId</fullName>
        <description>Specifies the owner of the Rebate Program</description>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PMC_CLM_ParentRebateProgramOrder__c</fullName>
        <description>Backend Field Used by the CLM system to associate Rebate Programs Calculation fields with the correct Rebate Program data</description>
        <externalId>false</externalId>
        <formula>RebateProgram.PMC_CLM_RebateProgramOrder__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ParentRebateProgramOrder</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_SS_Forecasted_Quantity__c</fullName>
        <externalId>false</externalId>
        <label>Forecasted Quantity</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_SS_ProductFamily__c</fullName>
        <description>Captures Product Family to cater towards the SAP integration</description>
        <label>Product Family</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>PMC_SS_ProductFamilies</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMC_SS_Projected_Incentive__c</fullName>
