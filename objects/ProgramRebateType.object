    <fields>
        <fullName>ProductFilterType</fullName>
        <description>The criteria to be applied for the products present in the Included or Excluded Products list.</description>
        <inlineHelpText>Select the criteria to be applied to the products in the Included or Excluded Products list.</inlineHelpText>
