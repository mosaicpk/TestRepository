    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>AccountId</fullName>
        <description>Specifies the Account</description>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ContactId</fullName>
        <description>Specifies the Contact</description>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>EndDate</fullName>
        <description>Specifies the End Date of the Relationship</description>
    </fields>
    <fields>
        <fullName>IsActive</fullName>
        <description>Specifies if Account is Active</description>
    </fields>
    <fields>
        <fullName>IsDirect</fullName>
        <description>Indicates whether the account associated with the contact is the contact&apos;s primary account (true) or not (false)</description>
    </fields>
    <fields>
        <fullName>PMC_DH_isProcessed__c</fullName>
        <defaultValue>false</defaultValue>
