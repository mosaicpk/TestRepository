    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>PMC_CPQ_OrdersReadOnly</fullName>
        <active>true</active>
        <description>This rule is to prevent users from editing Order record except Integration User and System Administrator.</description>
        <errorConditionFormula>AND(
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
AND(NOT($Profile.Name = &quot;System Administrator&quot;),NOT($Profile.Name = &quot;API Only profile&quot;),NOT($Profile.Name = &quot;Salesforce API Only System Integrations&quot;),NOT( CONTAINS($Profile.Name,&apos;Digital Hub&apos;))),
NOT(ISNEW())
)</errorConditionFormula>
        <errorMessage>This Order has been placed and is therefore locked from further modifications. Any updates from SAP will be reflected here.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SBQQ__Cannot_Contract_New_Order</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISNEW(), SBQQ__Contracted__c)</errorConditionFormula>
        <errorDisplayField>SBQQ__Contracted__c</errorDisplayField>
        <errorMessage>Can&apos;t contract the order. Activate the order and try again.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>SBQQ__EditOrderProducts</fullName>
