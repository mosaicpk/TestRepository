    </webLinks>
    <webLinks>
        <fullName>SDOC__Add_to_Mass_Merge_List</fullName>
        <availability>online</availability>
        <description>To create Add to Mass Merge List button for Contact, follow the S-Docs documentation titled &quot;Mass Merge &amp; Batch Document Feature&quot;. Note: for Contact specifically, be sure to use the API Name: Add_Contact_to_Mass_Merge_List</description>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Deprecated: Not For Use</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/{!Contact.Id}</url>
    </webLinks>
