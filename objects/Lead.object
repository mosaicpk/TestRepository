    <fields>
        <fullName>import_id__c</fullName>
        <description>Field that helps identify different import files</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>Import ID</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>lead_utm_campaign__c</fullName>
        <description>UTM Campaign field that Identifies the campaign.</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>UTM Campaign</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>lead_utm_content__c</fullName>
        <description>UTM Content field that Identifies the content zone, such as a call-to-action message.</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>UTM Content</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>lead_utm_medium__c</fullName>
        <description>UTM Medium field that Identifies the medium, such as a search engine, a social media platform, or another platform.</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>UTM Medium</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>lead_utm_source__c</fullName>
        <description>UTM Source that Identifies the source of the traffic, such as Google, Websites, Banner Ads, or AdWords.  (This can be different than Lead Source)</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>UTM Source</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>lead_utm_term__c</fullName>
        <description>UTM Term field that Identifies keywords that generate clicks.</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>UTM Term</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
