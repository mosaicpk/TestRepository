    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>PMC_SS_PopulateAddressonLead</fullName>
        <active>true</active>
        <description>Restricts the users to update the status as Sales Qualified and Converted if the Address if Blank</description>
        <errorConditionFormula>AND(
     NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c), 
     ISBLANK(Address),
     ISCHANGED(Status),
     OR(
	 ISPICKVAL(Status,&apos;Sales Qualified&apos;),
	 ISPICKVAL(Status,&apos;Converted&apos;)  
       )	
)</errorConditionFormula>
        <errorMessage>Please ensure that this lead has an Address prior to marking the Lead Status as Sales Qualified or Converted</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_PreventStatusChangetoConverted</fullName>
        <active>false</active>
        <description>This validation rule does not allow a user with Marketing user profile to change Lead status to converted.</description>
        <errorConditionFormula>AND(
 NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c) ,
 $Profile.Name = &apos;PMC Marketing User&apos; ,   
      ISCHANGED( Status ) , 
      ISPICKVAL( Status , &apos;Converted&apos;) 
)</errorConditionFormula>
        <errorMessage>Marketing Users are not able to convert Leads</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ReqFieldsToChangeStatusSAL_Crops</fullName>
        <active>true</active>
        <description>Crops Field value should be entered in order to convert Lead Status to SAL</description>
        <errorConditionFormula>AND (
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
(
IF(ISBLANK(PMC_SS_Crops__c), 0, 1) 

)&lt;1,
OR(ISCHANGED(Status),ISNEW()),
ISPICKVAL(Status,&apos;SAL&apos;)
)</errorConditionFormula>
        <errorDisplayField>PMC_SS_Crops__c</errorDisplayField>
        <errorMessage>Please fill out Crops field value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ReqFieldsToChangeStatusSAL_Email</fullName>
        <active>true</active>
        <description>Email Field value should be entered in order to convert Lead Status to SAL</description>
        <errorConditionFormula>AND (
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
(
IF(ISBLANK(Email), 0, 1) 

)&lt;1,
OR(ISCHANGED(Status),ISNEW()),
ISPICKVAL(Status,&apos;SAL&apos;)
)</errorConditionFormula>
        <errorDisplayField>Email</errorDisplayField>
        <errorMessage>Please fill out Email field value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ReqFieldsToChangeStatusSAL_Farm</fullName>
        <active>true</active>
        <description>Farm Size Field value should be entered in order to convert Lead Status to SAL</description>
        <errorConditionFormula>AND (
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
(
IF(ISBLANK(PMC_DH_FarmSize__c), 0, 1) 

)&lt;1,
OR(ISCHANGED(Status),ISNEW()),
ISPICKVAL(Status,&apos;SAL&apos;)
)</errorConditionFormula>
        <errorDisplayField>PMC_DH_FarmSize__c</errorDisplayField>
        <errorMessage>Please fill out Farm Size field value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ReqFieldsToChangeStatusSAL_Phone</fullName>
        <active>true</active>
        <description>Phone Field value should be entered in order to convert Lead Status to SAL</description>
        <errorConditionFormula>AND (
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
(
IF(ISBLANK(Phone), 0, 1) 

)&lt;1,
OR(ISCHANGED(Status),ISNEW()),
ISPICKVAL(Status,&apos;SAL&apos;)
)</errorConditionFormula>
        <errorDisplayField>Phone</errorDisplayField>
        <errorMessage>Please fill out Phone field value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ReqFieldsToChangeStatusSAL_Postal</fullName>
        <active>true</active>
        <description>Postal Code Field value should be entered in order to convert Lead Status to SAL</description>
        <errorConditionFormula>AND (
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
(
IF(ISBLANK(PostalCode), 0, 1) 

)&lt;1,
OR(ISCHANGED(Status),ISNEW()),
ISPICKVAL(Status,&apos;SAL&apos;)
)</errorConditionFormula>
        <errorDisplayField>PostalCode</errorDisplayField>
        <errorMessage>Please fill out the Zip/Postal Code field value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_RequiredFieldsToChangeStatusSAL</fullName>
        <active>false</active>
        <description>Preventing Status change to SAL if the fields are NULL</description>
        <errorConditionFormula>AND (
NOT($Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),
 (IF(ISBLANK(FirstName), 0, 1) +
        IF(ISBLANK(LastName), 0, 1) +
        IF(ISBLANK(Email), 0, 1) +
        IF(ISBLANK(Phone), 0, 1) +
        IF(ISBLANK(PMC_SS_Crops__c), 0, 1)+
        IF(ISBLANK(PMC_DH_FarmSize__c), 0, 1)+
        IF(ISBLANK(PostalCode), 0, 1)
    )&lt;7,
OR(ISCHANGED(Status),ISNEW()),
ISPICKVAL(Status,&apos;SAL&apos;)
)</errorConditionFormula>
        <errorMessage>First Name, Last Name ,Email, Phone, Crops, Farm size and Postal code should not be empty.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_RequiredRejectionReason</fullName>
        <active>true</active>
        <description>This validation rule checks that the Rejection Reason field is populated before the Lead status is changed to &quot;Lost&quot;</description>
        <errorConditionFormula>AND(
 NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ) ,
  OR ( ISCHANGED ( Status ), ISNEW() ) ,
 ISPICKVAL( Status , &apos;Lost&apos;),
 ISBLANK(  TEXT(PMC_SS_RejectionReason__c) )  
)</errorConditionFormula>
        <errorDisplayField>PMC_SS_RejectionReason__c</errorDisplayField>
        <errorMessage>Please enter a “Rejection Reason” indicating why this Lead status is “Lost”</errorMessage>
    </validationRules>
