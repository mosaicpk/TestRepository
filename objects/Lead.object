    <businessProcesses>
        <fullName>Lead Process</fullName>
        <description>Describes how Leads are created, nurtured, converted and handed over for the Opportunity management using Lead status field</description>
        <isActive>true</isActive>
        <values>
            <fullName>Converted</fullName>
            <default>false</default>
        </values>
        <values>
            <fullName>Lost %28Reject%29</fullName>
            <default>false</default>
        </values>
        <values>
            <fullName>MQL</fullName>
            <default>false</default>
        </values>
        <values>
            <fullName>New %28Suspect%29</fullName>
            <default>true</default>
        </values>
        <values>
            <fullName>Recycle</fullName>
            <default>false</default>
        </values>
        <values>
            <fullName>SAL</fullName>
            <default>false</default>
        </values>
        <values>
            <fullName>Sales Contacted</fullName>
            <default>false</default>
        </values>
        <values>
            <fullName>Sales Qualified</fullName>
            <default>false</default>
        </values>
    </businessProcesses>
