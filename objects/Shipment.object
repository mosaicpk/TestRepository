        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_TruckNumber__c</fullName>
        <description>This field captures the Truck Number.</description>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>Truck Number</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_UoMUnitofMeasure__c</fullName>
        <description>This field captures the uom of Measure.</description>
        <inlineHelpText>Specify the unit in which the value of this field will be measured</inlineHelpText>
        <label>UoM Unit of Measure</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>PMC_SS_UnitOfMeasure</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMC_CPQ_VehicleID__c</fullName>
        <description>This field captures the vehicle Vehicle ID.</description>
