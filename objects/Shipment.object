        <externalId>false</externalId>
        <label>Vehicle ID</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_VesselID__c</fullName>
        <description>This field captures the vessel Vessel ID.</description>
