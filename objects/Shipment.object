        <externalId>false</externalId>
        <label>Vessel ID</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_CPQ_Weight__c</fullName>
        <description>The total weight of the shipment.</description>
        <externalId>false</externalId>
        <label>Weight</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_DH_SAPDeliveryCreatedDate__c</fullName>
