    <validationRules>
        <fullName>Restrict_Quantity_Edit</fullName>
        <active>true</active>
        <description>Restriction to edit the shipment quantity after &apos;Completely shipped&apos;</description>
        <errorConditionFormula>AND(
ISPICKVAL(PMC_CPQ_DeliveryStatus__c, &quot;Completely Shipped&quot;),
ISCHANGED(PMC_CPQ_DeliveryQuantity__c)
)</errorConditionFormula>
        <errorMessage>Restriction to edit the shipment quantity after &apos;Completely shipped&apos;</errorMessage>
    </validationRules>
</CustomObject>
