        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PMC_SS_OrderStatusCode__c</fullName>
        <description>status category of order</description>
        <externalId>false</externalId>
        <formula>TEXT( PMC_CPQ_Order__r.StatusCode )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Order Status Code</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
