    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>false</enableFeeds>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>ProductId</fullName>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ProgramRebateTypeId</fullName>
        <trackHistory>false</trackHistory>
        <type>MasterDetail</type>
    </fields>
    <listViews>
        <fullName>All_ProgramRebateTypeProducts</fullName>
        <columns>Name</columns>
        <columns>Product</columns>
        <columns>ProgramRebateType</columns>
        <filterScope>Everything</filterScope>
        <label>All Program Rebate Type Products</label>
    </listViews>
    <listViews>
        <fullName>My_ProgramRebateTypeProducts</fullName>
        <filterScope>Mine</filterScope>
        <label>MyProgramRebateTypeProducts</label>
    </listViews>
    <searchLayouts>
        <customTabListAdditionalFields>Product</customTabListAdditionalFields>
        <customTabListAdditionalFields>ProgramRebateType</customTabListAdditionalFields>
        <searchResultsAdditionalFields>Product</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ProgramRebateType</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>PMC_SS_RestrictRebateTypeProductEdit</fullName>
        <active>true</active>
        <description>This validation rule is used to restrict the user from editing or creating Rebate Type Product for Under Revision or Approved Sales Agreement.</description>
        <errorConditionFormula>AND( 
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c ) ,

OR(
OR( 
ISPICKVAL(  ProgramRebateType.RebateProgram.PMC_SS_SalesAgreement__r.PMC_SS_ApprovalStatus__c  , &apos;Approved&apos;), 
ISPICKVAL( ProgramRebateType.RebateProgram.PMC_SS_SalesAgreement__r.PMC_SS_ApprovalStatus__c , &apos;Under Revision&apos;)
),
ISPICKVAL(  ProgramRebateType.RebateProgram.Status  , &apos;Inactive&apos;)
)
)</errorConditionFormula>
        <errorMessage>Rebate Type Product can’t be created/edited at this stage. Please Amend the Sales Agreement to make revisions to Rebate Type Product.</errorMessage>
    </validationRules>
</CustomObject>
