    <compactLayoutAssignment>PMC_SS_Knowledge_Compact_Layout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>PMC_SS_Knowledge_Compact_Layout</fullName>
        <fields>Title</fields>
        <fields>RecordTypeId</fields>
        <fields>ArticleNumber</fields>
        <fields>VersionNumber</fields>
        <fields>PublishStatus</fields>
        <fields>ValidationStatus</fields>
        <fields>Language</fields>
