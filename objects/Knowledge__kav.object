    </searchLayouts>
    <validationRules>
        <fullName>PMC_SS_ValidateEndDateForBulletinNotice</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
	NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),NOT(CONTAINS( $Profile.Name , &apos;Digital Hub&apos; )),
	 RecordType.DeveloperName = $Label.PMC_SS_KnowledgeArticle_BulletinRecordType ,ISNULL( PMC_SS_NumberOfDisplayDays__c ) 
	
)</errorConditionFormula>
        <errorMessage>Please provide number of days bulletin needs to be displayed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PMC_SS_ValidateNegativeNoOfDisplayDays</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT( $Setup.PMC_ProcessSwitches__c.PMC_BypassValidationRule__c),NOT(CONTAINS( $Profile.Name , &apos;Digital Hub&apos; )),
RecordType.DeveloperName =$Label.PMC_SS_KnowledgeArticle_BulletinRecordType,NOT(ISNULL( PMC_SS_NumberOfDisplayDays__c )),PMC_SS_NumberOfDisplayDays__c&lt;0

)</errorConditionFormula>
        <errorMessage>Please input positive value for &apos;Number Of Display Days&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PublishValidationRule</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISCHANGED( PublishStatus ) ,OR(ISPICKVAL(PublishStatus, &quot;Published&quot;),ISPICKVAL(PublishStatus, &quot;Online&quot;)))</errorConditionFormula>
        <errorMessage>Empty summary</errorMessage>
    </validationRules>
</CustomObject>
