    <searchLayouts>
        <excludedStandardButtons>OpenListInQuip</excludedStandardButtons>
        <excludedStandardButtons>NewFromDocument</excludedStandardButtons>
        <excludedStandardButtons>MassPublishKnowledgeArticleVersion</excludedStandardButtons>
        <excludedStandardButtons>MassAssignKnowledgeArticleVersion</excludedStandardButtons>
        <excludedStandardButtons>MassArchiveKnowledgeArticleVersion</excludedStandardButtons>
        <excludedStandardButtons>MassDeleteArchiveKnowledgeArticleVersion</excludedStandardButtons>
        <excludedStandardButtons>MassDeleteDraftKnowledgeArticleVersion</excludedStandardButtons>
        <excludedStandardButtons>MassRestoreKnowledgeArticleVersion</excludedStandardButtons>
