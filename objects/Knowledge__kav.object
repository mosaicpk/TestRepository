    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <fields>
        <fullName>Answer__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <inlineHelpText>Use this field to document the answer to the question discussed in the Knowledge Article.</inlineHelpText>
        <label>Answer</label>
        <length>32768</length>
        <type>Html</type>
        <visibleLines>25</visibleLines>
    </fields>
    <fields>
        <fullName>PMC_SS_EndDateNoUse__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <label>End Date No Use</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PMC_SS_EndDate__c</fullName>
        <formula>IF( ISPICKVAL( PublishStatus , &apos;Online&apos;) , LastPublishedDate +  PMC_SS_NumberOfDisplayDays__c
, null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>End Date</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PMC_SS_NumberOfDisplayDays__c</fullName>
        <externalId>false</externalId>
        <label>Number Of Display Days</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PMC_SS_Region__c</fullName>
        <label>Region</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Brazil</fullName>
                    <default>false</default>
                    <label>Brazil</label>
                </value>
                <value>
                    <fullName>North America</fullName>
                    <default>false</default>
                    <label>North America</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMC_SS_ReviewDate__c</fullName>
        <formula>IF( ISPICKVAL(PublishStatus, &apos;Online&apos;) , IF((MONTH( DATEVALUE(LastPublishedDate) )==2 &amp;&amp; DAY( DATEVALUE(LastPublishedDate) ) == 29),DATE(YEAR( DATEVALUE(LastPublishedDate) )+1,MONTH( DATEVALUE(LastPublishedDate) ),28),DATE(YEAR( DATEVALUE(LastPublishedDate) )+1,MONTH( DATEVALUE(LastPublishedDate) ),DAY( DATEVALUE(LastPublishedDate) ))) , null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Review Date</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Procedure_Audience__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <inlineHelpText>Use this field to identify who should follow or execute this procedure.  If you have a set list of people or groups, you could convert it to a pre-defined picklist.</inlineHelpText>
        <label>Audience</label>
        <length>32768</length>
        <type>Html</type>
        <visibleLines>25</visibleLines>
    </fields>
    <fields>
        <fullName>Procedure_Purpose__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <inlineHelpText>Use this field to describe the purpose of this procedure.</inlineHelpText>
        <label>Purpose</label>
        <length>32768</length>
        <type>Html</type>
        <visibleLines>25</visibleLines>
    </fields>
    <fields>
        <fullName>Procedure_Steps__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <inlineHelpText>Use this field to track the ordered procedure steps.</inlineHelpText>
        <label>Steps</label>
        <length>32768</length>
        <type>Html</type>
        <visibleLines>25</visibleLines>
    </fields>
    <fields>
        <fullName>Procedure_Warnings__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <inlineHelpText>Use this field to capture warnings and caveats that a user should know before following this procedure.  For example, you may want to include potential impacts or preparation needed before following this procedure.</inlineHelpText>
        <label>Warnings</label>
        <length>32768</length>
        <type>Html</type>
        <visibleLines>25</visibleLines>
    </fields>
    <fields>
        <fullName>Question__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <inlineHelpText>Use this field to document the question being answered by this article.  Include important keywords to help users find this article.</inlineHelpText>
        <label>Question</label>
        <length>32768</length>
        <type>Html</type>
        <visibleLines>25</visibleLines>
    </fields>
    <fields>
        <fullName>test_date__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <label>test date</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>test_review_date__c</fullName>
        <formula>IF((MONTH( test_date__c )==2 &amp;&amp; DAY( test_date__c ) == 29),DATE(YEAR( test_date__c )+1,MONTH( test_date__c ),28),DATE(YEAR( test_date__c )+1,MONTH( test_date__c ),DAY( test_date__c )))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>test review date</label>
        <required>false</required>
        <type>Date</type>
    </fields>
    <label>Knowledge</label>
