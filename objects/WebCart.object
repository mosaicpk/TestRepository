    <fields>
        <fullName>PMC_DH_GetPriceCallComplete__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Created as part of GDASF-6229. The field is to identify the Get Price callout is completed on the cloned quote and to remove the banner message asking AM / CSR to make the Get Price callout.</description>
        <label>Get Price Call Complete</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PMC_DH_IntegrationMessage__c</fullName>
        <description>Created as part of GDASF-6862. This field will capture the integration response message</description>
        <encryptionScheme>None</encryptionScheme>
        <inlineHelpText>receives the Integration response message</inlineHelpText>
        <label>Integration Message</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>PMC_DH_IntegrationStatus__c</fullName>
        <description>Created as part of GDASF-6862. This field will capture the overall integration status.</description>
        <inlineHelpText>Indicates the over all integration status</inlineHelpText>
        <label>Integration Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Success</fullName>
                    <default>false</default>
                    <label>Success</label>
                </value>
                <value>
                    <fullName>Error</fullName>
                    <default>false</default>
                    <label>Error</label>
                </value>
                <value>
                    <fullName>Warning</fullName>
                    <default>false</default>
                    <label>Warning</label>
                </value>
                <value>
                    <fullName>Ready</fullName>
                    <default>false</default>
                    <label>Ready</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
