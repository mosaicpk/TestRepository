        <externalId>false</externalId>
        <formula>IF(AND(!ISNULL(TEXT((PMC_DH_Account__r.Owner.PMC_CPQ_PrimaryBusinessType__c))),! ISBLANK(TEXT( PMC_DH_Account__r.Owner.PMC_CPQ_PrimaryBusinessType__c))),TEXT(PMC_DH_Account__r.Owner.PMC_CPQ_PrimaryBusinessType__c),NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
