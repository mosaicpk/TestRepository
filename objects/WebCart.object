        <fullName>PMC_DH_SalesAgreementStartDate__c</fullName>
        <formula>IF(PMC_DH_SalesAgreement__c!=NULL, PMC_DH_SalesAgreement__r.StartDate,  DATEVALUE( CreatedDate ) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Sales Agreement Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Date</type>
    </fields>
