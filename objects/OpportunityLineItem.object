    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>false</enableFeeds>
    <fieldSets>
        <fullName>sbaa__DealDesk</fullName>
        <description>Fields displayed on Deal Desk page.</description>
        <displayedFields>
            <field>ProductCode</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <displayedFields>
            <field>Product2Id</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <displayedFields>
            <field>Quantity</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <displayedFields>
            <field>ListPrice</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <displayedFields>
            <field>UnitPrice</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <label>Deal Desk</label>
    </fieldSets>
    <fields>
        <fullName>Description</fullName>
        <description>Text description of the opportunity line item.</description>
    </fields>
    <fields>
        <fullName>Discount</fullName>
        <description>Discount for the product as a percentage.</description>
    </fields>
    <fields>
        <fullName>ListPrice</fullName>
        <description>Corresponds to the UnitPrice on the PricebookEntry that is associated with this line item, which can be in the standard price book or a custom price book.</description>
    </fields>
    <fields>
        <fullName>Name</fullName>
        <description>The opportunity line item name</description>
    </fields>
    <fields>
        <fullName>OpportunityId</fullName>
        <description>ID of the associated Opportunity.</description>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PMC_CPQ_ModeofTransportation__c</fullName>
        <label>Mode of Transportation</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Barge</fullName>
                    <default>false</default>
                    <label>Barge</label>
                </value>
                <value>
                    <fullName>Container</fullName>
                    <default>false</default>
                    <label>Container</label>
                </value>
                <value>
                    <fullName>Purchase in Place</fullName>
                    <default>false</default>
                    <label>Purchase in Place</label>
                </value>
                <value>
                    <fullName>Rail</fullName>
                    <default>false</default>
                    <label>Rail</label>
                </value>
                <value>
                    <fullName>Truck</fullName>
                    <default>false</default>
                    <label>Truck</label>
                </value>
                <value>
                    <fullName>Vessel</fullName>
                    <default>false</default>
                    <label>Vessel</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>PMC_CPQ_OpportunityLineItemId__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>Opportunity Line Item Id</label>
        <length>20</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Product2Id</fullName>
        <description>The ID of the related Product2 record. </description>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ProductCode</fullName>
        <description>It references the value in the ProductCode field of the related Product2 record.</description>
    </fields>
    <fields>
        <fullName>Quantity</fullName>
        <description>Read-only if this record has a quantity schedule, a revenue schedule, or both a quantity and a revenue schedule.</description>
    </fields>
    <fields>
        <fullName>SBQQ__ParentID__c</fullName>
        <deprecated>false</deprecated>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <inlineHelpText>ID of the opportunity product that came from this product&apos;s bundle.</inlineHelpText>
        <label>Parent ID</label>
        <length>18</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SBQQ__QuoteLine__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>Quote line that generated this Opportunity Product.</description>
        <label>Quote Line</label>
        <referenceTo>SBQQ__QuoteLine__c</referenceTo>
        <relationshipLabel>Opportunity Product</relationshipLabel>
        <relationshipName>OpportunityProducts</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>SBQQ__SubscriptionType__c</fullName>
        <deprecated>false</deprecated>
        <description>Indicates the subscription type to determine contract&apos;s pricing.</description>
        <inlineHelpText>Indicates the subscription type to determine contract&apos;s pricing.</inlineHelpText>
        <label>Subscription Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>SBQQ__SubscriptionType</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>ServiceDate</fullName>
    </fields>
    <fields>
        <fullName>Subtotal</fullName>
        <description>Difference between standard and discounted pricing. </description>
    </fields>
    <fields>
        <fullName>TotalPrice</fullName>
        <description>It represents the total price of the OpportunityLineItem.</description>
    </fields>
    <fields>
        <fullName>UnitPrice</fullName>
        <description>The unit price for the opportunity line item.</description>
    </fields>
    <fields>
        <fullName>sbaa__ApprovalStatus__c</fullName>
        <deprecated>false</deprecated>
        <label>Approval Status</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Rejected</label>
                </value>
                <value>
                    <fullName>Recalled</fullName>
                    <default>false</default>
                    <label>Recalled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
</CustomObject>
