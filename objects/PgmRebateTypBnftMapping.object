        <trackHistory>false</trackHistory>
        <type>MasterDetail</type>
    </fields>
    <fields>
        <fullName>RebateTypeBenefitField</fullName>
        <description>Used to describe the join conditions between the aggregate object and the Program Rebate Type Benefit entity.</description>
